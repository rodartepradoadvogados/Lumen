# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# sqlite (legacy local dev db)
*.db
*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# venv da auditoria de segurança (docs/security-audit/gerar_relatorio*.py) — reinstala com
# `python3 -m venv docs/security-audit/.venv && docs/security-audit/.venv/bin/pip install reportlab matplotlib`
docs/security-audit/.venv/
docs/security-audit/__pycache__/

# bytecode do Python — a ponte do Hermes (servidor-hermes/) e o harness que a sobe nos testes
# (lib/testes/ponteHermes.harness.py) geram isto na máquina de quem roda, e ele muda a cada
# versão do interpretador. Nunca entra no repositório.
servidor-hermes/__pycache__/
lib/testes/__pycache__/

# claude code — preferências/hooks locais de cada máquina, não do time
.claude/settings.local.json

# claude code — cópias isoladas de trabalho de agente. O resto de .claude/ é RASTREADO de
# propósito (agentes e skills são do time); esta pasta é a exceção, e por um motivo concreto: cada
# subpasta aqui é um clone inteiro deste repositório, criado pela ferramenta para um agente
# trabalhar sem colidir com outro. Sem esta linha ela aparece como não rastreada, e um `git add -A`
# distraído commitaria centenas de megabytes de cópias do próprio projeto dentro dele. Já houve,
# nesta casa, duas varreduras de `add` levando arquivo para o commit errado — esta é a mesma
# família de acidente, só maior.
.claude/worktrees/
