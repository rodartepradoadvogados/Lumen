// Lúmen - Sistema de gestão jurídica multi-tenant
// Fork de rp-financeiro (sistema mono-tenant do Rodarte Prado Advogados).
// Schema completo: casos/atendimentos, agenda/kanban integrados, financeiro, contatos, publicações
// — agora com isolamento por Office (escritório/tenant) em toda entidade de negócio.

generator client {
  provider        = "prisma-client-js"
  // `driverAdapters` existe SÓ para o ambiente do agente, e não muda nada na Vercel — ver a nota
  // longa em lib/prisma.ts (adaptadorNeon). Em produção o Prisma continua abrindo TCP direto,
  // como sempre; o adaptador só entra quando LUMEN_DB_ADAPTADOR=neon está no ambiente, e essa
  // variável não existe na Vercel.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ MULTI-TENANCY (Fase 1) ============
//
// Toda entidade de negócio abaixo carrega um officeId obrigatório — o requisito não-negociável
// do projeto é nunca misturar dado de um escritório com outro. officeId é denormalizado em toda
// tabela (mesmo em filhas de outra entidade já escopada) de propósito: elimina a necessidade de
// caminhar a cadeia de relações pra montar um filtro seguro, e torna "toda query direta filtra
// por officeId" uma regra mecânica e fácil de auditar/checar em code review.
//
// Ficam de fora, por enquanto: as 4 tabelas do robô Python (RoboPublicacao/RoboAndamento/
// RoboProcessoMonitorado/RoboExecucaoLog) continuam compartilhadas e keyadas por número de
// processo/OAB, não por officeId — a atribuição a cada escritório acontece depois, na ponte
// (lib/roboBridge.ts), casando por número de processo dentro de cada Office. O robô já
// descobre sozinho as OABs de TODOS os escritórios ativos (robo-publicacoes/src/config.py:
// carregar_oabs_do_banco), então a captura em si já é multi-tenant; o que falta é só o robô
// também aprender a marcar officeId nas próprias tabelas, caso um dia isso vire necessário
// (hoje a ponte já resolve sem precisar disso).
//
// Decisões de unicidade global x por escritório:
// - User.email: continua único GLOBALMENTE — é a chave de login/redefinição de senha em toda
//   a plataforma, um e-mail = uma conta = um escritório.
// - User.username: passa a ser único POR escritório (@@unique([officeId, username])) — é só um
//   apelido informal (usado em @menção), plausível de colidir entre escritórios diferentes.
// - GoogleCredential.accountEmail: continua único GLOBALMENTE — a mesma conta Google não pode
//   estar conectada como Drive principal de dois escritórios ao mesmo tempo.
// - TaskTypePoints.type e BlogPost.slug: passam a ser únicos POR escritório.
model Office {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // identificador amigável, usado em URL/subdomínio
  // ATIVA | SUSPENSA | CANCELADA — enforçado em lib/currentUser.ts: usuário comum de um
  // escritório não-ATIVA não consegue usar o sistema (tela de aviso), exceto platform owners
  // (ver User.isPlatformOwner), que sempre passam — precisam poder entrar pra resolver o
  // motivo do bloqueio junto com o dono do escritório bloqueado.
  status    String   @default("ATIVA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Escritório dono da plataforma (Rodarte Prado) — não aparece no Painel Mestre como cliente
  // de cobrança, não tem fatura gerada, nunca é bloqueado por inadimplência.
  isInternal Boolean @default(false)

  // Preenchido ao final de um syncOfficeDrive bem-sucedido (lib/driveSync.ts) — nunca em caso de
  // falha nem para escritório sem Drive conectado. syncAllOfficesDrive ordena os escritórios por
  // este campo (nulls primeiro, depois mais antigo primeiro), formando um round-robin: se o cron
  // estourar o teto de 300s antes de terminar todos, a próxima execução não recomeça sempre pelos
  // mesmos escritórios do início da lista — continua de onde a rodada truncada parou (achado A69
  // da revisão gauntlet).
  lastDriveSyncAt DateTime?

  // Cobrança — preenchidos ao cadastrar o escritório no Painel Mestre (isPlatformOwner only).
  billingEmail  String? // recebe o boleto de cada fatura gerada
  monthlyFee    Float? // mensalidade combinada em contrato
  billingDueDay Int? // dia do mês de vencimento (1-28, pra não cair em mês sem o dia)
  // CPF ou CNPJ do escritório-cliente — a Asaas exige esse dado no cliente pra emitir boleto ou
  // Pix QR Code de verdade (rejeita a cobrança sem isso, mesmo com o "customer" já criado).
  cnpj          String?

  // Papel timbrado DESTE escritório para os relatórios (multi-tenant: cada escritório emite no
  // PRÓPRIO timbrado, nunca no do Rodarte Prado). É o arquivo do papel timbrado em si, enviado em
  // Configurações → Geral (Vercel Blob, mesma infra dos anexos) — não um logotipo solto.
  //
  // Quando o formato é DOCX, o relatório em Word é gerado DENTRO deste arquivo: o conteúdo é
  // acrescentado ao corpo e todo o resto do pacote (cabeçalho, rodapé, margens, fontes) é
  // preservado intacto — ver lib/relatorioDocx.ts. PDF é aceito e guardado, mas não serve de
  // recipiente para um .docx; nesse caso o Word sai com cabeçalho textual (nome + CNPJ).
  //
  // Não confundir com o timbrado do "Peticionar", que é um Google Doc (DocumentTemplate,
  // categoria TIMBRADO) — aquele é folha de petição, este é papel timbrado de relatório.
  timbradoUrl         String?
  timbradoNomeArquivo String?
  timbradoFormato     String? // DOCX | PDF

  // Dias corridos de tolerância após o vencimento antes do bloqueio automático (usado pelo
  // cron de cobrança, lib/actions/billing.ts:runBillingCycle) — por escritório, pra dar
  // flexibilidade caso algum cliente específico precise de mais ou menos prazo.
  paymentGraceDays Int @default(30)

  // Módulos habilitados por contrato — controla o que aparece na navegação e o que os Server
  // Actions de cada módulo aceitam fazer (checado nos dois lugares, não só escondido na tela).
  // Desligar um módulo NUNCA apaga dados já existentes, só impede a criação de dados novos e
  // esconde a navegação — permite religar sem perda caso o contrato mude depois. SEM
  // autosserviço: só o Painel Mestre grava aqui (lib/actions/painelMestre.ts) — ver
  // Plan/ModulePrice abaixo para o preço e o catálogo de planos que dirigem estes 4 campos.
  moduloFinanceiro  Boolean @default(true)
  moduloWhatsapp    Boolean @default(true)
  moduloAtendimento Boolean @default(true)
  moduloAssessoria  Boolean @default(true)

  // Plano/preço por módulo (Painel Mestre → Cobrança e acesso). planId aponta pro catálogo
  // (Plan, mais abaixo) — nulo em todo escritório pré-existente até o operador migrar. Os 4
  // preços são POR ESCRITÓRIO (cópia do catálogo global ModulePrice no momento em que o módulo é
  // ligado, editável depois — permite desconto negociado sem sair do plano fixo), nunca um valor
  // global aplicado direto: só entram na mensalidade o módulo cujo booleano acima está ligado E
  // cujo preço aqui não é nulo (ver lib/officePricing.ts:calcularMensalidadeModular). oabLimit/
  // caseLimit só valem de verdade no plano Sob Medida (Plan.isCustom) — em plano fixo a UI usa o
  // limite do próprio Plan, estes dois ficam como override raro (ex.: ampliar cota de um cliente
  // específico sem tirar do plano).
  //
  // pricingMode decide se Office.monthlyFee é digitado (MANUAL, default — comportamento de
  // sempre, nenhum escritório existente muda de valor na migração deste recurso) ou calculado a
  // partir dos 4 preços acima toda vez que o operador salva módulos (MODULAR) — a troca é uma
  // ação humana e deliberada por escritório (ver updateOfficePlanModules), nunca automática.
  planId           String?
  plan             Plan?   @relation(fields: [planId], references: [id])
  precoFinanceiro  Float?
  precoWhatsapp    Float?
  precoAtendimento Float?
  precoAssessoria  Float?
  oabLimit         Int?
  caseLimit        Int?
  pricingMode      String  @default("MANUAL") // MANUAL | MODULAR

  // Provedor de armazenamento de anexos (Processos/Atendimentos/Assessoria) escolhido por este
  // escritório — "GOOGLE_DRIVE" | "ONEDRIVE" | "DROPBOX" (texto livre, mesmo padrão do resto do
  // schema, sem enum do Prisma). Default GOOGLE_DRIVE preserva o comportamento de todo
  // escritório já existente sem nenhuma ação da parte deles — só passa a valer ONEDRIVE/DROPBOX
  // se o escritório escolher isso explicitamente em Configurações (ver
  // lib/actions/settings.ts:setStorageProvider) e conectar a conta correspondente como
  // armazenamento (ver lib/oneDriveStorage.ts / lib/dropboxStorage.ts).
  storageProvider String @default("GOOGLE_DRIVE")

  // Como as pastas deste escritório se chamam no armazenamento (ver lib/driveNaming.ts). Nulos =
  // padrão do produto ("Lúmen" / "Lúmen - "), que reproduz exatamente a nomenclatura anterior a
  // esta configuração existir — nenhum escritório já criado muda de estrutura sem pedir.
  // Existem para o escritório-cliente não ficar com a marca da Lúmen carimbada dentro do próprio
  // Drive. `drivePrefixo` vazio (string "") é uma escolha válida e diferente de nulo: significa
  // pastas sem prefixo nenhum ("Processos", "Casos"…).
  drivePastaMae String?
  drivePrefixo  String?

  // Diferente dos módulos acima (contratáveis, só o Painel Mestre altera — sem autosserviço), o
  // Blog Jurídico público é um recurso da PLATAFORMA: só o escritório dono
  // (Rodarte Prado) produz/edita/aprova matérias, ou quem ele conceder acesso no futuro — não
  // tem toggle de autosserviço. Default true só beneficia o escritório pré-existente no banco
  // (Rodarte Prado); todo Office novo criado via /cadastro recebe false explicitamente (ver
  // lib/actions/signup.ts).
  blogAccess Boolean @default(true)

  // Como o escritório quer que funcione o acesso do suporte da Lúmen. AUTO = liberado na hora,
  // mas sempre com registro, prazo e faixa visível. APROVACAO = exige que um sócio do
  // escritório libere antes (tela do lado do cliente entra no Passo 3). Nasce AUTO para não
  // travar o suporte antes de existir onde aprovar.
  supportAccessPolicy String @default("AUTO") // AUTO | APROVACAO

  // COMO ESTE ESCRITÓRIO ATUA, escrito pelo próprio escritório em Configurações → Geral, para o
  // AGENTE DE IA consultar (ferramenta `consultar_perfil_do_escritorio`, lib/assistantTools.ts).
  //
  // O QUE É: texto corrido, em português, sobre áreas de atuação, perfil de cliente, tipo de
  // trabalho que o escritório faz e o que ele deliberadamente NÃO faz — o que um advogado recém-
  // chegado precisaria ouvir na primeira semana. Serve ao agente para orientar vocabulário, foco
  // e encaminhamento quando ele redige ou responde.
  //
  // O QUE NÃO É: (1) não é instrução ao agente — o texto é DADO, chega ao modelo neutralizado e
  // cercado (ver lib/atuacaoDoEscritorio.ts), e uma ordem escrita aqui dentro é para ser relatada,
  // nunca obedecida; (2) não é configuração de comportamento da atendente do WhatsApp, que tem
  // campo próprio (WhatsappConfig.agenteInstrucoes) e É lida como instrução de verdade — não
  // confundir os dois; (3) não é texto de peça, marketing ou timbrado: nada daqui é copiado para
  // dentro de um documento gerado; (4) não é lugar de dado de cliente, número de processo ou
  // segredo — é lido por qualquer pergunta feita ao agente, por qualquer pessoa do escritório.
  //
  // TETO: LIMITE_DA_ATUACAO (lib/atuacaoDoEscritorio.ts), dito na tela e RECUSADO na gravação —
  // nunca truncado em silêncio. Nulo = escritório que ainda não escreveu, estado normal: a
  // ferramenta responde isso com todas as letras, em vez de deixar o agente supor a atuação.
  descricaoAtuacao String?

  users                   User[]
  notices                 Notice[]
  loginSessions           LoginSession[]
  clients                 Client[]
  lawyers                 Lawyer[]
  suppliers               Supplier[]
  cases                   Case[]
  kanbanColumns           KanbanColumn[]
  tasks                   Task[]
  taskTypePoints          TaskTypePoints[]
  workflowTemplates       WorkflowTemplate[]
  workflowSteps           WorkflowStep[]
  comments                Comment[]
  anotacoes               Anotacao[]
  mentions                Mention[]
  attendances             Attendance[]
  whatsappMessages        WhatsappMessage[]
  transcricoesDeAudio     TranscricaoDeAudio[]
  emailMessages           EmailMessage[]
  attachments             Attachment[]
  documentTemplates       DocumentTemplate[]
  deletionRequests        DeletionRequest[]
  googleCredentials       GoogleCredential[]
  microsoftCredentials    MicrosoftCredential[]
  financialCategories     FinancialCategory[]
  costCenters             CostCenter[]
  payables                Payable[]
  receivables             Receivable[]
  recurringFees           RecurringFee[]
  recurringExpenses       RecurringExpense[]
  caseLinks               CaseLink[]
  caseInstanceEscalations CaseInstanceEscalation[]
  assessorias             Assessoria[]
  assessoriaDocumentos    AssessoriaDocumento[]
  pareceres               Parecer[]
  honorarios              Honorario[]
  licitacoes              Licitacao[]
  publications            Publication[]
  blogPosts               BlogPost[]
  photos                  Photo[]
  whatsappConfig          WhatsappConfig?
  dropboxCredential       DropboxCredential?
  invoices                TenantInvoice[]

  // ---- Lúmen (Passo 1 — fundação de dados, ainda não lida por nenhuma tela) ----
  subscription   Subscription?
  usage          TenantUsage[]
  supportTickets SupportTicket[]
  accessRequests AccessRequest[]
  accessAudit    AccessAuditLog[]

  driveSyncIssues         DriveSyncIssue[]
  blockedProcessNumbers   BlockedProcessNumber[]
  alertDismissals         AlertDismissal[]
  assistantSessions       AssistantSession[]
  assistantAuditLogs      AssistantAuditLog[]
  integrationRuns         IntegrationRun[]
  apiKeys                 ApiKey[]
  auditEvents             AuditEvent[]
  dataSubjectRequests     DataSubjectRequest[]
  notificationPreferences NotificationPreference[]
  notificationOutbox      NotificationOutbox[]
  emailTemplates          EmailTemplate[]

  // Setor de Processos Administrativos (fundação) — ver models TermoVigilancia e
  // FonteAdministrativa mais abaixo.
  termosVigilancia      TermoVigilancia[]
  fontesAdministrativas FonteAdministrativa[]
  officeDocumentTypes   OfficeDocumentType[]

  // Fase 2 do Setor de Processos Administrativos — ver model RoboDouItem mais abaixo.
