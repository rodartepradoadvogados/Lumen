// ============ CASOS / CARDS ============

model Case {
  id            String  @id @default(cuid())
  title         String
  type          String  @default("JUDICIAL") // JUDICIAL | ADMINISTRATIVO | EXTRAJUDICIAL | ATENDIMENTO | CONSULTIVO
  area          String?
  secondaryArea String?
  status        String  @default("ATIVO") // ATIVO | SUSPENSO | ENCERRADO | ARQUIVADO
  folder        String?
  processNumber String?
  court         String?
  forum         String?
  tribunal      String? // Sigla do tribunal (ex: TJGO, TRF1, TST) — órfão, sem uso em nenhuma
  // tela (confirmado por grep); mantido como está, não usar nem remover.

  // Selecionados via lib/tribunaisCatalog.ts (components/TribunalPickerModal.tsx) no cadastro,
  // mas 100% independentes do catálogo depois disso — livremente editáveis no Processo, sem
  // nenhuma referência de volta a um Tribunal.id. É por isso que não há relation aqui: mudar o
  // catálogo no futuro nunca deve alterar um Processo já cadastrado.
  tribunalSigla   String?
  tribunalNome    String?
  tribunalSistema String?
  tribunalLink    String?

  caseValue             Float?
  convictionValue       Float?
  // "Proveito econômico" — base alternativa de cálculo de honorário percentual (ver
  // HonorarioLancamento.percentualBase), ao lado de caseValue (valor da causa) e
  // convictionValue (valor da condenação). Puramente informativo até que uma parcela
  // percentual referencie esta base no cálculo do valor estimado da parcela.
  economicBenefitValue  Float?
  // "Valor do acordo" — quarta base de cálculo de honorário percentual (ver
  // Receivable.percentualBase), ao lado de caseValue/economicBenefitValue/convictionValue acima.
  // Só costuma ser preenchido quando o processo termina em acordo homologado, em vez de sentença/
  // condenação — as demais bases continuam existindo em paralelo (um caso pode ter as quatro
  // preenchidas ao longo do tempo; qual delas vale para uma parcela específica é escolha de quem
  // lança o honorário, não automática).
  agreementValue        Float?
  // instance = "Instância Original": só passa a ser preenchido na PRIMEIRA vez que um recurso faz
  // o processo subir de instância (ver escalarTribunalSuperior, lib/actions/cases.ts) — antes
  // disso, um processo só tem "instância atual" (currentInstance), sem par origem/atual pra
  // mostrar. tribunalOrigem* abaixo é o par equivalente do lado do tribunal. Os dois SEMPRE
  // espelham o topo da pilha de CaseInstanceEscalation ainda não desfeita (a escalada que um
  // próximo "retorno dos autos" reverteria) — cada escalada empilha um novo registro em
  // CaseInstanceEscalation (histórico completo, com order/escalatedAt/returnedAt), e um retorno
  // desempilha só a mais recente ainda ativa, recalculando instance/tribunalOrigem* a partir do
  // que sobrou na pilha (ou zerando os dois se não sobrou nada). Múltiplas escaladas em sequência
  // (1º → 2º → STJ, por exemplo) preservam cada hop — não é mais um par único de mão única.
  instance              String? // Instância Original (espelha o topo da pilha de escaladas ainda ativas)
  currentInstance       String? // Instância Atual — valores: PRIMEIRO_GRAU | SEGUNDO_GRAU | TERCEIRO_GRAU (ver lib/caseInstance.ts)
  // Seção/Câmara/Turma do tribunal ATUAL (ex.: "3ª Câmara Cível do TJGO") — texto livre e
  // opcional, preenchido junto da escalada por recurso ou editável a qualquer momento; não tem
  // catálogo por trás (câmara/turma varia demais entre tribunais para valer a pena catalogar).
  currentInstanceDetail String?
  // Tribunal do topo da pilha de escaladas ainda ativas — ver comentário de `instance` acima
  // sobre o par origem/atual. tribunalSigla/Nome/Sistema/Link (abaixo) passam a representar o
  // tribunal ATUAL a partir do momento em que isto é preenchido.
  tribunalOrigemSigla   String?
  tribunalOrigemNome    String?
  tribunalOrigemSistema String?
  tribunalOrigemLink    String?
  distributedAt         DateTime?
  closedAt              DateTime?
  description           String?
  // Matérias do processo (multi-select, ex.: ["Cível", "Consumidor"]) — ver lib/caseMaterias.ts.
  // `area` (acima) continua sendo gravado também, sempre igual a materias[0] (ou null se vazio):
  // é o que todo filtro/relatório/busca existente já lê, e continuar escrevendo os dois evita ter
  // que migrar essas telas agora só para habilitar múltipla escolha no cadastro.
  materias              String[]  @default([])
  // Assuntos livres do processo (hoje 2 campos na tela, guardado como lista pra não precisar de
  // migração nova se um dia virar 3+) — ver lib/assuntosCatalog.ts para o pop-up de exemplos.
  assuntos              String[]  @default([])
  clientRole            String? // papel do NOSSO cliente: Autor, Réu, Interessado, Recorrente, Recorrido...
  actionType            String? // Ação (ex: Execução Fiscal)

  // Só preenchidos quando type = "ADMINISTRATIVO" — permitem filtrar a lista por esfera e
  // por matéria sem precisar olhar o órgão. Ficam nulos em processo judicial.
  adminEsfera  String? // FEDERAL | ESTADUAL | MUNICIPAL
  adminMateria String? // CONTAS | TRIBUTARIO | LICITACAO | DISCIPLINAR | REGULATORIO | AMBIENTAL | PREVIDENCIARIO | OUTRO

  decision        String?
  outcome         String?
  tags            String?
  sourceUrl       String?
  lastHistoryAt   DateTime?
  lastHistoryDesc String?

  opposingPartyName     String? // nome da parte adversa (cadastro simplificado, só texto)
  opposingPartyRole     String? // AUTOR | REU | OUTRO — polo da parte adversa
  opposingPartyDocument String? // CPF/CNPJ da parte adversa (opcional)
  opposingPartyAddress  String? // endereço da parte adversa (opcional)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  responsibleId String?
  responsible   User?   @relation("CaseResponsible", fields: [responsibleId], references: [id])

  // Vínculo explícito com uma Assessoria (opcional) — escolhido no cadastro do processo,
  // para importar este caso diretamente para dentro do acompanhamento daquela assessoria.
  // Independente do clientId: o mesmo cliente pode ter processos que não fazem parte do
  // contrato de assessoria continuada.
  assessoriaId String?
  assessoria   Assessoria? @relation(fields: [assessoriaId], references: [id])

  // Pasta própria deste processo no Drive (Processos/{title}), criada sob demanda no primeiro
  // anexo — ver lib/googleDrive.ts, getOrCreateCaseFolder. Ao converter um Atendimento neste
  // Case, herda a MESMA pasta do atendimento (só renomeada), não cria outra.
  driveFolderId String?

  // Marcado quando o usuário escolhe "descartar sugestões futuras" na janela de revisão da
  // padronização de título "Cliente x Parte Adversa" (RenameCasesToConventionButton) — o
  // processo passa a ser ignorado nas próximas conferências, mesmo que o título ainda não
  // siga o padrão (ex.: título alterado de propósito, com nome informal do adversário).
  namingConventionIgnored Boolean @default(false)

  tasks                    Task[]
  comments                 Comment[]
  receivables              Receivable[]
  recurringFees            RecurringFee[]
  payables                 Payable[]
  publications             Publication[]
  attachments              Attachment[]
  convertedFromAttendances Attendance[]          @relation("AttendanceConvertedCase")
  assessoriaDocumentos     AssessoriaDocumento[]
  driveSyncIssues          DriveSyncIssue[]

  // Litisconsórcio: clientId/opposingParty* acima seguem existindo e sempre espelham o primeiro
  // cliente/parte cadastrado (compat com título "Cliente x Parte Adversa", geração de documentos
  // e qualquer leitura antiga que não olhe para as duas listas abaixo). clients/parties é onde
  // vive o cadastro completo quando há mais de um autor/réu — um processo sem litisconsórcio tem
  // só uma linha em cada uma, espelhando os campos legados.
  clients CaseClient[]
  parties CaseParty[]

  // Termos de vigilância (Radar de Publicações Administrativas) ligados a este processo — ver
  // model TermoVigilancia mais abaixo.
  termosVigilancia TermoVigilancia[]

  // Protocolos deste processo (aba Protocolos) — ver model ProtocoloLote mais abaixo.
  protocoloLotes ProtocoloLote[]

  // Envios de documentos por E-mail/WhatsApp deste processo (mesma aba Protocolos) — ver model
  // DocumentoEnvio mais abaixo.
  documentoEnvios DocumentoEnvio[]

  // Lançamentos de honorários (aba Financeiro) — ver model HonorarioLancamento mais abaixo.
  honorarioLancamentos HonorarioLancamento[]

  // Anotações pessoais (painel global "Anotações", ver model Anotacao mais abaixo) vinculadas a
  // este Case — cobre os três chips Processo Judicial/Administrativo/Caso, diferenciados só por
  // Anotacao.linkType (não por uma FK própria, já que os três são o mesmo model Case).
  anotacoes Anotacao[]

  // Vínculos com outros processos, por qualquer motivo (não registrado, ver model CaseLink) —
  // um Case pode aparecer como caseA de um vínculo e caseB de outro, daí as duas relações.
  linksAsA CaseLink[] @relation("CaseLinkA")
  linksAsB CaseLink[] @relation("CaseLinkB")

  // Histórico completo de escaladas de instância (ver model CaseInstanceEscalation e comentário
  // de `instance` acima) — cada subida por recurso empilha um registro aqui.
  instanceEscalations CaseInstanceEscalation[]

  @@index([officeId])
  @@index([officeId, processNumber])
}

// Vínculo entre dois processos — por qualquer motivo (não perguntado nem guardado, ver proposta
// aprovada em 2026-08-07). Bidirecional: para listar os vínculos de um Case, buscar por caseAId
// OU caseBId (ver getCaseLinks, lib/actions/caseLinks.ts). principalCaseId aponta para caseAId,
// para caseBId, ou fica nulo (nenhum dos dois é principal) — é uma propriedade do VÍNCULO, não
// do processo: um processo pode ser principal num vínculo e não-principal em outro, se tiver
// mais de um.
model CaseLink {
  id              String   @id @default(cuid())
  caseAId         String
  caseA           Case     @relation("CaseLinkA", fields: [caseAId], references: [id])
  caseBId         String
  caseB           Case     @relation("CaseLinkB", fields: [caseBId], references: [id])
  principalCaseId String?
  createdAt       DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@unique([caseAId, caseBId])
  @@index([officeId])
}

// Histórico de escaladas de instância por recurso (ver escalarTribunalSuperior/
// retornarInstanciaAnterior, lib/actions/cases.ts) — cada vez que um processo sobe de instância,
// empilha um registro aqui com o estado ANTES (from*) e DEPOIS (to*) da escalada. "Retorno dos
// autos" desempilha só o registro mais recente ainda sem returnedAt (LIFO), restaura o Case pros
// valores from* daquele registro e marca returnedAt — se sobrar algum registro mais antigo sem
// returnedAt, ele passa a ser o novo topo (outro retorno o desfaria em seguida). `order` é só
// pra facilitar leitura em UI/debug (1ª, 2ª, 3ª escalada...); a ordem "de verdade" pra empilhar/
// desempilhar é sempre por escalatedAt (mais recente primeiro).
model CaseInstanceEscalation {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id])
  order  Int

  fromInstance        String?
  fromTribunalSigla   String?
  fromTribunalNome    String?
  fromTribunalSistema String?
  fromTribunalLink    String?
  fromInstanceDetail  String?

  toInstance        String
  toTribunalSigla   String
  toTribunalNome    String?
  toTribunalSistema String?
  toTribunalLink    String?
  toInstanceDetail  String?

  escalatedAt DateTime  @default(now())
  returnedAt  DateTime? // preenchido quando "retorno dos autos" desfaz esta escalada específica

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([caseId])
  @@index([officeId])
}

// Um dos nossos clientes vinculados a um processo — existe em paralelo a Case.clientId (que
// sempre aponta para o primeiro CaseClient criado) para não quebrar nada que ainda só leia o
// campo legado; a lista completa (litisconsórcio ativo) só está aqui.
model CaseClient {
  id        String   @id @default(cuid())
  role      String? // Autor | Réu | Terceiro Interessado | Recorrente | Recorrido | Outro
  createdAt DateTime @default(now())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  @@unique([caseId, clientId])
  @@index([caseId])
  @@index([clientId])
}

// Parte do lado de fora do escritório: parte adversa ou terceiro interessado. Substitui em
// paralelo os 4 campos opposingParty* de Case (mesma relação de compatibilidade do CaseClient
// acima) — não é um Client cadastrado, só um registro textual simples ligado ao processo.
model CaseParty {
  id        String   @id @default(cuid())
  name      String
  document  String?
  address   String?
  role      String   @default("OUTRO") // AUTOR | REU | TERCEIRO_INTERESSADO | OUTRO
  createdAt DateTime @default(now())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ============ CATÁLOGO DE TRIBUNAIS ============

// Catálogo de tribunais brasileiros — dado de referência global, compartilhado por todos os
// escritórios (não é multi-tenant: um TJGO é o mesmo TJGO para qualquer escritório). Populado
// uma vez pelo endpoint idempotente /api/admin/setup-tribunais, a partir de
// lib/tribunaisCatalog.ts. As telas nunca escrevem aqui — só leem para alimentar o seletor.
model Tribunal {
  id        String   @id @default(cuid())
  sigla     String   @unique
  nome      String
  categoria String // agrupamento de exibição no seletor — ver CATEGORIA_ORDER em lib/tribunaisCatalog.ts
  sistemas  String // texto descritivo do(s) sistema(s) processual(is)
  portalUrl String // link de acesso ao sistema (login/consulta de processos)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())

  natureza String @default("JUDICIAL") // JUDICIAL | ADMINISTRATIVO — o mesmo catálogo serve
  // aos dois seletores; o picker filtra por natureza.

  // Segmento (J) e código do tribunal/região (TR) do número CNJ (Resolução CNJ 65/2008),
  // usados por lib/cnjTribunal.ts para identificar o tribunal de um processo a partir do
  // número, mesmo sem o processo estar cadastrado. Nulo para órgãos sem numeração própria
  // (ex.: CNMP, DJEN) — ver comentário de origem em lib/tribunaisCatalog.ts.
  codigoJ  Int?
  codigoTr Int?
}

// ============ AGENDA + KANBAN (fonte única: Task) ============

model KanbanColumn {
  id        String  @id @default(cuid())
  name      String
  order     Int     @default(0)
  color     String  @default("#94a3b8")
  isDoneCol Boolean @default(false)

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  tasks Task[]

  @@index([officeId])
}

model Task {
  id            String    @id @default(cuid())
  title         String
  type          String    @default("TAREFA") // TAREFA | EVENTO | AUDIENCIA | PERICIA | PRAZO
  description   String?
  dueDate       DateTime
  dueTime       String?
  // Prazo de segurança: calculado automaticamente como 24h antes do dueDate ("prazo fatal") —
  // hoje só preenchido por delegateTask (lib/actions/tasks.ts). Aparece na Agenda como um
  // segundo evento, em cor distinta, no dia anterior ao prazo fatal.
  safetyDueDate DateTime?
  priority      String    @default("MEDIA") // BAIXA | MEDIA | ALTA | URGENTE
  status        String    @default("PENDENTE") // PENDENTE | EM_ANDAMENTO | CONCLUIDO | CANCELADO
  completedAt   DateTime?
  // Auditoria de conclusão: quem marcou o compromisso como CONCLUIDO. Limpo (volta a null)
  // se o status for revertido/reaberto, junto com completedAt.
  completedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Reunião (quando type = EVENTO ou AUDIENCIA)
  meetingType String? // PRESENCIAL | ONLINE
  location    String?
  meetingUrl  String?
  // Estratégia da audiência (quando type = AUDIENCIA): anotações de preparo, teses e pontos de
  // atenção — só faz sentido nesse tipo, mas fica solto como os demais campos situacionais acima.
  strategy    String?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])

  publicationId String?
  publication   Publication? @relation(fields: [publicationId], references: [id])

  licitacaoId String?
  licitacao   Licitacao? @relation(fields: [licitacaoId], references: [id])

  // Pasta própria desta demanda/tarefa DENTRO de uma Licitação —
  // "Assessoria/{empresa}/Licitações/{nome da licitação}/{título da tarefa}", criada sob demanda
  // no primeiro anexo (getOrCreateLicitacaoDemandaFolder). Só usado quando licitacaoId também
  // está preenchido; Task de qualquer outra natureza (Processo, Atendimento, avulsa) nunca ganha
  // pasta própria — o anexo dela, se algum dia existir, viveria na pasta do Case/Attendance.
  driveFolderId String?

  // Anexos desta tarefa específica — hoje só populado quando ela é uma demanda de Licitação (ver
  // licitacaoId acima e Attachment.taskId). Nenhuma outra tela do produto tem upload no nível de
  // Task ainda.
  attachments Attachment[]

  // Lembrete de vencimento (type=PRAZO) criado junto com a conta em createInstallmentReminder
  // (lib/actions/financeiro.ts) — aponta pra exatamente uma das duas ou pra nenhuma (tarefa comum,
  // sem vínculo financeiro). onDelete: Cascade porque o lembrete não faz sentido sem a parcela que
  // o gerou; syncPayableStatus/syncReceivableStatus concluem esta tarefa quando a parcela é paga
  // (achado A26 da revisão gauntlet).
  receivableId String?
  receivable   Receivable? @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  payableId String?
  payable   Payable? @relation(fields: [payableId], references: [id], onDelete: Cascade)

  responsibleId String?
  responsible   User?   @relation("TaskResponsible", fields: [responsibleId], references: [id])

  completedBy User? @relation("TaskCompletedBy", fields: [completedById], references: [id])

  // Delegação: quando preenchido, indica que a tarefa foi atribuída por outra pessoa
  // (não criada pelo próprio responsável) — usado para gerar alerta/notificação só
  // para quem recebeu, até que ela seja aberta (delegationAcknowledgedAt).
  delegatedById            String?
  delegatedBy              User?     @relation("TaskDelegatedBy", fields: [delegatedById], references: [id])
  delegationAcknowledgedAt DateTime?

  columnId    String?
  column      KanbanColumn? @relation(fields: [columnId], references: [id])
  columnOrder Int           @default(0)

  points Int @default(0) // TaskScore: pontuação de produtividade da tarefa

  comments Comment[]

  @@index([officeId])
  @@index([officeId, dueDate])
}

// ============ TASKSCORE (pontuação de produtividade por tipo de tarefa) ============

model TaskTypePoints {
  id     String @id @default(cuid())
  type   String // TAREFA | EVENTO | AUDIENCIA | PERICIA | PRAZO
  points Int    @default(10)

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@unique([officeId, type])
}

// ============ WORKFLOWS (cadeias padronizadas de tarefas) ============

model WorkflowTemplate {
  id          String   @id @default(cuid())
  name        String
  area        String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  steps WorkflowStep[]

  @@index([officeId])
}

model WorkflowStep {
  id         String  @id @default(cuid())
  order      Int     @default(0)
  title      String
  taskType   String  @default("TAREFA") // TAREFA | EVENTO | AUDIENCIA | PERICIA | PRAZO
  offsetDays Int     @default(0) // dias após a aplicação do workflow
  priority   String  @default("MEDIA") // BAIXA | MEDIA | ALTA | URGENTE
  role       String? // cargo sugerido do responsável (Advogado, Estagiário, etc.)
  points     Int? // pontuação opcional; se nula usa o padrão do tipo

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  templateId String
  template   WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  // Comentário compartilhado numa Licitação (aba Licitações da Assessoria) — visível a todo o
  // escritório, diferente do painel pessoal de Anotações (model Anotacao). Mesmo padrão de
  // caseId/taskId acima.
  licitacaoId String?
  licitacao   Licitacao? @relation(fields: [licitacaoId], references: [id])

  mentions Mention[]

  @@index([officeId])
}

// Painel global "Anotações" (faixa retrátil na borda direita, disponível em qualquer página do
// site — ver components/anotacoes/AnotacoesPanel.tsx). Nota pessoal do usuário, formatada em
// HTML simples (editor contentEditable com negrito/itálico/sublinhado/listas — sem lib externa),
// com uma data "consignar em" própria (não é a data de criação: o usuário escolhe a que dia a
// anotação se refere). "Pessoal" de propósito: só o próprio autor vê/gerencia as suas, mesmo que
// vinculadas a uma entidade compartilhada pelo escritório todo (ver getCurrentUser + filtro
// authorId nas consultas que listam anotações).
//
// linkType guarda qual dos 7 chips foi escolhido no painel, mesmo quando duas opções resolvem
// para a MESMA FK: "Processo Judicial", "Processo Administrativo" e "Caso" são todos um Case
// (diferenciados só por Case.type — ver lib/caseNatureza.ts), então caseId sozinho não bastaria
// para saber qual chip o usuário realmente clicou (ex.: mostrar de volta o chip certo ao reabrir
// um rascunho). "Atendimento" aponta para Attendance (model separado — não confundir com o
// legado Case.type = "ATENDIMENTO"). "Financeiro" e "Outros" não têm entidade específica, ficam
// só com linkType preenchido e as 3 FKs nulas.
model Anotacao {
  id            String   @id @default(cuid())
  content       String // HTML gerado pelo editor (negrito/itálico/sublinhado/listas), sanitizado
  // no servidor antes de gravar — ver lib/anotacoes.ts:sanitizeAnotacaoHtml.
  referenceDate DateTime // "Consignar em" — escolhida pelo usuário, independente de createdAt.
  linkType      String // PROCESSO_JUDICIAL | PROCESSO_ADMINISTRATIVO | CASO | ASSESSORIA | ATENDIMENTO | FINANCEIRO | OUTROS
  createdAt     DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])

  assessoriaId String?
  assessoria   Assessoria? @relation(fields: [assessoriaId], references: [id])

  @@index([officeId])
  @@index([authorId])
  @@index([caseId])
  @@index([attendanceId])
  @@index([assessoriaId])
}

model Mention {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId, userId, read])
}

// ============ ATENDIMENTO (setor de atendimento / triagem) ============

model Attendance {
  id              String  @id @default(cuid())
  clientName      String
  contact         String? // legado: telefone/e-mail juntos em texto livre (formulários antigos, mantido sem migração destrutiva)
  contactPhone    String? // telefone do contato, separado do e-mail (clientEmail abaixo)
  contactPhoneDdi String? // dígitos do código do país (ex.: "55") — ver components/PhoneInput.tsx
  subject         String
  area            String? // matéria
  description     String? // descrição detalhada do que precisa
  channel         String  @default("WHATSAPP") // WHATSAPP | EMAIL | TELEFONE | PRESENCIAL
  status          String  @default("NOVO") // NOVO | EM_TRIAGEM | CONVERTIDO | ARQUIVADO | RASCUNHO

  // ── O ATENDENTE DE IA, NESTA CONVERSA ───────────────────────────────────────────────────────
  //
  // A chave é POR CONVERSA, e não só por escritório, porque foi assim que o dono descreveu: o
  // atendente responde onde está marcado para responder. Marcar no meio de uma conversa passa a
  // valer da próxima pergunta em diante — e há um botão à parte para responder à última pergunta
  // que ficou sem resposta, quando é isso que se quer.
  //
  // `false` é o padrão, e é de propósito: uma conversa nova com cliente de verdade não começa
  // sendo respondida por máquina sem alguém ter decidido isso.
  agenteResponde Boolean @default(false)

  // QUANDO UM HUMANO ASSUMIU. A partir daqui o atendente não fala mais NESTA conversa, nem que
  // alguém torne a marcar a chave. O cliente que recebe resposta de gente e depois de máquina
  // percebe na hora com o que estava falando — e a confiança não volta.
  agenteSilenciadoEm DateTime?

  // DE QUAL CAMPANHA VEIO. Gravado quando o atendimento nasce, porque só a primeira mensagem
  // carrega a origem — depois dela não há mais de onde tirar.
  campanhaId String?
  campanha   Campanha? @relation(fields: [campanhaId], references: [id])

  // O que o anúncio mandou junto, guardado cru. Serve para casar a campanha, e serve para
  // descobrir depois por que uma conversa NÃO casou com nenhuma.
  anuncioSourceUrl String?
  anuncioSourceId  String?
  anuncioTitulo    String?

  // O prazo dos documentos obrigatórios. Quem escreve às onze da noite sem a negativa do plano em
  // mãos não é lead desqualificado — é lead sem o papel naquele instante.
  prazoDocumentosAte DateTime?

  // Por que foi recusado, quando foi. Separado de propósito: "não tinha o documento agora" e
  // "não quer pagar" não podem virar a mesma estatística, senão o número não diz nada.
  motivoDeRecusa String?

  // QUANDO E POR QUE FOI TRANSFERIDO. `transferidoPor` guarda o gatilho (RISCO, PEDIDO, ROTEIRO,
  // FORA_DO_ESCOPO, TETO) — é o que permite saber, daqui a um mês, se os leads estão chegando ao
  // advogado por triagem concluída ou por terem estourado o teto de mensagens. As duas coisas
  // pedem providências opostas.
  transferidoEm  DateTime?
  transferidoPor String?

  // ── O RELÓGIO DE QUINZE MINUTOS ────────────────────────────────────────────────────────────
  //
  // `prazoDeRespostaAte` é o instante em que o dono da vez perde a vez — quinze minutos DE
  // EXPEDIENTE depois de a conversa ter chegado a ele (ver lib/filaDeTransferencia.ts:
  // somarMinutosDeExpediente). O prazo é GRAVADO, e não recalculado a cada leitura: a conta é uma
  // caminhada para a frente, muito mais simples de escrever e de provar do que medir um intervalo
  // de expediente entre duas datas quaisquer — e mudar o expediente amanhã não reescreve o prazo
  // dos leads de hoje. Nulo quando o relógio parou (alguém respondeu) ou nunca começou.
  prazoDeRespostaAte DateTime?

  // Quem JÁ TEVE A VEZ neste lead, por id, separado por vírgula. Guardar a lista (e não um
  // contador de voltas) é o que impede o lead de voltar à mesma pessoa quando alguém entra ou sai
  // da fila no meio do caminho — é aí que um contador erra, porque o tamanho da fila mudou embaixo
  // dele.
  filaJaTentou String?

  // A VOLTA FECHOU e ninguém atendeu. Carimbado uma vez só, e é o que faz o repasse parar de
  // tentar: sem ele o cron giraria o mesmo lead para sempre, avisando todo mundo a cada rodada.
  semRespostaEm DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  // Funil comercial (CRM de captação) — eixo independente do status operacional acima
  stage          String    @default("NOVO") // NOVO | QUALIFICACAO | PROPOSTA | FECHADO | PERDIDO
  estimatedValue Float? // valor estimado do contrato — dobra de "valor em dinheiro" do honorário
  // pretendido (feeMode abaixo) quando ele inclui DINHEIRO, para não duplicar o mesmo número em
  // dois campos.
  leadSource     String? // INDICACAO | INSTAGRAM | GOOGLE | SITE | WHATSAPP | OUTRO
  // Preenchido (obrigatoriamente, a partir da Fase 5) ao mover para PERDIDO — opções fechadas em
  // components/AttendanceLostReasonModal.tsx (Preço | Prazo | Escolheu outro escritório | Desistiu
  // da ação | Sem resposta | Fora da nossa área | Outro: <texto livre>). Alimenta o relatório de
  // captação — por isso nunca mais fica nulo depois que o estágio vira PERDIDO uma vez.
  lostReason     String?
  nextContactAt  DateTime? // data do próximo contato/follow-up
  stageChangedAt DateTime? // quando o estágio comercial mudou pela última vez

  // ── O QUE A ANA DECIDIU SEM PODER DECIDIR SOZINHA ──────────────────────────────────────────
  //
  // A PROPOSTA DE RECUSA. Fora dos contornos que o escritório escreveu (ver lib/parametrosDaAna.ts)
  // a Ana não encerra: ela transfere e deixa aqui, em uma frase, por que acha que o escritório não
  // deveria pegar o caso. ESTE TEXTO NUNCA SAI PARA O CLIENTE — é nota interna, e a mesma marca que
  // o traz é retirada da mensagem antes do envio.
  propostaDeRecusa   String?
  propostaDeRecusaEm DateTime?

  // A ESPERA DO DOCUMENTO, que NÃO é recusa. Preenchido quando a Ana pediu um documento sem o qual
  // o escritório não analisa: o atendimento fica guardado até esta data em vez de ser encerrado.
  // Falta de papel é "ainda não", nunca "não".
  documentoAte      DateTime?
  documentoPendente String?

  // Honorário PRETENDIDO (Fase 5) — forma de cobrança que o advogado pretende propor ao lead,
  // capturada já na triagem para não ser redigitada na conversão em Processo (ver
  // convertAttendanceToCase, lib/actions/attendance.ts, que usa estes 3 campos + estimatedValue
  // acima só para PRÉ-PREENCHER o Lançar Honorários do processo novo — nunca cria a cobrança
  // sozinho, o advogado sempre confirma). Mesmo vocabulário do financeiro (ver
  // lib/honorarioLancamento.ts) para não inventar um segundo dicionário de termos.
  feeMode           String? // DINHEIRO | PERCENTUAL | AMBOS
  feePercentual     Float? // % pretendido, só relevante quando feeMode inclui PERCENTUAL
  feePercentualBase String? // VALOR_CAUSA | PROVEITO_ECONOMICO | CONDENACAO | ACORDO

  // Prazo de resposta ao lead (Fase 5) — "lead sem retorno é lead perdido". Default 24h após a
  // criação (calculado no client, ver NewAttendanceModal.tsx), editável na janela de criação.
  // firstResponseAt é carimbado sozinho no primeiro e-mail/WhatsApp enviado deste atendimento (ver
  // replyWhatsapp/replyEmail abaixo) ou manualmente via markAttendanceResponded, para quando a
  // resposta saiu por um canal que o sistema não rastreia (telefone, presencial). Alerta na
  // Central quando responseDeadline estoura sem firstResponseAt (ver lib/alerts.ts).
  responseDeadline DateTime?
  firstResponseAt  DateTime?

  // Integração WhatsApp (Cloud API oficial da Meta) — número/credenciais por escritório (Fase 2)
  waPhone         String? // telefone do cliente no WhatsApp (E.164), usado como chave de conversa
  waLastMessageAt DateTime? // instante da última mensagem trocada nesta conversa

  // Integração E-mail (resposta via Gmail da conta Google do próprio advogado)
  // Reaproveitado também como e-mail do contato no formulário de criação do atendimento.
  clientEmail String? // e-mail do cliente para resposta; preenchido manualmente na tela

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // Vínculo com cadastro de Client — preenchido ao selecionar um cliente já cadastrado
  // na busca, ou automaticamente após "Cadastrar novo cliente" ser finalizado (não em rascunho).
  clientId String?
  client   Client? @relation("AttendanceClient", fields: [clientId], references: [id])

  responsibleId String?
  responsible   User?   @relation("AttendanceResponsible", fields: [responsibleId], references: [id])

  convertedCaseId String?
  convertedCase   Case?   @relation("AttendanceConvertedCase", fields: [convertedCaseId], references: [id])

  // Mesmo vínculo opcional com Assessoria disponível no cadastro de Processo (ver Case.assessoriaId).
  assessoriaId String?
  assessoria   Assessoria? @relation(fields: [assessoriaId], references: [id])

  // Pasta própria deste atendimento no Drive (Atendimentos/{subject}), criada sob demanda no
  // primeiro anexo (ver lib/googleDrive.ts, getOrCreateAttendanceFolder). Se o atendimento virar
  // Processo (convertAttendanceToCase), a pasta é só renomeada e transferida pro Case — nunca
  // duplicada.
  driveFolderId String?

  tasks            Task[]
  attachments      Attachment[]
  whatsappMessages WhatsappMessage[]
  emailMessages    EmailMessage[]
  driveSyncIssues  DriveSyncIssue[]
  pendencias       AtendimentoPendencia[]
  recusas          RecusaDeAtendimento[]
  // Anotações pessoais (painel global "Anotações", chip "Atendimento") vinculadas a este
  // Attendance — model separado de Case, não confundir com o legado Case.type = "ATENDIMENTO".
  anotacoes        Anotacao[]

  @@index([officeId])
  @@index([officeId, waPhone])
}

// ============ PENDÊNCIAS DO ATENDIMENTO (Fase 5) ============

// O que falta para fechar o atendimento, nas duas direções: pedir algo AO lead (SOLICITAR) ou
// mandar algo PARA o lead (ENVIAR) — ver lib/pendencias.ts para o vocabulário fechado de `kind`
// por direção. Fecha sozinha (status CONCLUIDA + completedAt) quando um anexo do tipo de documento
// correspondente é registrado neste atendimento (só para os 3 casos com correspondência 1:1 no
// catálogo — ver DOC_TYPE_TO_PENDENCIA_ENVIAR); o resto se fecha à mão na tela do atendimento.
// Aparece em aberto na tela de detalhe do atendimento e na Central de Alertas (com o prazo) quando
// vencida — ver lib/alerts.ts.
model AtendimentoPendencia {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  direction   String // SOLICITAR | ENVIAR
  kind        String // ver lib/pendencias.ts (SOLICITAR_KIND_OPTIONS / ENVIAR_KIND_OPTIONS)
  // "Quais?" — só preenchido/exigido para os kinds que pedem descrição livre (Documentos,
  // Informações, Outros — ver pendenciaKindNeedsDescription em lib/pendencias.ts).
  description String?
  status      String    @default("PENDENTE") // PENDENTE | CONCLUIDA
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  responsibleId String?
  responsible   User?   @relation("AtendimentoPendenciaResponsible", fields: [responsibleId], references: [id])

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId])
  @@index([attendanceId])
}

// ============ WHATSAPP (mensagens da integração com a Cloud API da Meta) ============

model WhatsappMessage {
  id                           String     @id @default(cuid())
  attendanceId                 String
  attendance                   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  direction                    String // "IN" (do cliente) | "OUT" (do escritório)
  // Quem escreveu a mensagem de saída: o atendente de IA ou uma pessoa. É o que permite marcar a
  // conversa com "respondido pelo atendente" na tela, e é o que faz a regra do silêncio funcionar
  // — a resposta da máquina não pode calar a própria máquina.
  porAgente                    Boolean    @default(false)
  // TRUE só na frase fixa de "recebi seu áudio" (lib/confirmacaoDeAudio.ts). Achado real (não
  // teórico — reproduzido e corrigido depois de um relatório): sem esta marca, a própria
  // confirmação virava "a última mensagem", e a checagem "a última tem que ser do cliente" (mais
  // abaixo, e em lib/atendenteResponde.ts) fechava a porta para a RESPOSTA DE VERDADE que viria
  // depois da transcrição — a Ana prometia responder e nunca respondia. Esta marca deixa
  // `atendenteResponde` ignorar a confirmação automática ao decidir se há uma pergunta pendente,
  // sem abrir mão da trava para qualquer OUTRA mensagem de saída (inclusive uma resposta anterior
  // de verdade da própria Ana, que continua bloqueando corretamente — só a confirmação some).
  confirmacaoAutomaticaDeAudio Boolean    @default(false)
  body                         String
  waMessageId                  String?    @unique // id da mensagem na Meta (dedupe)
  status                       String     @default("RECEIVED") // RECEIVED | SENT | FAILED
  fromNumber                   String? // telefone do cliente (E.164)
  createdAt                    DateTime   @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // A TRANSCRIÇÃO DO ÁUDIO (quando esta mensagem É um áudio) — ver o modelo TranscricaoDeAudio
  // logo abaixo, e o comentário nele sobre por que é um registro próprio, e não um campo aqui.
  transcricao TranscricaoDeAudio?

  @@index([officeId, attendanceId, createdAt])
}

// ============ TRANSCRIÇÃO DE ÁUDIO DO WHATSAPP (ouvir, sem virar mensagem) ============
//
// REGISTRO PRÓPRIO — não um campo `interna: Boolean` em WhatsappMessage, e não uma WhatsappMessage
// nova. DECISÃO DE PROJETO, não implementação provisória: uma mensagem marcada como "interna"
// depende de TODO `where` que lê WhatsappMessage lembrar de excluí-la — e basta UM esquecimento no
// caminho de SAÍDA (sendWhatsappText, atendenteResponde, qualquer relatório futuro que percorra
// mensagens) para a transcrição ir parar no WhatsApp do cliente. Um registro que não É mensagem
// não tem como ser enviado por engano: nenhum código que manda mensagem para o WhatsApp sabe que
// este modelo existe, e não precisa saber.
//
// 1:1 com a WhatsappMessage do áudio (`@unique` em whatsappMessageId) — cada áudio recebido tem no
// máximo uma transcrição, e o relacionamento nasce/atualiza pelo `upsert` em lib/transcricao.ts.
model TranscricaoDeAudio {
  id                String          @id @default(cuid())
  whatsappMessageId String          @unique
  whatsappMessage   WhatsappMessage @relation(fields: [whatsappMessageId], references: [id], onDelete: Cascade)

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // PENDENTE (baixando o áudio / esperando o serviço) | PRONTA (texto abaixo preenchido) | FALHOU
  // (erro abaixo preenchido — inclusive quando TRANSCRICAO_URL/TRANSCRICAO_TOKEN não estão
  // configurados: ver lib/transcricaoDeAudio.ts:ERRO_TRANSCRICAO_NAO_CONFIGURADA — "não configurado"
  // NÃO é um quarto estado, é um MOTIVO de falha, para a tela e o agente sempre terem uma resposta
  // honesta em só três estados possíveis).
  status String  @default("PENDENTE")
  // O que a Ana lê no lugar da mensagem de áudio (lib/atendenteResponde.ts) e o que a tela mostra
  // na bolha, para quem tem acesso ao atendimento — nunca enviado ao cliente por nenhum caminho.
  texto  String?
  // Motivo da falha, em linguagem de gente. NUNCA o corpo bruto da resposta do serviço de
  // transcrição: um serviço mal configurado pode ecoar de volta o que recebeu (inclusive o
  // cabeçalho Authorization), e aquele valor é o TOKEN — ver lib/transcricaoDeAudio.ts:lerRespostaDeTranscricao.
  erro   String?

  // ONDE O ÁUDIO FICA GUARDADO DE VERDADE — o MESMO arquivo que processarMidiaRecebida (F5) já
  // sobe pro Drive/OneDrive/Dropbox do escritório, gravado aqui na hora em que o upload termina.
  // A TRANSCRIÇÃO É ASSÍNCRONA (fora do pedido do webhook — ver lib/transcricaoAssincrona.ts e o
  // comentário em app/api/transcricao/processar/route.ts) e por isso não tem mais o Buffer em
  // mãos quando chega a hora de transcrever: a URL de mídia da Meta já expirou a essa altura. Em
  // vez de guardar o áudio duas vezes (ou arriscar um segundo download da Meta/Evolution, que pode
  // já ter descartado o arquivo), o processo assíncrono BAIXA DO DRIVE — que não expira — usando
  // estes dois campos. `null` quando o upload pro Drive falhou: sem cópia durável, a transcrição
  // não tem de onde ler, e falha honestamente (ver ERRO_ARQUIVO_INDISPONIVEL).
  storageProvider String?
  storageFileId   String?

  criadoEm    DateTime  @default(now())
  concluidoEm DateTime? // quando virou PRONTA ou FALHOU (nulo enquanto PENDENTE)

  @@index([officeId])
  // A rede de segurança por cron (app/api/cron/transcricoes-pendentes) varre por status +
  // antiguidade — este índice é o que faz essa varredura não custar um full scan da tabela.
  @@index([status, criadoEm])
}

// ============ E-MAIL (resposta ao cliente via Gmail da conta Google do próprio advogado) ============

model EmailMessage {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  direction    String // "OUT" (por enquanto só enviamos, não há ingestão de e-mail recebido nesse fluxo)
  toAddress    String
  fromAddress  String
  subject      String
  body         String
  sentByUserId String?
  sentByUser   User?      @relation("EmailMessageSentBy", fields: [sentByUserId], references: [id])
  status       String     @default("SENT") // SENT | FAILED
  errorMessage String?
  createdAt    DateTime   @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId, attendanceId, createdAt])
}

// ============ ANEXOS (referência ao repositório de arquivos conectado — Drive/OneDrive/etc.) ============

model Attachment {
  id        String    @id @default(cuid())
  name      String
  driveUrl  String
  docType   String    @default("OUTRO") // ver lib/documentTypes.ts
  createdAt DateTime  @default(now())
  // Data da última alteração do ARQUIVO NO DRIVE (não de um campo deste registro) — nulo até a
  // primeira vez que alguém volta pra aba do Lúmen depois de abrir o documento (ver
  // refreshAttachmentModifiedDate, lib/actions/attachments.ts, chamada pelo listener de "focus"
  // da janela em components/AttachmentList.tsx). Pedido do dono do escritório: editar e salvar um
  // documento (Google Docs sempre edita o MESMO arquivo, nunca cria outro — não há "substituir"
  // pra fazer) precisa refletir na tela sem precisar reenviar nada, mudando só a data mostrada
  // como "Enviado em". Sem isso, o campo ficava preso pra sempre na data de criação do registro.
  updatedAt DateTime?

  // Provedor e id do arquivo usados no upload — "GOOGLE_DRIVE" | "ONEDRIVE" (default preserva o
  // comportamento de todo anexo já existente, sempre Google). Gravado explicitamente desde esta
  // entrega para a exclusão (lib/actions/attachments.ts:deleteAttachment) não precisar mais
  // adivinhar o id do arquivo por regex na URL (extractDriveFileId) — isso não escala para um
  // segundo provedor com formato de URL diferente. Registros anteriores a esta entrega ficam com
  // storageFileId nulo e continuam sendo apagados pelo caminho antigo (regex + sempre Google, já
  // que não existiam outros provedores quando foram criados).
  storageProvider String  @default("GOOGLE_DRIVE")
  storageFileId   String?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])

  // Anexo de uma Licitação (aba Licitações da Assessoria) — mesmo padrão de caseId/attendanceId
  // acima: coluna própria opcional, não FK genérica. Documento GERAL da licitação (sem taskId
  // abaixo) vive em Licitacao.driveFolderId; documento de uma demanda específica (com taskId)
  // vive na subpasta própria dela, um nível mais fundo.
  licitacaoId String?
  licitacao   Licitacao? @relation(fields: [licitacaoId], references: [id])

  // Escopa um Attachment de Licitação a UMA demanda/tarefa específica dela — opcional: sem
  // taskId, o documento é "geral" da licitação (Licitacao.driveFolderId); com taskId, vive dentro
  // da pasta própria daquela tarefa (Task.driveFolderId). Só usado hoje quando licitacaoId também
  // está preenchido; Attachment de Processo/Atendimento nunca tem taskId.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  // Protocolos que REFERENCIAM este anexo (ver ProtocoloLoteItem) e protocolos dos quais este
  // anexo é o comprovante. Um mesmo documento pode entrar em vários protocolos sem nunca ser
  // copiado — é essa relação, e não uma cópia de arquivo, que compõe um protocolo.
  protocoloItens         ProtocoloLoteItem[] @relation("ProtocoloLoteItemAttachment")
  protocoloComprovanteDe ProtocoloLote[]     @relation("ProtocoloLoteComprovante")

  // Envios (E-mail/WhatsApp) que REFERENCIAM este anexo — ver DocumentoEnvioItem, mesmo espírito
  // de protocoloItens acima: nunca uma cópia, só a referência.
  documentoEnvioItens DocumentoEnvioItem[] @relation("DocumentoEnvioItemAttachment")

  @@index([officeId])
}

// ============ PROTOCOLOS (aba Protocolos do Processo) ============

// Um protocolo do processo: a lista ordenada de documentos enviados (ou a enviar) ao tribunal/
// órgão, mais número, data e comprovante. NUNCA guarda arquivo — só referências a Attachment
// (ver ProtocoloLoteItem). É essa decisão que impede duplicar documento: o arquivo continua
// existindo uma única vez, na subpasta do tipo dele, e o protocolo só aponta para ele.
model ProtocoloLote {
  id         String  @id @default(cuid())
  titulo     String
  // EM_PREPARO | PRONTO | PROTOCOLADO | CANCELADO — ver PROTOCOLO_STATUS em lib/protocolos.ts.
  status     String  @default("EM_PREPARO")
  observacao String?

  // Só preenchidos quando o lote vira PROTOCOLADO.
  numeroProtocolo  String?
  protocoladoEm    DateTime?
  protocoladoPorId String?
  protocoladoPor   User?     @relation("ProtocoloLoteProtocoladoPor", fields: [protocoladoPorId], references: [id])

  // Pasta-espelho no Drive contendo APENAS atalhos para os documentos originais (Google Drive;
  // OneDrive/Dropbox não têm atalho equivalente e ficam sem pasta, sem perder funcionalidade —
  // o site é a fonte da verdade). Criada sob demanda, nula até alguém pedir; apagada inteira
  // quando o lote é cancelado, o que é seguro justamente por só conter atalhos.
  driveFolderId String?

  // O comprovante é o ÚNICO arquivo novo que um protocolo cria — e entra como Attachment comum
  // (docType COMPROVANTE_PROTOCOLO), na subpasta do tipo dele, como qualquer outro anexo.
  comprovanteId String?
  comprovante   Attachment? @relation("ProtocoloLoteComprovante", fields: [comprovanteId], references: [id], onDelete: SetNull)

  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  criadoPorId String?
  criadoPor   User?   @relation("ProtocoloLoteCriadoPor", fields: [criadoPorId], references: [id])

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  itens ProtocoloLoteItem[]

  // Tarefa/prazo vinculado a este lote (ex.: "protocolar até tal data") — ver
  // criarTarefaDoLote/vincularTaskAoLote em lib/actions/protocolos.ts. De propósito SEM
  // `@relation` para Task: é uma referência solta (só o id), não uma relação formal do Prisma —
  // assim o model Task (fora do bloco Protocolos) não precisa ganhar um campo de volta só para
  // isso. A tarefa em si é lida/gravada à parte (prisma.task), como qualquer outra tarefa comum;
  // apagar a tarefa não apaga nem trava o lote, só faz este id apontar para um registro que não
  // existe mais — tratado como "sem tarefa vinculada" na leitura (getVinculoTarefa).
  taskId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId])
  @@index([caseId])
}

// Uma linha da lista de um protocolo: a ordem + o anexo referenciado.
//
// nomeSnapshot/docTypeSnapshot são cópia do nome e do tipo no momento em que o documento entrou
// no protocolo — de propósito. Um protocolo concluído é registro histórico: se alguém excluir o
// anexo depois (confirmando o aviso de deleteAttachment), attachmentId fica nulo (onDelete:
// SetNull) mas a linha permanece, mostrando o que foi protocolado e que o arquivo não existe
// mais. Sem isso, um histórico de protocolo perderia linhas em silêncio.
model ProtocoloLoteItem {
  id    String @id @default(cuid())
  ordem Int

  loteId String
  lote   ProtocoloLote @relation(fields: [loteId], references: [id], onDelete: Cascade)

  attachmentId String?
  attachment   Attachment? @relation("ProtocoloLoteItemAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)

  nomeSnapshot    String
  docTypeSnapshot String

  // Id do atalho criado no Drive para este item (Google Drive). Guardado para conseguir apagar
  // exatamente este atalho ao remover o documento do lote, sem varrer a pasta procurando por nome.
  driveShortcutId String?

  @@unique([loteId, attachmentId])
  @@index([loteId])
}

// ============ ENVIOS DE DOCUMENTOS (E-mail/WhatsApp — mesma aba Protocolos) ============

// Registro de que um conjunto de documentos deste processo foi ENVIADO a alguém por e-mail ou
// WhatsApp — não é um protocolo (não vai a tribunal/órgão, não tem número oficial), é o rastro de
// "mandei o Parecer X e a Procuração Y para fulano, por e-mail, no dia tal". Mesmo espírito de
// ProtocoloLote acima: NUNCA guarda arquivo, só referencia Attachment (ver DocumentoEnvioItem). O
// envio de verdade (redigir e mandar o e-mail/mensagem) acontece fora do sistema — o botão que
// cria este registro só abre um mailto:/wa.me pré-preenchido como conveniência; nenhuma integração
// de envio real é feita por aqui.
model DocumentoEnvio {
  id     String @id @default(cuid())
  metodo String // EMAIL | WHATSAPP — ver DOCUMENTO_ENVIO_METODOS em lib/documentoEnvios.ts

  // Nome de quem recebeu, sempre preenchido (cadastrado ou digitado na hora) — é o que aparece no
  // histórico, já que destinatarioContato sozinho (um e-mail ou telefone) diria pouco por si.
  destinatarioNome    String
  // E-mail ou telefone conforme `metodo` — pode vir de Client/Lawyer/Supplier já cadastrado ou ser
  // digitado na hora (a pessoa nem sempre está cadastrada); nenhuma FK para não travar o registro
  // à existência contínua do cadastro de origem.
  destinatarioContato String

  enviadoEm DateTime @default(now())

  enviadoPorId String?
  enviadoPor   User?   @relation(fields: [enviadoPorId], references: [id])

  // Dono do envio: Processo, Assessoria OU Licitação — exatamente um dos três preenchido
  // (validado na aplicação, ver lib/actions/documentoEnvios.ts). caseId era obrigatório antes de
  // a Assessoria ganhar este mesmo botão "Enviar E-mail/WhatsApp"; virou opcional de forma
  // aditiva, sem quebrar nenhum envio de Processo já existente (todos continuam com caseId
  // preenchido e os outros dois nulos) — licitacaoId segue a mesma aditividade.
  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  assessoriaId String?
  assessoria   Assessoria? @relation(fields: [assessoriaId], references: [id])

  licitacaoId String?
  licitacao   Licitacao? @relation(fields: [licitacaoId], references: [id])

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  itens DocumentoEnvioItem[]

  createdAt DateTime @default(now())

  @@index([officeId])
  @@index([caseId])
  @@index([assessoriaId])
  @@index([licitacaoId])
}

// Uma linha da lista de um envio: o anexo referenciado, com snapshot do nome/tipo — mesmo motivo
// de ProtocoloLoteItem.nomeSnapshot/docTypeSnapshot: um envio é registro histórico, e continua
// mostrando o que foi mandado mesmo que o anexo original seja renomeado ou apagado depois
// (attachmentId fica nulo via onDelete: SetNull, a linha permanece).
model DocumentoEnvioItem {
  id String @id @default(cuid())

  envioId String
  envio   DocumentoEnvio @relation(fields: [envioId], references: [id], onDelete: Cascade)

  // Referencia exatamente um entre attachmentId (Processo) e assessoriaDocumentoId (Assessoria) —
  // qual dos dois depende de quem é o dono do DocumentoEnvio (envio.caseId vs envio.assessoriaId),
  // validado na aplicação (ver lib/actions/documentoEnvios.ts).
  attachmentId String?
  attachment   Attachment? @relation("DocumentoEnvioItemAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)

  assessoriaDocumentoId String?
  assessoriaDocumento   AssessoriaDocumento? @relation("DocumentoEnvioItemAssessoriaDocumento", fields: [assessoriaDocumentoId], references: [id], onDelete: SetNull)

  nomeSnapshot    String
  docTypeSnapshot String

  @@index([envioId])
}

// Cabeçalho de um lançamento de honorários "parcelado" (aba Financeiro do Processo) — agrupa as
// Receivable geradas por ele (Receivable.honorarioLancamentoId) e guarda o valor total indicado
// no momento da criação, para a nota de divergência mostrada ao editar as parcelas (ver
// lib/actions/honorarios.ts, updateHonorarioLancamentoParcelas): soma o amount de toda parcela
// com vinculadoAoTotal=true e compara com valorTotalIndicado. Um honorário "único" (não
// parcelado) não passa por aqui — vira uma Receivable solta, com honorarioLancamentoId nulo,
// exatamente como antes.
model HonorarioLancamento {
  id                 String @id @default(cuid())
  // Total declarado pelo usuário ao criar o parcelamento (ex.: 5.000,00 no exemplo entrada +
  // êxito) — nunca recalculado sozinho depois; só serve de referência para a nota de
  // divergência. Nulo quando o próprio lançamento já nasce só com parcela(s) percentual(is)
  // sem nenhum valor total declarado.
  valorTotalIndicado Float?
  kind               String @default("HONORARIOS_CONTRATUAIS") // mesmo catálogo de Receivable.kind (ver comentário lá, inclui HONORARIOS_ACORDO desde a Fase 9)

  createdAt DateTime @default(now())

  // ---- Fase 1 (fundação de dados, ainda dormente) — mesmo par documentType/documentNumber/
  // issueDate/responsibleId/payerType/payerName de Receivable/Payable, aqui no CABEÇALHO do
  // parcelamento (as parcelas individuais têm os seus próprios, quando divergirem do cabeçalho).
  documentType   String?
  documentNumber String?
  issueDate      DateTime?
  responsibleId  String?
  responsible    User?     @relation("HonorarioLancamentoResponsible", fields: [responsibleId], references: [id])
  payerType      String    @default("CLIENTE") // CLIENTE | ADVERSA | OUTRO
  payerName      String?

  // "Encerrar sem êxito" — preserva o histórico do lançamento em vez de excluí-lo quando o
  // desfecho do processo não gera direito a honorário percentual (ex.: ação julgada
  // improcedente). encerradoMotivo é texto livre explicando o porquê, para quem olhar depois
  // entender a decisão sem precisar perguntar.
  encerradoEm     DateTime?
  encerradoMotivo String?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  categoryId String?
  category   FinancialCategory? @relation(fields: [categoryId], references: [id])

  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  parcelas Receivable[]

  @@index([officeId])
  @@index([caseId])
}

// Problema de estrutura encontrado no Drive pelo sync reverso (lib/driveSync.ts, cron diário
// app/api/cron/drive-sync/route.ts) — nasce de alguém salvando/renomeando algo direto no Drive
// (fora do app), fugindo da estrutura esperada ("Lúmen - Processos/{título}/{tipo de
// documento}"). O sync NUNCA move/renomeia/apaga nada sozinho quando não tem certeza — só
// registra aqui o que está errado e a correção exata, pra um sócio decidir e agir manualmente
// (ver Central de Alertas, kind DRIVE_INCONSISTENCIA em lib/alerts.ts, visível só a isAdmin).
// Uma linha por problema "ainda aberto"; resolvedAt marca quando o próprio sync deixou de
// detectá-lo numa rodada seguinte (pasta corrigida, arquivo movido, anexo re-registrado etc.) —
// nunca apagada, pra manter histórico de que existiu.
model DriveSyncIssue {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // Id no Drive do arquivo OU pasta que está com problema — junto com officeId+issueType forma
  // a chave usada pelo sync pra saber se um problema já detectado numa rodada anterior continua
  // valendo (atualiza) ou já sumiu (resolve), em vez de duplicar uma linha por dia.
  driveFileId String

  // PASTA_PROCESSO_SEM_CORRESPONDENCIA | PASTA_CATEGORIA_DESCONHECIDA |
  // ARQUIVO_SOLTO_SEM_CATEGORIA | ANEXO_SUMIU_DO_DRIVE — ver lib/driveSync.ts.
  // PASTA_PROCESSO_DUPLICADA_LEGADO_VS_NOVA — a migração de pastas legadas (raiz "RP Financeiro
  // - Processos" -> "Lúmen - Processos") achou, para um processo/atendimento, tanto a pasta
  // antiga quanto uma pasta homônima na raiz nova, AMBAS com conteúdo — não dá pra decidir
  // sozinho qual é a "certa" nem mesclar automaticamente sem risco de perder documento. Ver
  // lib/actions/driveFolderMigration.ts.
  // PASTA_ORFA_NA_RAIZ_LEGADA — pasta que ficou numa raiz ANTIGA do Drive e que nenhum
  // processo/atendimento aponta. O sync diário (lib/driveSync.ts) só varre a raiz nova, então
  // sem este alerta ela seguiria esquecida, com documento de cliente dentro. Idem.
  issueType String

  description  String // o que está errado, em linguagem simples
  suggestedFix String // a correção EXATA (ex: nome exato pra renomear a pasta) — vira o subtitle do alerta

  // Link direto pro arquivo/pasta no Drive, quando disponível (webViewLink da Drive API) — nem
  // sempre existe (ex: pasta raiz sem webViewLink retornado, ou pasta já removida entre a
  // detecção e a exibição do alerta).
  driveUrl String?

  // Processo/Atendimento já resolvido em cujo interior o problema foi encontrado (categoria com
  // nome errado, arquivo solto) — nulo quando o próprio problema É a pasta não corresponder a
  // nenhum processo/atendimento (PASTA_PROCESSO_SEM_CORRESPONDENCIA não tem um dos dois pra
  // apontar). Usado só para o alerta na Central de Alertas linkar direto pra página do
  // processo/atendimento em vez de cair no fallback genérico.
  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])

  detectedAt DateTime  @default(now())
  resolvedAt DateTime? // preenchido quando a rodada seguinte do sync deixa de encontrar o problema

  @@unique([officeId, driveFileId, issueType])
  @@index([officeId, resolvedAt])
}

// ============ MODELOS DE DOCUMENTO (contratos, procurações, declarações...) ============

model DocumentTemplate {
  id        String   @id @default(cuid())
  name      String // ex: "Contrato de honorários com pagamento de entrada + êxito"
  category  String // CONTRATO | PETICAO | PROCURACAO | DECLARACAO_HIPOSSUFICIENCIA | DECLARACAO_MORADIA | OUTRO
  driveUrl  String
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  @@index([officeId])
}

// ============ SOLICITAÇÕES DE EXCLUSÃO (aprovação de admin) ============

model DeletionRequest {
  id               String   @id @default(cuid())
  entityType       String // TASK | CASE | ATTENDANCE | PAYABLE | RECEIVABLE | HONORARIO_LANCAMENTO
  entityId         String
  entityLabel      String // snapshot legível (título/nome) para exibir mesmo após excluir
  // ONLY | FOLLOWING | ALL — só preenchido para RECEIVABLE/PAYABLE pertencentes a um agrupamento
  // (parcelamento, honorário parcelado ou honorário recorrente; ver requestDeletionScoped em
  // lib/actions/deletion.ts). Nulo para os demais entityType e para RECEIVABLE/PAYABLE avulsos —
  // nesses casos a aprovação segue o fluxo antigo (performDelete), sem escopo nenhum.
  scope            String?
  // Só relevante para RECEIVABLE/PAYABLE com um reembolso vinculado (ver Payable.
  // reimbursementReceivable/Receivable.reimbursesPayableId) — se true, aprovar esta solicitação
  // também exclui o registro vinculado (respeitando a mesma proteção de nunca apagar de fato um
  // status PAGO; ver performDelete em lib/actions/deletion.ts). Default false: comportamento
  // não-destrutivo — sem marcar, excluir só desvincula, como sempre foi.
  alsoDeleteLinked Boolean  @default(false)
  status           String   @default("PENDENTE") // PENDENTE | APROVADA | REJEITADA
  createdAt        DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  requestedById String
  requestedBy   User   @relation("DeletionRequestedBy", fields: [requestedById], references: [id])

  resolvedById String?
  resolvedBy   User?     @relation("DeletionResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?

  @@index([officeId])
}

// ============ INTEGRAÇÃO GOOGLE DRIVE (por escritório — Fase 2) ============

model GoogleCredential {
  id                String   @id @default(cuid())
  accountEmail      String   @unique
  refreshToken      String
  isPrimaryDrive    Boolean  @default(false) // conta usada para anexos/documentos DESTE escritório (uma só, escolhida na primeira conexão)
  syncJusbrasil     Boolean  @default(true) // se a caixa desta conta é varrida em busca de e-mails do Jusbrasil
  // Pasta-mãe "Lúmen" no Google Drive: TODAS as raízes do sistema (Processos, Casos,
  // Atendimentos, Assessoria, Anexos, Modelos, Documentos Gerados, Financeiro) passam a ser
  // filhas dela, em vez de nascerem soltas na raiz do Drive. É o mesmo desenho que OneDrive e
  // Dropbox já usam (MicrosoftCredential.rootFolderId / DropboxCredential.rootFolderId) — o
  // Google era o único provedor sem pasta-mãe. Nulo = escritório ainda não migrado.
  rootFolderId      String?
  folderId          String?
  templatesFolderId String?
  generatedFolderId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([officeId])
}

// Conta Microsoft (Outlook) conectada por uma pessoa do escritório — Fase 1 do pedido "sincronizar
// com OneDrive/Outlook/Dropbox": cobre recebimento (mesmo pipeline do Jusbrasil por e-mail, ver
// lib/outlookEmailSync.ts) e envio (Atendimento, ver lib/gmailSend.ts) via Outlook. Segue o mesmo
// desenho do GoogleCredential "modo jusbrasil" (por pessoa, não por escritório) — cada um conecta a
// própria caixa. O calendário do Outlook ainda não usa esta credencial (ver README_MICROSOFT.md
// para o que falta). isPrimaryDrive/rootFolderId (Fase 2 — armazenamento) espelham
// GoogleCredential.isPrimaryDrive/folderId, mas só uma pasta raiz aqui (não três: não há
// equivalente de Modelos/Gerados no Microsoft Graph nesta entrega, ver lib/oneDriveStorage.ts) —
// uma mesma conta pode ter uma linha só de e-mail (isPrimaryDrive: false) e depois virar também a
// conta de armazenamento do escritório (isPrimaryDrive: true), sem duplicar linha.
model MicrosoftCredential {
  id             String   @id @default(cuid())
  accountEmail   String   @unique
  refreshToken   String
  syncEmail      Boolean  @default(true)
  isPrimaryDrive Boolean  @default(false) // conta usada para anexos (OneDrive) DESTE escritório (uma só)
  rootFolderId   String? // id da pasta raiz "Lúmen" no OneDrive desta conta, cacheado (ver getOrCreateRootFolder)
  createdAt      DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([officeId])
}

// Conta Dropbox conectada como armazenamento DESTE escritório — ao contrário de
// MicrosoftCredential (por pessoa, com isPrimaryDrive para achar a "principal"), aqui é
// sempre uma linha por escritório: Dropbox não tem uso de e-mail neste projeto, só
// armazenamento, então não existe cenário de "várias contas conectadas, uma é a principal".
// rootFolderId cacheia o id (já no formato "id:XXXXX" retornado pela API) da pasta raiz "Lúmen"
// nesta conta — ver lib/dropboxStorage.ts, getOrCreateRootFolder.
model DropboxCredential {
  id           String   @id @default(cuid())
  accountEmail String
  refreshToken String
  rootFolderId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  officeId String @unique
  office   Office @relation(fields: [officeId], references: [id])
}

// ============ INTEGRAÇÃO WHATSAPP (por escritório — Fase 2) ============
// WHATSAPP_APP_SECRET/WHATSAPP_VERIFY_TOKEN continuam globais (variável de ambiente) — são do
// único Meta App/WABA da plataforma, compartilhado por todos os escritórios. O que é por
// escritório é o NÚMERO de telefone (phoneNumberId + accessToken), cadastrado aqui.
// phoneNumberId é único globalmente (é a Meta quem atribui) — é ele que o webhook usa pra
// descobrir a qual escritório uma mensagem recebida pertence (ver lib/whatsapp.ts).
// ============ CAMPANHAS DE TRÁFEGO PAGO ============
//
// O escritório anuncia no Instagram/Facebook, a pessoa clica em "Enviar mensagem" e cai no
// WhatsApp do escritório. A primeira mensagem dessa conversa carrega, no protocolo do WhatsApp,
// de onde ela veio — e é esse dado que liga a conversa a esta campanha.
//
// SÓ A PRIMEIRA MENSAGEM traz essa origem. Por isso a campanha é gravada no ATENDIMENTO na hora
// em que ele nasce, e não reconsultada a cada mensagem: a partir da segunda, não há mais de onde
// tirar.
//
// POR QUE ISTO É UMA TABELA E NÃO UM CAMPO DE TEXTO. Porque cada campanha tem roteiro próprio,
// documentos próprios e motivos de recusa próprios — e porque o escritório vai cadastrar várias,
// e trocá-las sem chamar ninguém.
// ── O CATÁLOGO DE MOTIVOS DE RECUSA ───────────────────────────────────────────────────────────
//
// Dois andares numa tabela só. `officeId` nulo é motivo-padrão da Lúmen, cadastrado no Painel
// Mestre; `officeId` preenchido é a camada daquele escritório.
//
// O ESCRITÓRIO NÃO GUARDA CÓPIA DO PADRÃO. Enquanto ele não editar, não existe linha dele nenhuma
// — ele aponta para o padrão, e por isso recebe a correção quando a Lúmen arruma uma frase. A
// linha da camada só nasce quando ele EDITA ou DESATIVA, e aí ela carrega `baseId`. A alternativa
// que parece mais simples (copiar tudo na primeira seleção) faz o catálogo apodrecer em silêncio.
//
// DESATIVAR EM VEZ DE APAGAR, quando há padrão atrás: excluir e "voltar ao padrão" são a mesma
// coisa vista de dois lados, e se a exclusão fosse definitiva o botão de voltar não teria para
// onde voltar. O que o escritório criou sozinho (sem `baseId`) some de verdade quando ele exclui.
//
// A regra inteira, com os porquês e os testes, está em lib/motivosDeRecusa.ts.
model MotivoDeRecusa {
  id String @id @default(cuid())

  // Nulo = padrão da plataforma (Painel Mestre). Preenchido = camada deste escritório.
  officeId String?
  office   Office? @relation(fields: [officeId], references: [id], onDelete: Cascade)

  // Preenchido só na camada do escritório, quando ela é a versão dele de um padrão.
  baseId  String?
  base    MotivoDeRecusa?  @relation("MotivoBase", fields: [baseId], references: [id], onDelete: Cascade)
  versoes MotivoDeRecusa[] @relation("MotivoBase")

  // A frase que vai para a carta que o lead lê. Uma frase, não um parágrafo.
  rotulo    String
  // Nota interna: quando usar este motivo. Nunca sai para o lead.
  descricao String?

  // Some das telas de quem desativou — da plataforma, para todos; do escritório, só para ele.
  desativado Boolean @default(false)
  ordem      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId])
  @@index([baseId])
}

// ── OS PARÂMETROS DE RECUSA DA ANA ────────────────────────────────────────────────────────────
//
// Quatro eixos, e eles NÃO são quatro coisas iguais. Três desenham o CONTORNO DO ESCRITÓRIO —
// matéria que ele não aceita, comarca fora do alcance, valor de causa abaixo do mínimo — e são
// fatos que não dependem do mérito de caso nenhum: ou a causa é trabalhista e o escritório não faz
// trabalhista, ou não é. É por isso que a Ana pode encerrar sozinha quando bate num deles, e é o
// único lugar onde ela encerra sozinha.
//
// O QUARTO NÃO É RECUSA. Documento que falta é ESPERA COM DATA: o escritório não está dizendo não,
// está dizendo "sem isto eu não consigo olhar". Tratar falta de documento como recusa transformaria
// em "não" definitivo o que é só um "ainda não" — e o lead que ia mandar a carteira de trabalho na
// segunda receberia uma carta de recusa no domingo.
//
// FORA DO CASO ÓBVIO, A ANA SÓ PROPÕE. Se o caso não bate exatamente num dos três contornos, ela
// não encerra: transfere com a proposta anotada, e quem decide é gente. A regra inteira, com os
// porquês e os testes, está em lib/parametrosDaAna.ts.
//
// E NADA DISTO REVOGA OS LIMITES DUROS (lib/agenteAtendimento.ts): a Ana não discute mérito e não
// promete resultado nem para recusar. "O escritório não atua nesta matéria" é contorno; "o seu caso
// não tem chance" é mérito, e ela não diz.

model ParametrosDeRecusa {
  id String @id @default(cuid())

  officeId String @unique
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  // EM CENTAVOS, e nulo quando o escritório não usa este critério — que é diferente de zero. Zero
  // seria "aceito causa de zero real", e o padrão precisa ser "não tenho piso", senão um escritório
  // que nunca abriu esta tela passaria a recusar por um valor que ninguém escolheu.
  valorMinimoDaCausa Int?

  // A ESPERA DO DOCUMENTO, em dias corridos. Corridos e não úteis porque a conta é dita ao cliente
  // no WhatsApp ("até dia 5") e ninguém conta dia útil de cabeça para conferir uma data que uma
  // máquina falou.
  diasParaODocumento Int @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CriterioDeRecusa {
  id String @id @default(cuid())

  officeId String
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  // MATERIA | COMARCA | DOCUMENTO. Os três numa tabela só porque são a mesma coisa do ponto de
  // vista da tela e do banco — uma linha de texto que o escritório acrescenta, edita e remove.
  eixo  String
  valor String
  ordem Int    @default(0)

  createdAt DateTime @default(now())

  @@index([officeId, eixo])
}

// ── A RECUSA DE UM LEAD ───────────────────────────────────────────────────────────────────────
//
// Recusar não é descartar: o lead sai das listas ativas (Attendance.status = "RECUSADO"), continua
// existindo e volta para a fila se alguém se convencer de que a recusa foi errada. Por isso cada
// recusa é uma LINHA, e não um campo no atendimento — um lead pode ser recusado, recuperado e
// recusado de novo, e o histórico disso é o que o escritório precisa ter para se defender.
//
// O MOTIVO É CONGELADO NO TEXTO. `motivoId` aponta para o catálogo, mas `motivoTexto` guarda a
// frase como ela era no dia. O catálogo muda; a carta que o lead recebeu, não — e é a carta que
// vale como prova.
model RecusaDeAtendimento {
  id String @id @default(cuid())

  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  officeId String
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  motivoId    String?
  motivoTexto String
  // Nota interna de quem recusou. Nunca sai para o lead.
  observacao  String?

  // Quem decidiu. `porAgente` é a Ana recusando sozinha no caso óbvio (fora da matéria da
  // campanha) — e é o que permite, depois, medir se ela está recusando bem.
  recusadaPorId String?
  recusadaPor   User?    @relation("RecusaAutor", fields: [recusadaPorId], references: [id])
  porAgente     Boolean  @default(false)
  recusadaEm    DateTime @default(now())

  // ── A CARTA ──────────────────────────────────────────────────────────────────────────────
  // O endereço público é único por recusa e impossível de adivinhar: um link sequencial deixaria
  // qualquer um passear pelas recusas do escritório trocando um número.
  token     String    @unique
  // Quando UMA PESSOA mandou o link. Não é automático de propósito: a recusa é o momento mais
  // delicado da relação, e é o único lugar onde a máquina mandando sozinha não economiza nada.
  enviadaEm DateTime?
  // A primeira vez que o lead abriu, e quantas vezes ao todo. É o que vale como prova de ciência
  // — mais do que o envio, e sem exigir um clique de "li e entendi" que metade não daria.
  abertaEm  DateTime?
  aberturas Int       @default(0)

  // ── O RADAR ──────────────────────────────────────────────────────────────────────────────
  // A data opcional de voltar a olhar. "Não tinha a negativa em março" pede data; "não quer
  // pagar" só pede memória.
  revisitaEm DateTime?

  // EM_ANALISE (na fila de recusados) | ARQUIVADA (virou histórico) | REVERTIDA (voltou à fila).
  estado String @default("EM_ANALISE")

  // Quem desfez ou arquivou, e quando. Registrado porque reverter uma recusa é decidir pegar um
  // caso, e agora isso tem mais de um autor possível (sócio E recepção).
  revertidaPorId String?
  revertidaPor   User?     @relation("RecusaRevisor", fields: [revertidaPorId], references: [id])
  revertidaEm    DateTime?
  arquivadaPorId String?
  arquivadaPor   User?     @relation("RecusaArquivista", fields: [arquivadaPorId], references: [id])
  arquivadaEm    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId, estado])
  @@index([attendanceId])
}

model Campanha {
  id String @id @default(cuid())

  officeId String
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  // 1 · Identificação
  nome     String // nome interno, só o escritório vê
  ativa    Boolean   @default(false) // nasce desligada: campanha meio preenchida não atende ninguém
  inicioEm DateTime?
  fimEm    DateTime?

  // 2 · O gatilho. Os dois podem coexistir — o link identifica, o texto é o palpite de reserva.
  sourceUrl     String? // o link de origem do anúncio, como chega no protocolo
  textoDoClique String? // o texto que já vem escrito quando a pessoa clica
  rede          String? // INSTAGRAM | FACEBOOK | OUTRA — só para o escritório se orientar

  // 3 · O objeto
  area         String
  sobre        String // uma frase: do que esta campanha trata
  foraDoEscopo String @default("FORMULARIO") // FORMULARIO | ACOLHE

  // 4 · A conversa
  primeiraMensagem String
  tetoDeMensagens  Int    @default(12)

  // 6 · O desfecho
  mensagemDeTransferencia String
  destino                 String @default("AUTOMATICO") // ADVOGADOS | RECEPCAO | AUTOMATICO

  // 7 · Motivos de recusa. Lista livre: as opções prontas vivem no código (lib/campanhas.ts) e o
  // escritório acrescenta as dele à mão — foi o que o dono pediu.
  motivosDeRecusa String[] @default([])

  perguntas    CampanhaPergunta[]
  documentos   CampanhaDocumento[]
  atendimentos Attendance[]

  // Preenchido só quando esta campanha ocupa um SLOT PAGO (a partir da 2ª ativa
  // simultaneamente — ver AssinaturaModuloCampanhas mais abaixo). A 1ª campanha ativa no
  // momento não precisa de slot: já está coberta pela mensalidade do módulo.
  slotPago CampanhaSlotPago?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId, ativa])
}

model CampanhaPergunta {
  id         String   @id @default(cuid())
  campanhaId String
  campanha   Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  ordem      Int
  texto      String

  @@index([campanhaId, ordem])
}

model CampanhaDocumento {
  id          String   @id @default(cuid())
  campanhaId  String
  campanha    Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  ordem       Int
  nome        String // o nome que o leigo entende, não o jurídico
  paraQue     String? // para que serve — pedir sem explicar parece burocracia
  // SEM ESTE, O LEAD NÃO AVANÇA. Tem 48h para mandar; passado o prazo, vai para o formulário.
  obrigatorio Boolean  @default(false)

  @@index([campanhaId, ordem])
}

// ============================================================================
// MÓDULO PAGO DE CAMPANHAS — Frente A (dados + regras puras) da especificação fechada com o
// dono (entrevista /grill-me). UI, cobrança via Asaas, webhook de pagamento e alerta de memória
// da VPS do Hermes são frentes separadas; aqui só entra o que se prova sem tela e sem rede.
//
// O DESENHO EM TRÊS MODELS, e por que não é um só:
//   AssinaturaModuloCampanhas — a assinatura em si (1 por escritório): destrava o módulo.
//   PerfilCampanhaHermes      — o perfil PRÓPRIO do Hermes que a assinatura destrava, treinável
//                               pelo escritório e reaproveitado entre campanhas (não é 1 por
//                               campanha — por isso não pendura em Campanha, e sim em
//                               AssinaturaModuloCampanhas).
//   CampanhaSlotPago          — o direito de ter MAIS DE UMA campanha ativa ao mesmo tempo: só
//                               existe a partir da 2ª campanha simultânea, e uma linha por
//                               campanha que precisou dele (a 1ª não precisa, é de graça dentro
//                               da mensalidade — ver comentário em Campanha.slotPago acima).
// As regras de estado, carência e preço vivem em lib/moduloCampanhas.ts, PURAS (sem Prisma) — os
// campos abaixo são só onde o resultado delas é lido e gravado.
// ============================================================================

model AssinaturaModuloCampanhas {
  id       String @id @default(cuid())
  officeId String @unique // um módulo por escritório — não existe "duas assinaturas" concorrentes
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  // ATIVO | CARENCIA | DESATIVADO — texto livre, como o resto do schema (nunca enum de banco,
  // pelo mesmo motivo de sempre: `db push` sem gerar migration). Este campo é o ÚLTIMO valor
  // GRAVADO por quem processa a cobrança (frente C/D, ao confirmar pagamento ou rodar a rotina
  // diária de carência) — a fonte da verdade de "está em dia ou não" é sempre RECALCULADA a
  // partir de `vencimento` por lib/moduloCampanhas.ts, que nunca deixa um texto desconhecido
  // virar "ativo" (fail-closed: vira "desativado", o estado mais seguro para quem cobra e para
  // quem seria alvo de mensagem de campanha).
  estado String @default("ATIVO")

  iniciadoEm DateTime @default(now()) // quando o escritório assinou o módulo

  // Próximo vencimento da MENSALIDADE do módulo — não confundir com o vencimento de um slot
  // extra, que é por campanha (ver CampanhaSlotPago.entradaEmCarenciaEm). A cada pagamento
  // confirmado, quem processa o webhook empurra este campo um ciclo à frente.
  vencimento DateTime

  // Escolhida pelo escritório no pop-up de solicitação, ANTES da aprovação (§6.2 da
  // especificação): BOLETO | PIX_QRCODE | PIX_AUTOMATICO — mesmo vocabulário de
  // Subscription.paymentMethod, mas um campo à parte porque o escritório pode escolher uma
  // forma diferente para o módulo de campanhas da que já usa na assinatura base do Lúmen.
  formaDePagamento String?

  // Preenchida no instante em que `vencimento` foi ultrapassado sem pagamento confirmado — é o
  // relógio de onde os 10 DIAS CORRIDOS de carência (§7) começam a contar. Nula enquanto em dia;
  // volta a nula assim que o pagamento é confirmado, para o PRÓXIMO atraso (se houver) contar do
  // zero — carência não acumula de um ciclo para o outro.
  entradaEmCarenciaEm DateTime?

  // FRENTE B — RÉGUA DE CARÊNCIA (§7). O dia de calendário (fuso do escritório, formato
  // "AAAA-MM-DD" de lib/horaDeBrasilia.ts:diaDeBrasilia) em que o último aviso diário automático
  // (e-mail + WhatsApp + notificação interna + reenvio do boleto) foi disparado para ESTA
  // assinatura. Guarda "um aviso por dia, não um por execução do cron": rodar a régua duas vezes
  // no mesmo dia lê o mesmo valor aqui e não dispara de novo (ver
  // lib/campanhasCobranca.ts:deveEnviarAvisoHoje). Nulo enquanto em dia (nada a avisar) e volta a
  // nulo quando o pagamento é confirmado, pelo mesmo motivo de entradaEmCarenciaEm — o PRÓXIMO
  // atraso conta do zero.
  ultimoAvisoDiarioEm String?

  // Referência da cobrança em aberto do CICLO ATUAL da mensalidade na Asaas — o que a régua
  // diária REENVIA (a régua nunca gera uma cobrança nova por dia; a Asaas tem uma só por ciclo,
  // criada em lib/actions/campanhasCobranca.ts:gerarCobrancaMensalidade). Nulos até a primeira
  // cobrança do ciclo ser criada; voltam a nulo a cada novo ciclo, para o próximo reenvio apontar
  // para a cobrança certa, não para a do mês passado.
  cobrancaAsaasId    String?
  cobrancaBoletoUrl  String?
  cobrancaPixPayload String? // "copia e cola" do Pix QR Code dinâmico do ciclo atual, se a forma escolhida for PIX_QRCODE

  perfil PerfilCampanhaHermes?
  slots  CampanhaSlotPago[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PerfilCampanhaHermes {
  id String @id @default(cuid())

  assinaturaId String                    @unique // 1 perfil por assinatura — não é 1 por campanha (§1)
  assinatura   AssinaturaModuloCampanhas @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  // O nome do perfil no Hermes (ver lib/hermesPonte.ts para a convenção de nomes hoje em vigor —
  // "um perfil por escritório" é o desenho final, e é para lá que este slug aponta assim que a
  // frente de provisionamento existir). Nulo até `provisionarNoHermes` confirmar, porque o slug
  // só existe depois de provisionado — não adivinhamos um valor antes disso.
  slug String? @unique

  // O treinamento em si: a MESMA tela/campo de instruções que o escritório já usa hoje (§5),
  // aplicado a este perfil — não é uma tela nova. NUNCA é apagado ao desativar: é assim que "§7 —
  // desativar não apaga o treinamento" fica estruturalmente impossível de violar por acidente.
  // Não existe, neste schema, nenhum campo de "instruções ao desativar" que sobrescreva este —
  // a única ação disponível é trocar `estado`, e lib/moduloCampanhas.ts nunca lê este campo para
  // decidir se o perfil responde ou não.
  instrucoes String @default("")

  // PROVISIONADO | DESATIVADO — os dois únicos estados do perfil em si (§1). Fail-closed na
  // leitura, como o estado da assinatura acima: lib/moduloCampanhas.ts nunca trata um valor
  // desconhecido como perfil no ar. DESATIVADO não é "nunca provisionado" — é "chegou a
  // responder, a carência esgotou, e o `instrucoes` acima continua intacto para reativar quando
  // o escritório voltar a pagar" (§7).
  estado String @default("DESATIVADO")

  provisionadoEm DateTime? // quando `provisionarNoHermes` confirmou o perfil no ar
  desativadoEm   DateTime? // quando a carência esgotou e o perfil parou de responder (§7)

  // FRENTE B — REATIVAÇÃO APÓS DESATIVAÇÃO. Verdadeiro quando o escritório pagou DEPOIS de
  // esgotada a carência (perfil já DESATIVADO): a assinatura volta a `estado: "ATIVO"`, mas o
  // perfil PERMANECE `DESATIVADO` aqui — reprovisionar de verdade no Hermes é a Frente C, e
  // marcar `estado: "PROVISIONADO"` sem o perfil estar de fato no ar mentiria para
  // perfilPodeResponder (lib/moduloCampanhas.ts), que passaria a liberar mensagem para um perfil
  // que não existe na VPS. Este campo é só o REGISTRO de "precisa subir de novo" que a Frente C
  // consome e desliga ao confirmar o reprovisionamento; pagar DURANTE a carência (perfil nunca
  // chegou a ser desativado) nunca liga este campo.
  precisaReprovisionar Boolean @default(false)

  // ============================================================================
  // FRENTE C — O PROVISIONAMENTO EM SI (§3). `precisaReprovisionar` acima é só a INTENÇÃO,
  // gravada pelo caminho de pagamento (Frente B); os campos abaixo são o que o caminho de
  // NOVA TENTATIVA (lib/actions/provisionamentoCampanhas.ts, chamado pelo cron
  // app/api/cron/campanhas-provisionamento) grava a cada rodada — nunca um silêncio que pareça
  // sucesso. Ver a nota técnica que desenhou isto: `provisionarNoHermes` é uma chamada HTTP de
  // até 120s, sem fila e sem estado intermediário própria — o estado intermediário É este aqui.
  // ============================================================================

  // O instante em que `precisaReprovisionar` virou true (pagamento confirmado, aguardando subir
  // no Hermes) — a PRIMEIRA das duas datas que tornam o SLA de provisionamento MEDÍVEL (a segunda
  // é `provisionadoEm`, acima). Gravado por lib/actions/campanhasCobranca.ts:
  // confirmarPagamentoMensalidade, junto com `precisaReprovisionar: true` (mesmo instante, mesma
  // escrita — não é uma segunda régua). Nulo enquanto não há nada pendente; volta a nulo SÓ
  // quando o provisionamento é confirmado (o intervalo já foi medido nesse momento) — continua
  // preenchido mesmo depois de `provisionamentoFalhouDefinitivamente` virar true, porque a espera
  // real do escritório não parou só porque a régua automática desistiu de tentar sozinha.
  aguardandoProvisionamentoDesde DateTime?

  // Quantas tentativas JÁ RODARAM neste ciclo (reinicia para 0 a cada novo
  // `precisaReprovisionar: true`) — o número que decide quando parar (ver
  // LIMITE_DE_TENTATIVAS_DE_PROVISIONAMENTO em lib/provisionamentoCampanhas.ts).
  numeroDeTentativasDeProvisionamento Int @default(0)

  ultimaTentativaDeProvisionamentoEm DateTime?
  // O motivo LEGÍVEL da última falha (FalhaDoHermes.motivo, incluindo o prefixo "DEMORA:" quando
  // for o caso) — para a tela (Frente D) mostrar "falhou, tentando de novo: <motivo>" em vez de
  // um silêncio. Limpo (null) assim que uma tentativa tem sucesso.
  ultimoErroDeProvisionamento        String?

  // Verdadeiro depois que o número de tentativas acima esgotou
  // LIMITE_DE_TENTATIVAS_DE_PROVISIONAMENTO — é o que faz a régua PARAR de tentar (nunca em
  // loop eterno) e é o que já disparou o e-mail para Jairo e Rodrigo. `precisaReprovisionar`
  // continua true (o perfil ainda não subiu), mas este campo é o sinal de "já desistiu sozinho,
  // só um novo pagamento confirmado (que zera os dois campos acima) reabre a tentativa".
  provisionamentoFalhouDefinitivamente Boolean @default(false)

  // O registro de CADA tentativa (quando, resultado, motivo da falha) — nunca sobrescrito, ao
  // contrário dos campos "última tentativa" acima (que são só o resumo mais rápido de ler).
  tentativasDeProvisionamento PerfilCampanhaProvisionamentoTentativa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Uma linha por TENTATIVA de provisionamento (§3, Frente C) — o "cada tentativa grava o que
// aconteceu" da nota técnica. Nunca apagada nem sobrescrita: é o histórico completo, para quando
// alguém precisar entender por que um perfil demorou para subir (ou nunca subiu). O resumo mais
// rápido de ler (a última tentativa, o motivo, se já falhou definitivamente) fica em
// PerfilCampanhaHermes mesmo, para a tela não precisar agregar esta tabela toda vez.
model PerfilCampanhaProvisionamentoTentativa {
  id String @id @default(cuid())

  perfilId String
  perfil   PerfilCampanhaHermes @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  // A posição desta tentativa DENTRO DO CICLO ATUAL (1ª, 2ª, 3ª...) — espelha
  // PerfilCampanhaHermes.numeroDeTentativasDeProvisionamento no momento em que rodou; reinicia a
  // cada novo ciclo de `precisaReprovisionar`, não é um contador global do perfil.
  numero Int

  // SUCESSO | FALHA — fail-closed na leitura, como o resto do schema: um texto desconhecido
  // nunca deveria aparecer aqui (só estas duas strings são gravadas), mas quem ler não deve
  // supor sucesso por omissão.
  resultado String

  // Preenchido só quando resultado = FALHA — o `FalhaDoHermes.motivo` de lib/hermesPonte.ts, que
  // já distingue DEMORA (o Hermes não respondeu a tempo) de queda de verdade. Nulo em SUCESSO.
  motivo String?

  ocorridaEm DateTime @default(now())

  @@index([perfilId, ocorridaEm])
}

model CampanhaSlotPago {
  id String @id @default(cuid())

  // Denormalizado de propósito (a assinatura e a campanha já levam até o escritório) — mesmo
  // padrão de AccessRequest.officeId: é o painel mestre listando/filtrando slots POR
  // ESCRITÓRIO que precisa disto direto, sem atravessar duas relações a cada consulta.
  officeId String
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  assinaturaId String
  assinatura   AssinaturaModuloCampanhas @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  // A campanha que ocupa este slot. Único porque uma campanha ocupa NO MÁXIMO um slot pago —
  // nunca existiu campanha "básica" para migrar (§8), então toda Campanha de um escritório com
  // módulo pago que não seja a 1ª ativa no momento passa por aqui.
  campanhaId String   @unique
  campanha   Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  // SOLICITADO → APROVADO → ATIVO → FINALIZADO (§6), mais RECUSADO — a especificação não
  // descreve recusa, mas o painel mestre precisa poder negar um pedido sem apagar o registro
  // dele. Fail-closed: lib/moduloCampanhas.ts nunca conta um estado desconhecido como slot
  // ativo ao calcular quantas campanhas simultâneas pagas existem agora.
  estado String @default("SOLICITADO")

  // Escolhida no mesmo pop-up de solicitação (§6.2), ANTES da aprovação — pode ser diferente da
  // forma de pagamento da mensalidade do módulo (mesma razão de
  // AssinaturaModuloCampanhas.formaDePagamento).
  formaDePagamento String?

  solicitadoEm DateTime @default(now())

  // Quem aprovou e quando (§6.3-6.4). QUALQUER PlatformMember com login no painel mestre serve —
  // a especificação é explícita em NÃO implementar permissão granular agora ("login no painel
  // mestre já é suficiente"; PlatformRole.canManageBilling e afins não são checados aqui). Este
  // par é só o REGISTRO de quem clicou, nunca um portão de autorização por papel.
  aprovadoPorId String?
  aprovadoPor   PlatformMember? @relation(fields: [aprovadoPorId], references: [id])
  aprovadoEm    DateTime?

  ativadoEm    DateTime? // início da cobrança recorrente mensal deste slot (§6.5)
  finalizadoEm DateTime? // a cobrança do slot para aqui (§2) — e a numeração relativa (§6.1)
  // deixa de contar este slot como ativo a partir deste instante, sem precisar apagar a linha

  // FRENTE B — LACUNA DE SCHEMA DA FRENTE A, PREENCHIDA AQUI. lib/moduloCampanhas.ts trata a
  // carência do módulo e a do slot como "a mesma função, dois relógios diferentes" (ver o teste
  // de mesmo nome em lib/testes/moduloCampanhas.teste.ts) — mas só AssinaturaModuloCampanhas
  // tinha um `vencimento` para alimentar esse relógio; o slot só tinha `entradaEmCarenciaEm`
  // (quando a carência dele COMEÇOU), sem nenhum campo do PRÓXIMO vencimento para calcular se
  // ela já deveria ter começado. Sem este campo, a régua diária (lib/campanhasCobranca.ts) não
  // tem como saber quando a cobrança mensal do slot venceu — nasce nulo até `ativadoEm` (a
  // aprovação cria a primeira cobrança e preenche o primeiro vencimento) e cada pagamento
  // confirmado empurra este campo um ciclo à frente, exatamente como
  // AssinaturaModuloCampanhas.vencimento.
  vencimento DateTime?

  // Mesma carência de 10 dias corridos do módulo base (§7), mas com relógio PRÓPRIO: um slot
  // pode ficar inadimplente enquanto a mensalidade do módulo está em dia, e vice-versa — as duas
  // cobranças são independentes (§6.6 remete à mesma REGRA, não ao mesmo relógio).
  entradaEmCarenciaEm DateTime?

  // Mesmo par de campos de AssinaturaModuloCampanhas, um nível abaixo (por slot): guarda o dia
  // do último aviso diário (evita reenviar duas vezes no mesmo dia) e a referência da cobrança
  // do ciclo atual na Asaas, para a régua reenviar em vez de gerar cobrança nova.
  ultimoAvisoDiarioEm String?
  cobrancaAsaasId     String?
  cobrancaBoletoUrl   String?
  cobrancaPixPayload  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId, estado])
}

// Preço configurável do módulo pago de campanhas — MESMO padrão de ModulePrice acima (uma linha
// por parâmetro, `preco` nasce nulo). A especificação marca os dois valores como EM ABERTO (§2):
// NENHUM R$ é inventado aqui — o painel mestre preenche depois, e lib/moduloCampanhas.ts trata
// preço nulo como uma OMISSÃO EXPLÍCITA para quem pergunta (nunca R$ 0,00, que mentiria para o
// cliente sobre o módulo ser de graça).
model CampanhaPrecoParametro {
  chave     String   @id // MENSALIDADE_MODULO | SLOT_EXTRA
  label     String // rótulo que a tela do painel mestre mostra ao lado do campo
  preco     Float?
  updatedAt DateTime @updatedAt
}

// ============================================================================
// ALERTA DE MEMÓRIA DA VPS DO HERMES (§4 da especificação de campanhas — Frente C). MESMO
// padrão de CampanhaPrecoParametro acima: uma linha só, chave fixa (funciona como singleton sem
// inventar uma segunda convenção de "linha única" no schema), e o número nasce NULO.
//
// A especificação marca o limiar como EM ABERTO — "valor numérico exato... não foi decidido". O
// dono NÃO decidiu o número, e nulo aqui significa literalmente isso: o alerta fica DESLIGADO até
// alguém preencher, nunca um "padrão razoável" inventado que pareceria uma decisão de negócio que
// ninguém tomou (ver lib/alertaMemoriaHermes.ts:situacaoDeMemoria, que trata limiar nulo como
// `dispara: false` sempre, com motivo legível).
// ============================================================================
model AlertaMemoriaHermesParametro {
  chave String @id @default("LIMIAR_MEMORIA_LIVRE_KB")

  // RAM disponível + swap livre da MÁQUINA (não de um perfil — ver
  // lib/hermesPonte.ts:memoriaDaMaquina), somadas, em KB. Abaixo (ou igual) disto dispara o
  // alerta. NÍVEL ÚNICO — a especificação é explícita: não existem dois patamares de "atenção" e
  // "crítico", só ligado/desligado.
  limiarKB Int?

  // Mesmo padrão de AssinaturaModuloCampanhas.ultimoAvisoDiarioEm: o dia de calendário (fuso do
  // escritório, formato "AAAA-MM-DD") do último alerta disparado — "um alerta por dia, não um
  // por execução do cron" (ver lib/campanhasCobranca.ts:deveEnviarAvisoHoje, reaproveitada por
  // lib/alertaMemoriaHermes.ts:deveAlertarMemoriaHoje).
  ultimoAlertaDiarioEm String?

  updatedAt DateTime @updatedAt
}

model WhatsappConfig {
  id String @id @default(cuid())

  // A CHAVE QUE LIGA UMA MENSAGEM AO ESCRITÓRIO. Na Cloud API da Meta é o phone_number_id; na
  // Evolution é o NOME DA INSTÂNCIA. O nome do campo ficou o da Meta porque mudá-lo renomearia a
  // coluna em produção sem necessidade — o que ele guarda é "o identificador do número naquele
  // provedor", e é assim que resolveOfficeIdByPhoneNumberId o usa nos dois casos.
  phoneNumberId String  @unique
  accessToken   String
  displayPhone  String? // só para exibição em Configurações (ex: "+55 62 99999-0000")

  // META = Cloud API oficial. EVOLUTION = Evolution API (WhatsApp Web), auto-hospedada.
  // O padrão é META para não mudar o comportamento de nenhuma configuração já existente.
  provider String @default("META")

  // Só para EVOLUTION: onde a instância vive, a chave da API e o segredo que ELA devolve no
  // cabeçalho do webhook. Sem o segredo o webhook recusa tudo — mesma regra fail-closed do
  // WHATSAPP_APP_SECRET da Meta: uma porta de entrada sem prova de origem é um jeito de injetar
  // lead falso no CRM de um escritório.
  baseUrl       String?
  apiKey        String?
  webhookSecret String?

  // ── O AGENTE NO WHATSAPP ────────────────────────────────────────────────────────────────
  // Desligado por padrão, e é de propósito: ligar isto faz o escritório responder cliente
  // sozinho, e mensagem enviada não volta. Quem liga é gente, com um clique consciente.
  agenteAtivo Boolean @default(false)

  // `agenteTodos = false` + lista vazia = não responde a ninguém. Também de propósito: o estado
  // inseguro ("responde todo mundo") nunca é o padrão nem o resultado de um campo esquecido.
  agenteTodos   Boolean @default(false)
  agenteNumeros String  @default("") // E.164 separados por vírgula

  // COMO O ATENDENTE SE CHAMA para o cliente do escritório. Cada escritório dá o seu: atender
  // como "Lúmen" entregaria que há um sistema de terceiro no meio da conversa, e o cliente está
  // falando com o escritório, não com o nosso produto.
  agenteNome String?

  // O treinamento de nicho DESTE escritório (direito médico, previdenciário, trabalhista…).
  // Mora aqui, e não no perfil do Hermes na máquina, para o escritório treinar o próprio agente
  // pela tela — é o que torna o módulo vendável sem alguém entrar por SSH a cada cliente novo.
  agenteInstrucoes String?

  // O EXPEDIENTE. O relógio de 15 minutos da transferência só corre dentro dele — sem isso, um
  // lead que escreve à meia-noite faz a fila inteira rodar antes de alguém acordar, e a pendência
  // que deveria chamar atenção chega já velha.
  // Dias: "1,2,3,4,5" (1 = segunda). Horas em "HH:MM". Enquanto o escritório não preencher, vale
  // o padrão seg–sex 8h–18h, que é o que a maioria pratica.
  expedienteDias   String @default("1,2,3,4,5")
  expedienteInicio String @default("08:00")
  expedienteFim    String @default("18:00")

  // O FUSO, e ele não é detalhe. O servidor roda em UTC; "08:00" sem fuso são 05:00 em Goiânia.
  // Sem isto, o relógio da transferência correria de madrugada e ficaria parado de dia — e o
  // sintoma ("o lead da manhã não foi repassado") não apontaria para cá de jeito nenhum.
  // O Brasil tem quatro fusos, então o padrão é o de Brasília e cada escritório ajusta o seu.
  fusoHorario String @default("America/Sao_Paulo")

  // ONDE A FILA PAROU. Rodízio precisa lembrar de quem foi o último; sem isto, toda transferência
  // voltaria ao primeiro da lista e o rodízio viraria cascata.
  ultimoAdvogadoId String?
  ultimaRecepcaoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  officeId String @unique
  office   Office @relation(fields: [officeId], references: [id])
}

// ============ FINANCEIRO ============

model FinancialCategory {
  id        String   @id @default(cuid())
  code      String // ex: "1.1", "2.1.1.1" - ordena e mostra a hierarquia (plano de contas)
  name      String
  kind      String // RECEITA | DESPESA
  order     Int      @default(0)
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  parentId String?
  parent   FinancialCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children FinancialCategory[] @relation("CategoryTree")

  payables             Payable[]
  receivables          Receivable[]
  honorarioLancamentos HonorarioLancamento[]

  @@index([officeId])
}

model CostCenter {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  payables             Payable[]
  receivables          Receivable[]
  honorarioLancamentos HonorarioLancamento[]

  @@index([officeId])
}

model Payable {
  id                   String    @id @default(cuid())
  description          String
  supplier             String?
  amount               Float
  dueDate              DateTime
  paidDate             DateTime?
  paidAmount           Float?
  // PENDENTE (nada pago) | PAGO (baixado integralmente, fluxo antigo de uma tacada só) |
  // ATRASADO (calculado por effective() em lib/financeQuery.ts, nunca gravado direto) |
  // CANCELADO | PARCIAL (Fase 1 — algum FinancePayment já lançado, mas a soma ainda não cobre o
  // valor líquido; ver lib/financeCalc.ts:statusPorPagamentos) — "A_APURAR" não se aplica a
  // Payable (não existe conta a pagar de valor desconhecido; só Receivable percentual apura
  // depois), mantido de fora de propósito.
  status               String    @default("PENDENTE")
  notes                String?
  noDueDate            Boolean   @default(false) // parcela sem vencimento definido — aparece na Central de Alertas
  groupId              String? // agrupa parcelas geradas juntas
  installmentNumber    Int?
  installmentTotal     Int?
  paymentReceiptNumber String? // nº do comprovante de pagamento; pode ser o mesmo em várias contas quitadas na mesma transferência
  paymentMethod        String? // DEBITO | CREDITO | PIX | TRANSFERENCIA | BOLETO | OUTROS
  createdAt            DateTime  @default(now())

  // ---- Fase 1 (fundação de dados, ainda dormente) — mesmos campos espelhados em Receivable,
  // para as duas telas (Contas a Pagar/Contas a Receber) ficarem idênticas em estrutura. ----
  documentType      String? // BOLETO | CONTRATO | FATURA | FOLHA_PAGAMENTO | NOTA_FISCAL | ORDEM_SERVICO | RECIBO | OUTROS
  documentNumber    String?
  issueDate         DateTime? // data de emissão do documento (distinta de dueDate/createdAt)
  discount          Float     @default(0) // desconto aplicado — ver lib/financeCalc.ts:valorLiquido
  surcharge         Float     @default(0) // acréscimo (juros/multa) — ver lib/financeCalc.ts:valorLiquido
  installmentBoleto String? // nº do boleto desta parcela específica (distinto de paymentReceiptNumber, que é do comprovante de pagamento)

  // Natureza da despesa do PROCESSO ("Despesas do Processo", Fase 10) — só faz sentido quando
  // caseId está preenchido; despesa geral do escritório (sem processo) fica com o default
  // "OUTROS" e nunca aparece na tela. String livre, sem enum, mesmo padrão de Receivable.kind —
  // catálogo de opções/rótulos centralizado em lib/despesaProcesso.ts:PAYABLE_KIND_OPTIONS (não
  // confundir com categoryId/FinancialCategory, que é o plano de contas — dimensão separada,
  // ver comentário em lib/despesaProcesso.ts).
  kind String @default("OUTROS")

  // "Quem arca com o custo" (Fase 10, pedido do usuário): ESCRITORIO (despesa própria do
  // escritório, comportamento de sempre — default, nada muda) | CLIENTE (o escritório está
  // ADIANTANDO um valor que é do cliente — ex.: custas, perícia, cópia — e vai cobrar de volta).
  // Quando CLIENTE, o formulário oferece criar automaticamente um Receivable de reembolso
  // vinculado (ver reimbursementReceivable abaixo e createPayable em lib/actions/financeiro.ts).
  expensePayer String @default("ESCRITORIO") // ESCRITORIO | CLIENTE

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  categoryId String?
  category   FinancialCategory? @relation(fields: [categoryId], references: [id])

  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  supplierId  String?
  supplierRef Supplier? @relation(fields: [supplierId], references: [id])

  // Pagamento a um MEMBRO DA EQUIPE (advogado contratado, estagiário, funcionário) em vez de a
  // um Fornecedor — mutuamente exclusivo com supplierId (a Server Action garante isso, não o
  // schema). Existe porque cadastrar colega/estagiário como "Fornecedor" misturaria folha de
  // pagamento com gasto de terceiro na mesma lista, e o usuário não deveria precisar de um
  // cadastro extra para pagar alguém que já é User do próprio escritório. `supplier` (acima)
  // continua sendo o nome de exibição/busca nos dois casos — populado com Supplier.name OU
  // User.name conforme qual dos dois foi escolhido (ver createPayable/updatePayable).
  payeeUserId String?
  payeeUser   User?   @relation("PayablePayee", fields: [payeeUserId], references: [id])

  // Pagamento a um CLIENTE (repasse de valor de condenação, devolução de adiantamento etc.) em
  // vez de a um Fornecedor ou membro da equipe — mutuamente exclusivo com supplierId/payeeUserId
  // (a Server Action garante isso, não o schema; mesma regra de payeeUserId acima). Distinto de
  // expensePayer/reimbursementReceivable (isso é "quem ARCA com o custo"; payeeClientId é só
  // "para quem o dinheiro vai") — os dois podem coexistir sem relação nenhuma entre si.
  payeeClientId String?
  payeeClient   Client? @relation("PayablePayeeClient", fields: [payeeClientId], references: [id])

  // Quem lançou esta conta — só para exibição ("lançado por"), não afeta quem enxerga
  // (isso é por officeId, como sempre).
  responsibleId String?
  responsible   User?   @relation("PayableResponsible", fields: [responsibleId], references: [id])

  // Histórico de pagamentos desta conta (ver model FinancePayment mais abaixo) — permite
  // pagamento PARCIAL: a soma de payments decide entre PENDENTE/PARCIAL/PAGO.
  payments FinancePayment[]

  // Lembrete de vencimento (Task type=PRAZO) criado junto com a conta em createInstallmentReminder
  // (lib/actions/financeiro.ts) — onDelete: Cascade no lado de Task porque o lembrete não faz
  // sentido sem a parcela (achado A26 da revisão gauntlet).
  reminderTasks Task[]

  // Presente só quando esta despesa foi adiantada pelo escritório em nome do cliente
  // (expensePayer = CLIENTE) e o usuário pediu para criar a conta a receber de reembolso —
  // ver Receivable.reimbursesPayableId/kind "REEMBOLSO". Rastreável nos dois sentidos: olhando
  // a despesa dá pra ver se já existe reembolso vinculado (nunca duplicar por engano).
  reimbursementReceivable Receivable? @relation("PayableReimbursement")

  // Comprovante de pagamento — UM arquivo por conta (não uma lista como Attachment), catalogado
  // como "AAAA-MM-DD-fornecedor-descricao" em "Lúmen - Financeiro - Despesas" (ver
  // lib/financeReceiptNaming.ts). receiptFileName guarda o nome que o arquivo tem HOJE no Drive
  // — sem ele, saber se uma edição precisa renomear (mudou descrição/fornecedor/data de
  // pagamento) exigiria recalcular e comparar com o nome real no provedor a cada save.
  receiptDriveUrl        String?
  receiptStorageProvider String?
  receiptStorageFileId   String?
  receiptFileName        String?

  // Preenchidos só quando esta linha foi gerada por um RecurringExpense ("despesa recorrente,
  // sem data de fim") — mesmo desenho de Receivable.recurringFeeId/competencia (ver comentário
  // lá e ensureRecurringExpensePayables em lib/actions/financeiro.ts), do lado das Despesas.
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  competencia        String?

  @@unique([recurringExpenseId, competencia])
  @@index([officeId])
  @@index([officeId, dueDate])
  // Cobre o filtro do Livro Caixa/DRE (lib/caixaMovimentos.ts): "PAGO" + janela de paidDate por
  // escritório — sem isto, a query resolve lendo toda a tabela do escritório (achado A68 da
  // revisão gauntlet).
  @@index([officeId, status, paidDate])
}

model Receivable {
  id                   String    @id @default(cuid())
  description          String
  amount               Float
  dueDate              DateTime
  paidDate             DateTime?
  paidAmount           Float?
  // PENDENTE (nada pago) | PAGO (baixado integralmente, fluxo antigo de uma tacada só) |
  // ATRASADO (calculado por effective() em lib/financeQuery.ts, nunca gravado direto) |
  // CANCELADO | PARCIAL (Fase 1 — algum FinancePayment já lançado, mas a soma ainda não cobre o
  // valor líquido; ver lib/financeCalc.ts:statusPorPagamentos) | A_APURAR (Fase 1 — parcela
  // PERCENTUAL cujo valor real só será conhecido no desfecho do processo; amount aqui é só a
  // ESTIMATIVA, nunca soma como receita prevista de verdade — ver lib/financeQuery.ts e todo
  // ponto que soma "a receber", que precisam ignorar este status).
  status               String    @default("PENDENTE")
  // HONORARIOS_CONTRATUAIS | HONORARIOS_SUCUMBENCIAIS | HONORARIOS_ACORDO (Fase 9 — natureza
  // "Acordo", ver lib/honorarioLancamento.ts:NATUREZA_LABELS; não confundir com a base de
  // cálculo percentual "ACORDO" de PERCENTUAL_BASE_LABELS, conceito totalmente diferente) |
  // REEMBOLSO | OUTROS — string livre, sem enum; catálogo de opções/rótulos centralizado em
  // lib/honorarioLancamento.ts:RECEIVABLE_KIND_OPTIONS.
  kind                 String    @default("HONORARIOS_CONTRATUAIS")
  notes                String?
  noDueDate            Boolean   @default(false)
  groupId              String?
  installmentNumber    Int?
  installmentTotal     Int?
  isSuccessPortion     Boolean   @default(false) // parcela "a receber no êxito"
  paymentReceiptNumber String? // nº do comprovante de pagamento; pode ser o mesmo em várias contas quitadas na mesma transferência
  paymentMethod        String? // DEBITO | CREDITO | PIX | TRANSFERENCIA | BOLETO | OUTROS
  createdAt            DateTime  @default(now())

  // Lançamento de honorário em dinheiro (FIXO, o padrão — amount é o valor real) ou em
  // PERCENTUAL sobre uma base do processo (percentualBase). Numa parcela PERCENTUAL, amount
  // guarda a ESTIMATIVA calculada (percentual × valor da base no momento em que a parcela foi
  // criada/editada) — só para exibição e soma na lista; o valor real recebido continua sendo
  // paidAmount, preenchido à mão na baixa (ver markReceivablePaid), já que a base do processo
  // pode mudar ou só ser conhecida de fato no desfecho do caso.
  valueType      String  @default("FIXO") // FIXO | PERCENTUAL
  percentual     Float?
  percentualBase String? // VALOR_CAUSA | PROVEITO_ECONOMICO | CONDENACAO | ACORDO — ver Case.caseValue/economicBenefitValue/convictionValue/agreementValue

  // Se esta parcela conta na soma comparada com HonorarioLancamento.valorTotalIndicado (nota de
  // divergência). Ex.: honorário de 5.000 em 2 parcelas — "5.000 de entrada" vinculado (soma
  // bate com o total) e "10% do êxito" desvinculado (percentual à parte, fora do total
  // indicado). Irrelevante (mas mantido true) fora de um HonorarioLancamento.
  vinculadoAoTotal Boolean @default(true)

  // ---- Fase 1 (fundação de dados, ainda dormente) — mesmos campos espelhados em Payable, para
  // as duas telas (Contas a Pagar/Contas a Receber) ficarem idênticas em estrutura. ----
  documentType      String? // BOLETO | CONTRATO | FATURA | FOLHA_PAGAMENTO | NOTA_FISCAL | ORDEM_SERVICO | RECIBO | OUTROS
  documentNumber    String?
  issueDate         DateTime? // data de emissão do documento (distinta de dueDate/createdAt)
  discount          Float     @default(0) // desconto aplicado — ver lib/financeCalc.ts:valorLiquido
  surcharge         Float     @default(0) // acréscimo (juros/multa) — ver lib/financeCalc.ts:valorLiquido
  installmentBoleto String? // nº do boleto desta parcela específica (distinto de paymentReceiptNumber, que é do comprovante de pagamento)

  // Só em Receivable: honorário tem pagador que pode não ser o próprio cliente (ex.: parte
  // adversa condenada em sucumbência, ou terceiro pagando por conta do cliente).
  payerType String  @default("CLIENTE") // CLIENTE | ADVERSA | OUTRO
  payerName String? // preenchido quando payerType é ADVERSA ou OUTRO

  // Quando true numa parcela PERCENTUAL, o valor apurado no desfecho (ver
  // lib/financeCalc.ts:valorPercentualApurado) desconta o que já foi pago em dinheiro no mesmo
  // HonorarioLancamento — reproduz a cláusula do contrato ENTRADA_EXITO gerado em
  // lib/honorarios.ts ("com abatimento do valor já pago a título de entrada"), que o financeiro
  // ainda não aplicava.
  abaterEntrada Boolean @default(false)

  // Preenchidos quando uma parcela PERCENTUAL (A_APURAR) vira valor real conhecido — quem apurou
  // e quando, para auditoria. Nulos enquanto a provisão continua em aberto.
  apuradoEm    DateTime?
  apuradoPorId String?
  apuradoPor   User?     @relation("ReceivableApuradoPor", fields: [apuradoPorId], references: [id])

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  categoryId String?
  category   FinancialCategory? @relation(fields: [categoryId], references: [id])

  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  // Quem lançou esta conta — só para exibição ("lançado por"), não afeta quem enxerga.
  responsibleId String?
  responsible   User?   @relation("ReceivableResponsible", fields: [responsibleId], references: [id])

  // Histórico de pagamentos desta conta (ver model FinancePayment mais abaixo) — permite
  // recebimento PARCIAL: a soma de payments decide entre PENDENTE/PARCIAL/PAGO.
  payments FinancePayment[]

  // Lembrete de vencimento (Task type=PRAZO) criado junto com a conta em createInstallmentReminder
  // (lib/actions/financeiro.ts) — onDelete: Cascade no lado de Task porque o lembrete não faz
  // sentido sem a parcela (achado A26 da revisão gauntlet).
  reminderTasks Task[]

  honorario Honorario?

  // Presente só quando esta parcela nasceu de um lançamento de honorários parcelado (ver model
  // HonorarioLancamento acima) — nulo para toda Receivable "solta" (única, recorrente até o
  // arquivamento, ou lançada fora da aba Financeiro do Processo).
  honorarioLancamentoId String?
  honorarioLancamento   HonorarioLancamento? @relation(fields: [honorarioLancamentoId], references: [id], onDelete: Cascade)

  // Preenchidos só quando esta linha foi gerada por um RecurringFee ("honorário até o
  // arquivamento") — competencia ("YYYY-MM") + a constraint única abaixo garantem que o cron
  // (ensureRecurringFeeReceivables, lib/actions/financeiro.ts) nunca gera duas linhas pro mesmo
  // mês, mesmo rodando todo dia. NULL não colide com NULL num índice único do Postgres, então
  // isso não afeta em nada as linhas normais (sem recurringFeeId).
  recurringFeeId String?
  recurringFee   RecurringFee? @relation(fields: [recurringFeeId], references: [id])
  competencia    String?

  // Presente só quando esta Receivable NASCEU como o reembolso de uma Payable adiantada pelo
  // escritório em nome do cliente (Payable.expensePayer = CLIENTE, checkbox "Criar conta a
  // receber vinculada" marcado — ver createPayable, lib/actions/financeiro.ts). @unique garante
  // no banco que uma mesma despesa nunca gera dois reembolsos por engano; a relação nomeada dá
  // a via de volta (Payable.reimbursementReceivable) para quem olha a despesa saber, sem
  // precisar buscar, que já existe (ou não) um reembolso ligado a ela.
  reimbursesPayableId String?  @unique
  reimbursesPayable   Payable? @relation("PayableReimbursement", fields: [reimbursesPayableId], references: [id])

  // Comprovante de recebimento — mesmo desenho de Payable.receiptDriveUrl (ver comentário lá),
  // catalogado em "Lúmen - Financeiro - Receitas" em vez de "Despesas".
  receiptDriveUrl        String?
  receiptStorageProvider String?
  receiptStorageFileId   String?
  receiptFileName        String?

  @@unique([recurringFeeId, competencia])
  @@index([officeId])
  @@index([officeId, dueDate])
  // Mesmo motivo do índice equivalente em Payable — cobre o filtro "PAGO" + janela de paidDate
  // do Livro Caixa/DRE (achado A68 da revisão gauntlet).
  @@index([officeId, status, paidDate])
}

// Honorário "até o arquivamento": ao contrário do parcelamento comum (Receivable.installmentTotal,
// quantidade fixa definida na hora), aqui não se sabe de antemão quantas parcelas vão existir —
// ensureRecurringFeeReceivables gera as próximas alguns meses à frente (o bastante para cobrir a
// janela do Fluxo de Caixa) e para de gerar sozinho quando o Case vinculado é arquivado
// (active vira false). categoryId/costCenterId não têm relation formal aqui de propósito: são só
// copiados para cada Receivable gerado, que já valida a própria FK ao ser criado.
model RecurringFee {
  id           String   @id @default(cuid())
  description  String
  amount       Float
  dueDay       Int // dia do mês de vencimento (clampado 1-28, mesmo padrão do dueDay de Assessoria)
  kind         String   @default("HONORARIOS_CONTRATUAIS") // mesmo catálogo de Receivable.kind (ver comentário lá, inclui HONORARIOS_ACORDO desde a Fase 9)
  categoryId   String?
  costCenterId String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  receivables Receivable[]

  @@index([officeId])
  @@index([caseId])
}

// Despesa recorrente SEM DATA DE FIM (ex.: honorário de advogado contratado, salário de
// funcionário/estagiário, assinatura do Claude, Jusbrasil, T.I.) — mesmo mecanismo de
// materialização mês a mês de RecurringFee acima (ensureRecurringExpensePayables, lib/actions/
// financeiro.ts, cron próprio em app/api/cron/recurring-expenses/route.ts), mas do lado das
// Despesas e SEM vínculo a processo: ao contrário do honorário "até o arquivamento" (que existe
// só dentro de um Case e para sozinho quando ele é arquivado), esta é uma despesa do escritório
// como um todo, criada como um modo dentro de "Nova Conta a Pagar" (NewPayableModal) — projeta
// indefinidamente até o usuário encerrar manualmente (active vira false), nunca sozinha.
// supplierId/payeeUserId espelham os mesmos dois campos de Payable (ver comentário lá) — exatamente
// UM dos dois preenchido, nunca os dois, validado pela Server Action.
model RecurringExpense {
  id            String   @id @default(cuid())
  description   String
  amount        Float
  dueDay        Int // dia do mês de vencimento (clampado 1-28, mesmo padrão de RecurringFee.dueDay)
  categoryId    String?
  costCenterId  String?
  supplierId    String?
  payeeUserId   String?
  payeeClientId String? // mesma ideia de Payable.payeeClientId — sem @relation aqui, mesmo padrão de supplierId/payeeUserId acima
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // Opcional — quando preenchido, esta despesa recorrente aparece também na aba Honorários da
  // Assessoria (lado a lado com a receita de honorário mensal), para pagar mensalmente um
  // parceiro/repasse da assessoria. Sem vínculo (null), continua sendo uma despesa recorrente
  // solta do escritório como sempre foi (assinatura de software, funcionário etc.).
  assessoriaId String?
  assessoria   Assessoria? @relation(fields: [assessoriaId], references: [id])

  payables Payable[]

  @@index([officeId])
  @@index([assessoriaId])
}

// ============ FUNDAÇÃO DE DADOS — FINANCEIRO AVANÇADO (Fase 1, aditiva e dormente) ============
//
// Base para o honorário em dinheiro + percentual + parcelamento editável linha a linha + apuração
// do êxito no desfecho do processo. Nenhuma tela lê os três modelos abaixo ainda — só schema,
// helpers puros (lib/financeCalc.ts, lib/prazos.ts) e os ajustes de leitura em
// lib/financeQuery.ts para os status novos (PARCIAL/A_APURAR) não sumirem das abas existentes.

// Conta bancária do escritório — cadastro simples (Fase 3 monta a tela); aqui só o registro para
// FinancePayment.bankAccountId ter o que referenciar desde já.
model BankAccount {
  id             String   @id @default(cuid())
  name           String // apelido, ex. "Itaú Principal"
  bank           String?
  agency         String?
  accountNumber  String?
  type           String   @default("CORRENTE") // CORRENTE | POUPANCA | INVESTIMENTO
  initialBalance Float    @default(0)
  active         Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  payments FinancePayment[]

  @@index([officeId])
}

// Feriado LOCAL/personalizado cadastrado pelo escritório (estadual, municipal ou forense) — os
// feriados NACIONAIS (fixos e móveis) nunca entram aqui, são calculados em código (ver
// lib/prazos.ts:feriadosNacionais); esta tabela só existe para o que o calendário nacional não
// cobre (ex.: aniversário da comarca, feriado forense local).
model Holiday {
  id    String   @id @default(cuid())
  // Data-calendário em UTC-meia-noite, mesma convenção de Task.dueDate (ver
  // formatCalendarDate em components/ui.tsx) — nunca ler com getters locais de Date.
  date  DateTime
  name  String
  scope String // NACIONAL | ESTADUAL | MUNICIPAL | FORENSE

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  createdAt DateTime @default(now())

  @@index([officeId, date])
}

// Histórico de recebimentos/pagamentos de uma conta — é o que viabiliza pagamento PARCIAL: uma
// Receivable/Payable pode ter N FinancePayment, e a SOMA deles decide o status entre
// PENDENTE (soma zero) / PARCIAL (soma > 0 mas menor que o valor líquido) / PAGO (soma cobre o
// valor líquido) — ver lib/financeCalc.ts:statusPorPagamentos. Uma conta paga "de uma vez só" no
// fluxo antigo (markReceivablePaid/markPayablePaid) continua funcionando sem nenhuma linha aqui;
// FinancePayment só entra em cena quando a baixa passar a ser parcial/em várias vezes.
model FinancePayment {
  id             String   @id @default(cuid())
  amount         Float
  paidDate       DateTime
  paymentMethod  String? // DEBITO | CREDITO | PIX | TRANSFERENCIA | BOLETO | DINHEIRO | OUTROS
  documentNumber String? // nº do documento de pagamento (comprovante, autenticação bancária...)
  notes          String?
  createdAt      DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  // Aponta para exatamente um dos dois — nunca ambos, nunca nenhum solto sem sentido de negócio,
  // mas isso é responsabilidade da Server Action que cria o registro (Fase futura), não uma
  // constraint do schema. onDelete Cascade: apagar a conta apaga o próprio histórico dela junto,
  // não faz sentido um FinancePayment sobreviver órfão sem a conta que ele estava quitando.
  receivableId String?
  receivable   Receivable? @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  payableId String?
  payable   Payable? @relation(fields: [payableId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  @@index([officeId])
  @@index([receivableId])
  @@index([payableId])
  // Fonte principal do Livro Caixa/DRE (lib/caixaMovimentos.ts), filtrada por officeId + janela
  // de paidDate — sem índice composto a query resolve varrendo tudo do escritório (achado A68 da
  // revisão gauntlet).
  @@index([officeId, paidDate])
}

// ============ ASSESSORIA JURÍDICA ============
// Contêiner por empresa cliente (Client.type = "PJ") para tudo que é contínuo — documentos,
// honorário fixo mensal, licitações — sem se misturar com o controle de Processos individuais.
// Processos e Contas a Receber continuam existindo exatamente como hoje; a Assessoria só os
// referencia pelo cliente já cadastrado (nunca duplica dado).

model Assessoria {
  id            String   @id @default(cuid())
  status        String   @default("ATIVA") // ATIVA | SUSPENSA | ENCERRADA
  startDate     DateTime @default(now())
  monthlyFee    Float
  dueDay        Int      @default(5) // dia do mês de vencimento do honorário
  planningNotes String?
  driveFolderId String? // pasta raiz da empresa em "Assessoria/{empresa}"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id])

  responsibleId String?
  responsible   User?   @relation("AssessoriaResponsible", fields: [responsibleId], references: [id])

  documents         AssessoriaDocumento[]
  honorarios        Honorario[]
  licitacoes        Licitacao[]
  cases             Case[]
  attendances       Attendance[]
  // Anotações pessoais (painel global "Anotações", chip "Assessoria") vinculadas a esta Assessoria.
  anotacoes         Anotacao[]
  // Envios de documentos (E-mail/WhatsApp) desta assessoria — ver model DocumentoEnvio.
  documentoEnvios   DocumentoEnvio[]
  // Pareceres (pastas de documentos) desta assessoria — ver model Parecer mais abaixo.
  pareceres         Parecer[]
  // Despesas recorrentes mensais vinculadas (ex.: repasse a um parceiro da assessoria) — ver
  // comentário em RecurringExpense.assessoriaId.
  recurringExpenses RecurringExpense[]

  @@index([officeId])
}

model AssessoriaDocumento {
  id        String   @id @default(cuid())
  name      String
  docType   String // CONTRATO | PARECER | ACAO_VINCULADA | LICITACAO | REGIMENTO_INTERNO | OUTRO
  driveUrl  String
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  // Mesmo par de campos de Attachment.storageProvider/storageFileId, e pelo mesmo motivo: este
  // registro também referencia um arquivo de upload real (ver
  // app/api/assessoria/documentos/upload/route.ts), não só link colado manualmente (ver
  // addDocumento em lib/actions/assessoria.ts, que não preenche estes dois campos). Default
  // GOOGLE_DRIVE preserva o comportamento de todo documento já existente.
  storageProvider String  @default("GOOGLE_DRIVE")
  storageFileId   String?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  assessoriaId String
  assessoria   Assessoria @relation(fields: [assessoriaId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  uploadedById String?
  uploadedBy   User?   @relation("AssessoriaDocumentoUploadedBy", fields: [uploadedById], references: [id])

  // Pasta de Parecer (ver model Parecer mais abaixo) à qual este documento pertence — opcional
  // porque documentos PARECER cadastrados ANTES desta entrega não têm pasta (ver
  // scripts/backfill-pareceres.ts, que amarra cada um a uma Parecer nova). Documentos de
  // qualquer outra categoria (CONTRATO, LICITACAO...) nunca preenchem este campo — só existe
  // para o caso específico de um documento estar dentro de um Parecer.
  parecerId String?
  parecer   Parecer? @relation(fields: [parecerId], references: [id])

  // Envios (E-mail/WhatsApp) que REFERENCIAM este documento — ver DocumentoEnvioItem, mesmo
  // espírito de Attachment.documentoEnvioItens: nunca uma cópia, só a referência.
  documentoEnvioItens DocumentoEnvioItem[] @relation("DocumentoEnvioItemAssessoriaDocumento")

  @@index([officeId])
  @@index([parecerId])
}

// Um Parecer é um AGRUPADOR de documentos, não um arquivo — decisão tomada com o escritório
// (2026-08) depois de reportarem que "adicionar parecer" só permitia um único arquivo por
// parecer. Na prática um parecer raramente nasce como um arquivo só: é comum reunir minuta,
// anexos e pesquisa em vários documentos separados, cada um com sua própria categoria — o mesmo
// conceito da aba Anexos de um Processo, só que vivendo dentro da Assessoria. Por isso Parecer
// ganha pasta própria no armazenamento (Drive/OneDrive/Dropbox, ver getOrCreateParecerFolder em
// lib/googleDrive.ts / lib/oneDriveStorage.ts / lib/dropboxStorage.ts) dentro de
// "Lúmen - Assessoria/{empresa}/Pareceres/{nome do parecer}", e cada AssessoriaDocumento
// enviado para dentro dele aponta pra cá via AssessoriaDocumento.parecerId.
//
// Documentos AssessoriaDocumento com docType="PARECER" cadastrados ANTES desta entrega continuam
// existindo soltos, com parecerId nulo, até o backfill rodar (ver scripts/backfill-pareceres.ts)
// — a tela trata esse caso à parte (ver AssessoriaProcessosCasosTab.tsx), nunca escondendo um
// parecer antigo da lista.
model Parecer {
  id              String   @id @default(cuid())
  name            String
  date            DateTime @default(now())
  description     String?
  // Pasta "Lúmen - Assessoria/{empresa}/Pareceres/{nome}" no provedor de armazenamento deste
  // escritório — nula até o primeiro documento ser enviado para dentro do parecer (mesma
  // filosofia preguiçosa de Case.driveFolderId/Attendance.driveFolderId: só cria pasta quando
  // alguém realmente for usar).
  driveFolderId   String?
  storageProvider String   @default("GOOGLE_DRIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  assessoriaId String
  assessoria   Assessoria @relation(fields: [assessoriaId], references: [id])

  createdById String?
  createdBy   User?   @relation("ParecerCreatedBy", fields: [createdById], references: [id])

  documents AssessoriaDocumento[]

  @@index([officeId])
  @@index([assessoriaId])
}

// Deliberadamente sem amount/dueDate/status/paidDate próprios — esses dados vivem só no
// Receivable vinculado (Contas a Receber já tem toda a lógica de status/pagamento). Duplicar
// esses campos aqui criaria duas fontes de verdade que poderiam divergir.
model Honorario {
  id          String   @id @default(cuid())
  competencia String // "2026-08"
  createdAt   DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  assessoriaId String
  assessoria   Assessoria @relation(fields: [assessoriaId], references: [id])

  // Opcional — quando o usuário exclui a Receivable desta mensalidade (lib/actions/deletion.ts),
  // este registro NÃO é apagado junto: ele é a trava de idempotência que generateAllMonthlyHonorarios
  // consulta por (assessoriaId, competencia) antes de gerar; apagá-lo junto com a receita fazia o
  // cron recriar a mesma competência na manhã seguinte (achado A27 da revisão gauntlet). Em vez
  // disso vira um "tombstone": receivableId null + canceladoEm preenchido, telas de Honorários da
  // Assessoria filtram por receivableId não-nulo (ver getAssessoriaDetail).
  receivableId String?     @unique
  receivable   Receivable? @relation(fields: [receivableId], references: [id])
  canceladoEm  DateTime?

  @@unique([assessoriaId, competencia])
}

model Licitacao {
  id            String    @id @default(cuid())
  // Nome de gestão, curto — o que aparece em lista/card/breadcrumb e vira o nome da pasta própria
  // desta licitação no armazenamento (achado do dono do escritório, 05/09/2026: usar `objeto`,
  // o texto integral do edital, como título/nome de pasta não é prático). Nullable só para não
  // quebrar Licitacao já existentes antes desta entrega — scripts/backfill-licitacao-nome.ts
  // preenche `nome = objeto` nelas; toda Licitacao NOVA exige o campo (validado em addLicitacao,
  // lib/actions/assessoria.ts). `objeto` continua existindo tal e qual, sem mudar de sentido — é
  // o dado jurídico (o que o edital pede), não o nome de gestão.
  nome          String?
  objeto        String
  orgao         String
  modalidade    String?
  dataAbertura  DateTime?
  prazoFinal    DateTime?
  valorEstimado Float?
  editalUrl     String?
  status        String    @default("EM_ANALISE") // EM_ANALISE | PARTICIPANDO | VENCEDORA | PERDIDA | CANCELADA
  createdAt     DateTime  @default(now())

  // Pasta própria desta licitação no armazenamento — "Assessoria/{empresa}/Licitações/{nome}",
  // criada sob demanda no primeiro anexo (getOrCreateLicitacaoFolder, lib/googleDrive.ts e
  // espelhos). Antes desta entrega, Attachment.licitacaoId não tinha pasta própria nenhuma — o
  // arquivo ia direto para a raiz de Assessoria.driveFolderId (ver comentário em
  // Attachment.licitacaoId abaixo).
  driveFolderId   String?
  // Mesmo par de campos de Parecer.driveFolderId/storageProvider, e pelo mesmo motivo: um
  // escritório pode trocar de provedor de armazenamento depois de a pasta já existir no antigo.
  storageProvider String  @default("GOOGLE_DRIVE")

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  assessoriaId String
  assessoria   Assessoria @relation(fields: [assessoriaId], references: [id])

  tasks           Task[]
  attachments     Attachment[]
  comments        Comment[]
  // Envios de documentos (E-mail/WhatsApp) desta licitação — ver model DocumentoEnvio.
  documentoEnvios DocumentoEnvio[]

  @@index([officeId])
}

// ============ PUBLICAÇÕES / ANDAMENTOS ============

model Publication {
  id                String   @id @default(cuid())
  kind              String   @default("PUBLICACAO") // PUBLICACAO | ANDAMENTO
  source            String   @default("DJE") // DJE | PJE | ESAJ | PROJUDI | MANUAL | JUSBRASIL_EMAIL
  content           String
  publishedAt       DateTime
  // Coluna morta: a aplicação não lê nem escreve mais este campo (leitura agora é por usuário,
  // ver PublicationRead). Mantida no schema de propósito — o deploy roda "prisma db push" sem
  // --accept-data-loss, e apagar essa coluna com dados de produção existentes falharia o
  // build. Não usar; não reintroduzir lógica que dependa dela.
  read              Boolean  @default(false)
  deadlineGenerated Boolean  @default(false)
  lawyerTag         String? // nome do advogado identificado pela OAB citada no conteúdo (ver Fase 4 — hoje regex hardcoded por escritório)
  createdAt         DateTime @default(now())

  emailMessageId    String? @unique
  emailAccount      String?
  emailSubject      String?
  processNumberRaw  String?
  // Sigla do tribunal identificado a partir de processNumberRaw (ver lib/cnjTribunal.ts),
  // preenchido mesmo quando não há caseId — é o que permite mostrar "TJSP" etc. em publicações
  // ainda não vinculadas a um processo cadastrado (tela de Publicações, card "sem processo
  // vinculado").
  tribunalDetectado String?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  clientId String? // preenchido quando não há processo compatível mas o nome de um cliente cadastrado aparece no conteúdo
  client   Client? @relation(fields: [clientId], references: [id])

  // RIDT — fila de triagem com atribuição de responsável
  assignedToId String?
  assignedTo   User?   @relation("PublicationAssignee", fields: [assignedToId], references: [id])
  triageStatus String  @default("PENDENTE") // PENDENTE | EM_ANALISE | TRATADA

  tasks Task[]
  reads PublicationRead[]

  @@index([officeId])
  @@index([officeId, publishedAt])
}

// Processo que um usuário optou por deixar de acompanhar (botão "Bloquear", só disponível para
// publicações/andamentos SEM processo cadastrado — ver LinkPublicationMenu.tsx). Escopo é POR
// USUÁRIO, não por escritório: se um advogado bloqueia, os demais do mesmo escritório continuam
// recebendo normalmente as publicações/andamentos daquele processo — a Publication é sempre
// criada normalmente pelo robô (lib/roboBridge.ts), o bloqueio só filtra a listagem de quem
// bloqueou (ver lib/actions/publications.ts). Gerenciado em Configurações → Geral, abaixo do
// TaskScore (ver BlockedProcessNumbersManager.tsx) — reversível a qualquer momento.
model BlockedProcessNumber {
  id String @id @default(cuid())

  // Normalizado por normalizeProcessNumber (lib/processNumber.ts) — só letras/dígitos, minúsculo,
  // sem máscara — mesma normalização usada em toda busca por número de processo do site, para o
  // bloqueio casar com o número digitado/exibido independente de pontuação.
  processNumber String
  // Como o número aparecia na tela no momento do bloqueio (com máscara), só para exibição na
  // lista de Configurações — processNumber (acima) é o que de fato importa para o casamento.
  displayNumber String
  createdAt     DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // @map preserva o nome de coluna antigo (blockedById) — o campo já era sempre preenchido, então
  // virar NOT NULL + trocar a unique key pra (userId, processNumber) não perde dado nenhum.
  userId String @map("blockedById")
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, processNumber])
  @@index([officeId])
}

// Leitura é por usuário, não compartilhada pelo escritório: cada advogado marca uma
// publicação como lida só pra si — as outras ações (anexar, agendar, delegar, triagem)
// continuam no próprio Publication, vistas por todo mundo do escritório.
model PublicationRead {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt        DateTime    @default(now())

  @@unique([publicationId, userId])
  @@index([userId])
}

// "Lido" na Central de Alertas — só para os tipos de alerta que hoje não têm nenhuma ação de
// resolver (MENCAO, FOLLOWUP_ATRASADO, PARCELA_SEM_VENCIMENTO, DRIVE_INCONSISTENCIA; ver
// lib/alerts.ts). Por usuário, igual PublicationRead/BlockedProcessNumber — dispensar um alerta
// não afeta os outros advogados do escritório. `entityId` é o mesmo AlertItem.entityId (comment.id
// pra menção, attendance.id pro follow-up, payable/receivable.id pra parcela, driveSyncIssue.id).
model AlertDismissal {
  id        String   @id @default(cuid())
  officeId  String
  office    Office   @relation(fields: [officeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String
  entityId  String
  createdAt DateTime @default(now())

  @@unique([userId, kind, entityId])
  @@index([officeId])
}

// ============ ASSISTENTE (chat interno com IA, por escritório) ============
//
// O chat do assistente era EFÊMERO: o front reenviava o histórico inteiro a cada pergunta e nada
// ficava gravado. Funciona para uma pergunta solta e falha em tudo o mais — fechar a aba perdia a
// conversa, trocar de aparelho perdia a conversa, e não havia como o escritório saber o que foi
// perguntado sobre os dados dele.
//
// A SESSÃO É DO USUÁRIO, não do escritório. Um advogado perguntando sobre a estratégia de um caso
// não está escrevendo um documento do escritório; os colegas não devem ler aquilo. O `officeId`
// existe para o isolamento entre inquilinos (e para o Painel Mestre contar uso), não para dar
// acesso cruzado: toda leitura filtra por userId E officeId.
model AssistantSession {
  id        String   @id @default(cuid())
  officeId  String
  office    Office   @relation(fields: [officeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  titulo    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // O id da MESMA conversa do lado do Hermes, quando e ele quem responde (ver lib/hermesPonte.ts).
  // O Hermes guarda o proprio contexto na maquina dele e o retoma por este id; aqui ficam as
  // mensagens legiveis, que sao o que a tela mostra e o que a auditoria consulta. Sao dois
  // registros da mesma conversa, e e de proposito: se o servidor do Hermes for reinstalado, o
  // historico do escritorio continua aqui.
  hermesSessionId String?

  mensagens AssistantMessage[]

  @@index([userId, updatedAt])
  @@index([officeId, updatedAt])
}

// O conteúdo vai como JSON (texto) porque uma mensagem do Claude não é uma string: ela é uma
// lista de blocos (texto, uso de ferramenta, resultado de ferramenta). Guardar só o texto jogaria
// fora justamente o que prova de onde veio a resposta.
model AssistantMessage {
  id        String           @id @default(cuid())
  sessionId String
  session   AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  papel     String // "user" | "assistant"
  conteudo  String
  createdAt DateTime         @default(now())

  @@index([sessionId, createdAt])
}

// REGISTRO DE USO — imutável, por escritório.
//
// Duas funções numa tabela só, e isso é decisão, não economia:
//
//   1. LGPD. O escritório precisa poder provar o que foi consultado sobre os dados dele, por
//      quem e quando. Nada aqui é atualizado ou apagado pelo produto — só inserido e lido.
//   2. LIMITE DE USO. Contar as linhas do último minuto para um escritório responde "quantas
//      requisições ele já fez", que é exatamente o que um limitador precisa saber. Em ambiente
//      serverless um contador em memória não serve: cada instância teria o seu, e o limite
//      valeria por instância em vez de por escritório.
//
// `ferramenta` é nulo na linha da pergunta e preenchido na linha de cada consulta ao banco — é o
// que permite responder "esta resposta veio de onde".
model AssistantAuditLog {
  id         String   @id @default(cuid())
  officeId   String
  office     Office   @relation(fields: [officeId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  sessionId  String?
  acao       String // "PERGUNTA" | "FERRAMENTA" | "RECUSA_LIMITE"
  ferramenta String?
  detalhe    String?
  createdAt  DateTime @default(now())

  @@index([officeId, createdAt])
  @@index([userId, createdAt])
}

// ============ BLOG JURÍDICO (público, por escritório) ============
//
// Alimentado por um robô de conteúdo EXTERNO (projeto Claude Code autônomo, fora
// deste repositório) que pesquisa jurisprudência/legislação/doutrina e envia
// rascunhos via POST /api/blog/draft (autenticado por BLOG_ROBOT_SECRET). Todo
// rascunho nasce como AGUARDANDO_REVISAO — só é publicado quando um usuário
// humano logado confirma em Configurações → Blog Jurídico → Revisão Pendente.

model BlogPost {
  id             String    @id @default(cuid())
  slug           String
  title          String
  area           String // ex: Civil, Consumerista, Empresarial, Tributário, Trabalhista, Previdenciário, Administrativo, Licitação, Compliance, Due Diligence, Contratual, Responsabilidade Civil, Execuções
  type           String    @default("NOTICIA") // NOTICIA | ANALISE
  summary        String
  content        String // corpo da matéria, pode ser markdown simples
  sources        String? // URLs das fontes usadas, uma por linha (texto simples)
  imageUrl       String? // preenchido manualmente pelo admin antes de publicar
  status         String    @default("AGUARDANDO_REVISAO") // AGUARDANDO_REVISAO | PUBLICADO | REJEITADO
  rejectedReason String?
  reviewedById   String?
  reviewedBy     User?     @relation("BlogPostReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@unique([officeId, slug])
  @@index([officeId, status, publishedAt])
  @@index([officeId, area])
}

// ============ BIBLIOTECA DE FOTOS ============
//
// Fotos enviadas por um admin (upload real, armazenado no Vercel Blob — ver
// @vercel/blob e BLOB_READ_WRITE_TOKEN). Usadas tanto para ilustrar matérias do
// blog jurídico (sugestão automática por área) quanto como camada de fundo
// decorativa, de baixa opacidade, atrás do conteúdo do sistema.

model Photo {
  id        String   @id @default(cuid())
  url       String // URL pública do Vercel Blob
  category  String // mesma taxonomia livre de BlogPost.area, + "Todos" para fotos só decorativas/ambiente (curinga)
  court     String   @default("TODOS") // tribunal retratado na foto: STF, STJ, TRT/TST, TJ, TRF, TODOS (curinga)
  caption   String? // legenda opcional, ex: para crédito/descrição da imagem
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId, category])
}

// ============ TABELAS DO ROBÔ PYTHON (robo-publicacoes/, Railway) ============
//
// O robô Python (SQLAlchemy) grava direto nestas 4 tabelas, sem coluna de
// escritório — ele já monitora as OABs de TODOS os escritórios ativos
// (config.py:carregar_oabs_do_banco), mas não sabe a qual escritório cada OAB
// pertence. Os tipos/nomes de coluna abaixo espelham robo-publicacoes/src/db.py;
// se o robô mudar a estrutura lá, replicar a mudança aqui também (sem isso,
// `prisma db push` trata essas tabelas como "órfãs" e as apaga na próxima migração).
//
// Estes 4 modelos não são a fonte de verdade multi-tenant — lib/roboBridge.ts é quem
// lê estas tabelas e ATRIBUI cada item capturado ao escritório certo (por número de
// processo batendo com um Case existente e, na falta disso, por OAB batendo com um
// usuário ativo de algum escritório), gravando o resultado já com officeId em
// Publication. Ou seja, o roteamento multi-escritório já acontece nesta ponte —
// não é mais uma limitação de arquitetura pendente.

model RoboPublicacao {
  idComunicacao        String   @id @map("id_comunicacao")
  oab                  String
  uf                   String
  nomeAdvogado         String?  @map("nome_advogado")
  numeroProcesso       String   @map("numero_processo")
  tribunal             String?
  dataDisponibilizacao String?  @map("data_disponibilizacao")
  tipoComunicacao      String?  @map("tipo_comunicacao")
  teor                 String?
  dataCaptura          DateTime @default(now()) @map("data_captura")
  statusLido           Boolean  @default(false) @map("status_lido")

  // syncRoboParaSite (lib/roboBridge.ts) filtra por statusLido: false a cada ciclo do cron
  // robo-bridge (a cada 3h) — sem índice, essa consulta é sequential scan da tabela inteira, que
  // só cresce (as linhas nunca são apagadas, só marcadas como lidas).
  @@index([statusLido])
  @@map("publicacoes")
}

model RoboAndamento {
  id                 Int      @id @default(autoincrement())
  numeroProcesso     String   @map("numero_processo")
  tribunal           String?
  dataMovimentacao   String   @map("data_movimentacao")
  codigoMovimento    String   @map("codigo_movimento")
  descricaoMovimento String?  @map("descricao_movimento")
  dataCaptura        DateTime @default(now()) @map("data_captura")
  statusLido         Boolean  @default(false) @map("status_lido")

  @@unique([numeroProcesso, dataMovimentacao, codigoMovimento], name: "uq_andamento_processo_data_codigo")
  // Mesma justificativa de RoboPublicacao.statusLido acima.
  @@index([statusLido])
  @@map("andamentos")
}

model RoboProcessoMonitorado {
  numeroProcesso String   @id @map("numero_processo")
  origem         String
  dataInclusao   DateTime @default(now()) @map("data_inclusao")
  oabRelacionada String?  @map("oab_relacionada")

  @@map("processos_monitorados")
}

model RoboExecucaoLog {
  id          Int      @id @default(autoincrement())
  fonte       String
  sucesso     Boolean
  detalhe     String?
  executadoEm DateTime @default(now()) @map("executado_em")

  @@map("execucao_log")
}

// Licitações capturadas pelo robô administrativo (robo-publicacoes/src/pncp.py) na API pública
// de consulta do PNCP. Mesmo padrão dos 4 modelos acima (tabela compartilhada, sem officeId —
// o robô não sabe a qual escritório uma licitação interessa, só coleta tudo dentro das UFs
// configuradas). O roteamento por escritório acontece depois, em lib/pncpBridge.ts, casando
// contra os termos vigiados (TermoVigilancia) de cada escritório. `numeroControlePNCP` é a
// chave natural do PNCP (única por licitação em todo o país) — usada tanto pro dedup do robô
// quanto pra chave de idempotência da Publication gerada na ponte. `payloadBruto` guarda o item
// inteiro serializado (JSON) exatamente como veio da API: como o mapeamento de campo real ainda
// não foi confirmado contra uma resposta de verdade (ver comentário no topo de pncp.py), isso
// permite reprocessar/corrigir o mapeamento depois sem precisar consultar o PNCP de novo.
// IMPORTANTE: assim como os 4 modelos acima, se esta estrutura mudar, replicar a mudança em
// robo-publicacoes/src/db.py (senão `prisma db push` trata a tabela como órfã).
model RoboLicitacao {
  id                       String   @id @default(cuid())
  numeroControlePNCP       String   @unique
  orgaoCnpj                String?
  orgaoNome                String?
  uf                       String?
  municipio                String?
  modalidadeNome           String?
  objeto                   String?
  valorEstimado            Float?
  situacao                 String?
  dataPublicacao           String?
  dataAberturaProposta     String?
  dataEncerramentoProposta String?
  linkSistemaOrigem        String?
  payloadBruto             String? // JSON cru, para conseguir reprocessar sem consultar de novo
  dataCaptura              DateTime @default(now())
  statusProcessado         Boolean  @default(false)

  @@index([statusProcessado])
  @@map("licitacoes_pncp")
}

// Artigo do Diario Oficial da Uniao (DOU) capturado via INLABS (Imprensa Nacional) que bateu
// com pelo menos um termo vigiado (TermoVigilancia) de um escritorio — Fase 2 do Setor de
// Processos Administrativos. DIFERENTE do padrao de RoboLicitacao/RoboPublicacao/RoboAndamento
// (que gravam TUDO e deixam o casamento por escritorio acontecer depois, na ponte TypeScript):
// aqui o casamento com os termos vigiados acontece DENTRO do robo Python (src/inlabs.py), no
// momento da propria captura, porque o DOU publica milhares de artigos por dia e gravar todos
// incharia o banco a toa — so interessa o artigo que realmente bate com um termo de algum
// escritorio. Por isso este model JA NASCE com officeId obrigatorio (nao-nulo), ao contrario
// dos outros models do robo: cada linha aqui e o resultado de um casamento que ja aconteceu.
// Se dois escritorios diferentes tiverem termos que batem no MESMO artigo, o Python grava DUAS
// linhas (uma por escritorio), cada uma com sua propria chaveUnica (ver campo abaixo).
// IMPORTANTE: assim como os modelos do robo acima, se esta estrutura mudar, replicar a mudanca
// em robo-publicacoes/src/db.py (senao `prisma db push` trata a tabela como orfa).
model RoboDouItem {
  id               String   @id @default(cuid())
  chaveUnica       String   @unique // dataPublicacao + secao + id do artigo + officeId — evita duplicar entre execuções
  secao            String // DO1 | DO2 | DO3 | DO1E | DO2E | DO3E
  orgao            String?
  titulo           String?
  ementa           String?
  textoResumo      String? // trecho em torno do termo encontrado, não o artigo inteiro
  dataPublicacao   String?
  numeroPagina     String?
  termoEncontrado  String // texto do termo que bateu (não o id — sobrevive se o termo for apagado depois)
  payloadBruto     String? // XML do artigo; truncado com segurança se muito grande
  dataCaptura      DateTime @default(now())
  statusProcessado Boolean  @default(false)

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId, statusProcessado])
}

// ============ PAINEL MESTRE (cobrança entre escritórios) ============

// Uma fatura mensal de um escritório-cliente da plataforma. Gerada manualmente pelo platform
// owner (Painel Mestre → "Gerar boleto e enviar por e-mail") ou, quando o BTG estiver
// conectado (ver BtgConnection), automaticamente com um boleto de verdade emitido.
model TenantInvoice {
  id          String    @id @default(cuid())
  officeId    String
  office      Office    @relation(fields: [officeId], references: [id])
  competencia String // "2026-08" — mês de referência, evita gerar duas faturas pro mesmo mês
  amount      Float
  dueDate     DateTime
  status      String    @default("PENDENTE") // PENDENTE | PAGO | CANCELADO
  paidAt      DateTime?
  // "manual" (Dar baixa manual, sem boleto), "btg_boleto" (baixa confirmada via boleto BTG) ou
  // "asaas" (baixa confirmada via webhook/reconciliação Asaas — ver lib/asaas.ts)
  paidVia     String?
  boletoUrl   String? // link do PDF do boleto, quando emitido via BTG
  boletoId    String? // ID do boleto na API do BTG, pra consultar status depois
  createdAt   DateTime  @default(now())

  // Forma de pagamento efetivamente usada nesta fatura — preenchido quando a cobrança é
  // criada (não só quando é paga), pra sabermos de antemão que tipo de dado exibir (QR Code
  // vs. link de boleto) mesmo antes da confirmação de pagamento.
  paymentMethod String? // PIX_AUTOMATICO | PIX_QRCODE | BOLETO

  // Referência da cobrança no Asaas (o "payment" — id tipo "pay_..."). Chave usada tanto pelo
  // webhook (encontrar a fatura a partir do evento recebido) quanto pela reconciliação
  // (consultar o status atual direto na API).
  asaasPaymentId String? @unique

  // Dados do Pix QR Code dinâmico desta cobrança especificamente (só preenchidos quando
  // paymentMethod for PIX_QRCODE) — o "copia e cola" (payload EMV) e a imagem do QR Code em
  // base64, exatamente como a Asaas devolve (docs.asaas.com/reference/obter-qr-code-para-pagamentos-via-pix).
  pixQrCodePayload String?
  pixQrCodeImage   String? // base64, pode ser grande — @db.Text se o provider exigir (Postgres não exige)

  // Status bruto devolvido pela Asaas (ex.: "RECEIVED", "CONFIRMED", "OVERDUE") — guardado
  // por auditoria/depuração, sem substituir o campo `status` local (PENDENTE|PAGO|CANCELADO)
  // que o resto do sistema já lê.
  externalStatus String?

  // E-mails de cobrança já enviados por esta fatura — evita reenviar o mesmo e-mail toda vez
  // que o cron roda (Fase 2) e serve de prova de que a cobrança CHEGOU ao escritório (é o que
  // a coluna "Entrega da cobrança" de /painel-mestre/assinaturas lê para distinguir boleto/QR
  // Code apenas GERADO de efetivamente ENVIADO). Valores:
  //   "FATURA_INICIAL"   — e-mail com o boleto/QR Code (generateAndSendInvoice)
  //   "ANTES_VENCIMENTO" | "VENCIDA" | "SUSPENSAO" — lembretes do cron (lib/actions/billing.ts)
  // Só entra aqui depois do envio ter dado certo, nunca na tentativa.
  remindersSent String[] @default([])

  @@unique([officeId, competencia])
}

// Log de todo evento de webhook de pagamento recebido — existe por dois motivos: (1)
// idempotência (o Asaas pode reenviar o mesmo evento mais de uma vez; @unique em
// [provider, externalId, eventType] garante que só processamos uma vez), (2) auditoria (nunca
// apagar; é o registro de que um pagamento foi de fato confirmado pelo provedor, não por
// alguém chamando nosso backend direto — ver o limite de segurança inegociável descrito em
// lib/asaas.ts e app/api/asaas/webhook/route.ts).
model PaymentWebhookEvent {
  id             String    @id @default(cuid())
  provider       String    @default("ASAAS")
  eventType      String // ex.: PAYMENT_RECEIVED, PAYMENT_CONFIRMED, PAYMENT_OVERDUE
  externalId     String // id do evento OU do payment/authorization — o que a Asaas mandar como identificador único
  signatureValid Boolean
  rawPayload     Json
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([provider, externalId, eventType])
  @@index([createdAt])
}

// Conexão OAuth (Authorization Code) com o BTG Empresas — é UMA conta (a do próprio Rodarte
// Prado no BTG), não por escritório-cliente: é o Rodarte Prado quem emite o boleto e cobra
// cada escritório. Só deve existir uma linha; token renovado in-place a cada refresh.
model BtgConnection {
  id            String   @id @default(cuid())
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  connectedAt   DateTime @default(now())
  connectedById String? // userId de quem autorizou (auditoria)
}

// ============ LÚMEN — FUNDAÇÃO DE DADOS (Passo 1) ============
//
// Tudo daqui pra baixo é estrutura nova da plataforma Lúmen (a empresa por trás do produto,
// distinta de cada escritório-cliente). Passo 1 é só schema + endpoint de preenchimento manual:
// nenhuma tela lê estes modelos ainda, nenhum comportamento em execução muda. Os campos que já
// existem em Office/User (isInternal, monthlyFee, billingEmail, billingDueDay, isPlatformOwner)
// continuam sendo a fonte de verdade até a leitura ser migrada num passo futuro.

// ---- Identidade da empresa ----

model PlatformMember {
  id     String  @id @default(cuid())
  // Vínculo com um User de escritório. Hoje Jairo e Rodrigo entram por aqui: autenticam com a
  // conta que já têm e a capacidade "Lúmen" é esta linha, separada. Fica opcional porque um
  // funcionário contratado só pela Lúmen no futuro terá userId nulo e credencial própria,
  // sem pertencer a escritório nenhum.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Preenchidos só quando userId for nulo (funcionário exclusivo da Lúmen).
  name         String?
  email        String? @unique
  passwordHash String?

  roleId String
  role   PlatformRole @relation(fields: [roleId], references: [id])

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessRequests  AccessRequest[]  @relation("AccessRequestRequester")
  accessApprovals AccessRequest[]  @relation("AccessRequestApprover")
  accessSessions  AccessSession[]
  auditEntries    AccessAuditLog[]

  // Slots de campanha simultânea paga que este membro aprovou (§6.4 da especificação de
  // campanhas) — ver CampanhaSlotPago.aprovadoPor.
  campanhaSlotsAprovados  CampanhaSlotPago[]
  conversasNoPainelMestre PainelMestreConversa[]
  perguntasNoPainelMestre PainelMestreTurno[]
}

model PlatformRole {
  id   String @id @default(cuid())
  key  String @unique // SOCIO | FINANCEIRO | SUPORTE_N1 | ENGENHARIA | COMERCIAL | MARKETING
  name String

  // Teto de acesso na escada de visibilidade: ABERTO | VIDRO_FOSCO | QUEBRA_VIDRO.
  // Ninguém alcança COFRE — nem sócio. Guardado como texto pelo mesmo motivo dos demais
  // enums do schema (db push sem migration).
  maxVisibility String @default("ABERTO")

  canManageBilling Boolean @default(false)
  canManageMembers Boolean @default(false)
  canApproveAccess Boolean @default(false)

  createdAt DateTime         @default(now())
  members   PlatformMember[]
}

// ---- Receita e custo ----

model Subscription {
  id       String @id @default(cuid())
  officeId String @unique
  office   Office @relation(fields: [officeId], references: [id])

  planKey      String  @default("PADRAO")
  monthlyFee   Float
  dueDay       Int     @default(10)
  billingEmail String?
  status       String  @default("ATIVA") // ATIVA | TESTE | SUSPENSA | CANCELADA
  // Assinatura interna (Rodarte Prado) — cobrada a preço interno, não entra no MRR comercial.
  // Substitui Office.isInternal quando a leitura for migrada, no Passo 4.
  internal     Boolean @default(false)

  // Ciclo de cobrança escolhido pelo escritório — "MENSAL" (padrão) ou "SEMESTRAL" (paga de
  // uma vez a cada 6 meses, com desconto). Nomeado em português por consistência com o resto
  // do schema (STATUS, planKey etc. usam texto livre em maiúsculas); o valor equivalente do
  // lado Asaas (MONTHLY/SEMIANNUALLY) é traduzido em lib/asaas.ts, não aqui.
  billingCycle String @default("MENSAL") // MENSAL | SEMESTRAL

  // Forma de cobrança ativa desta assinatura — PIX_AUTOMATICO é o caminho preferencial (débito
  // recorrente autorizado uma vez), PIX_QRCODE é o QR Code dinâmico gerado a cada cobrança
  // (usado sobretudo no ciclo SEMESTRAL, mas disponível pro MENSAL também), BOLETO continua
  // existindo via BTG (ver lib/btg.ts) para quem preferir. Nasce nulo (ainda não configurado)
  // até o escritório escolher/conectar.
  paymentMethod String? // PIX_AUTOMATICO | PIX_QRCODE | BOLETO

  // Percentual de desconto aplicado (ex.: 20 para 20%) — hoje só faz sentido combinado com
  // billingCycle SEMESTRAL, mas fica genérico pra não prender a regra de desconto ao ciclo no
  // nível de schema (a regra de negócio "só semestral tem desconto" fica no código, não aqui).
  discountPercent Float?

  // Referências do lado Asaas — preenchidas quando a integração é conectada pela primeira vez
  // para este escritório. asaasCustomerId é sempre necessário (toda cobrança precisa de um
  // "customer" no Asaas); os outros dois só existem se o método ativo for PIX_AUTOMATICO.
  asaasCustomerId        String?
  asaasSubscriptionId    String? // id da "assinatura" Asaas (usado no fluxo PIX_QRCODE/BOLETO recorrente)
  pixAuthorizationId     String? // id da autorização de Pix Automático (docs.asaas.com/reference/criar-uma-autorizacao-pix-automatico)
  pixAuthorizationStatus String? // PENDENTE | ATIVA | CANCELADA | REJEITADA

  startedAt   DateTime  @default(now())
  trialEndsAt DateTime?
  canceledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PlatformAccount {
  id        String            @id @default(cuid())
  code      String            @unique
  name      String
  kind      String // RECEITA | DESPESA
  group     String? // Infraestrutura, Pessoal, Marketing, Impostos...
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  expenses  PlatformExpense[]
}

model PlatformExpense {
  id          String          @id @default(cuid())
  accountId   String
  account     PlatformAccount @relation(fields: [accountId], references: [id])
  description String
  amount      Float
  competencia String // "2026-08"
  paidAt      DateTime?
  supplier    String?
  notes       String?
  createdAt   DateTime        @default(now())

  @@index([competencia])
}

model TenantUsage {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  competencia   String // "2026-08" — agregado mensal, não evento a evento
  kind          String // IA_TOKENS | DATAJUD_CONSULTA | DJEN_CONSULTA | BLOB_BYTES | EMAIL_ENVIADO
  quantity      Float  @default(0)
  // Custo estimado em reais, calculado no momento do registro. Guardado junto porque preço de
  // fornecedor muda e recalcular no futuro daria número errado para o passado.
  estimatedCost Float  @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([officeId, competencia, kind])
  @@index([competencia])
}

// ---- Camada de confiança (dormente até o Passo 2) ----

model SupportTicket {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  subject   String
  body      String?
  status    String   @default("ABERTO") // ABERTO | EM_ANDAMENTO | RESOLVIDO | FECHADO
  openedBy  String? // userId de quem abriu, do lado do escritório
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessRequests AccessRequest[]
}

model AccessRequest {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  requesterId String
  requester   PlatformMember @relation("AccessRequestRequester", fields: [requesterId], references: [id])

  // Chamado obrigatório e verificável: precisa existir, estar aberto e ser DAQUELE escritório.
  // É onde PIM da Microsoft e PAM do Google falham (campo livre, sem validação) e onde temos
  // vantagem, porque controlamos os dois lados.
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id])

  // Lista fechada, nunca texto livre: CONFIG_INTEGRACAO | CORRECAO_DADO | DIAGNOSTICO_ERRO |
  // MIGRACAO | INCIDENTE_SEGURANCA | ORDEM_JUDICIAL
  reasonCode String
  reasonNote String?

  // Escopo mínimo: um registro específico. scopeType: CASE | PAYABLE | RECEIVABLE | ATTENDANCE
  scopeType String
  scopeId   String

  status String @default("PENDENTE") // PENDENTE | APROVADO | NEGADO | EXPIRADO | REVOGADO

  approverId       String?
  approver         PlatformMember? @relation("AccessRequestApprover", fields: [approverId], references: [id])
  // Sócio do escritório que aprovou. Guardado como id solto, sem relation, porque o aprovador
  // é do lado do cliente e não deve criar dependência do modelo de plataforma sobre User.
  approvedByUserId String?
  decidedAt        DateTime?

  requestedAt DateTime @default(now())
  expiresAt   DateTime

  sessions AccessSession[]

  @@index([officeId, status])
}

model AccessSession {
  id        String        @id @default(cuid())
  requestId String
  request   AccessRequest @relation(fields: [requestId], references: [id])

  memberId String
  member   PlatformMember @relation(fields: [memberId], references: [id])

  startedAt DateTime  @default(now())
  // Prazo curto com contagem regressiva visível, na linha do que o Discourse faz (15 min).
  expiresAt DateTime
  endedAt   DateTime?
  endedBy   String? // MEMBRO | ESCRITORIO | EXPIRACAO

  @@index([expiresAt])
}

model AccessAuditLog {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  memberId String?
  member   PlatformMember? @relation(fields: [memberId], references: [id])

  // ENTRADA | LEITURA | ESCRITA | SAIDA | PEDIDO | APROVACAO | NEGACAO | REVOGACAO | SELAGEM
  action    String
  // Categoria própria para acesso que NÃO passou pelo fluxo normal — emergência, exposição
  // incidental, ordem judicial. É fácil registrar o que seguiu o processo; o valor está em
  // registrar o que não seguiu.
  outOfBand Boolean @default(false)

  reasonCode String?
  scopeType  String?
  scopeId    String?
  sessionId  String?
  ip         String?
  detail     String?

  createdAt DateTime @default(now())

  @@index([officeId, createdAt])
}

// ============ SETOR ADMINISTRATIVO — FUNDAÇÃO (Radar de Publicações Administrativas) ============

// Um "termo vigiado" — nome de cliente, número de processo ou palavra livre que o escritório
// quer que o robô administrativo (coletor PNCP/DOU/Diários/TCs) procure nas fontes públicas.
// Existe tanto solto (LIVRE, sem caseId/clientId — ex.: monitorar o nome de um sócio antes de
// existir processo) quanto amarrado a um Case ou Client já cadastrado (dispara alerta direto
// naquele registro quando dá match). O @@unique evita cadastrar o mesmo termo duas vezes para
// o mesmo processo (silenciosamente ignorado por addTermoVigilancia, não é erro do usuário).
model TermoVigilancia {
  id          String    @id @default(cuid())
  termo       String
  tipo        String    @default("LIVRE") // NOME | DOCUMENTO | NUMERO | LIVRE
  ativo       Boolean   @default(true)
  ultimoHitAt DateTime?
  createdAt   DateTime  @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  criadoPorId String?
  criadoPor   User?   @relation(fields: [criadoPorId], references: [id])

  @@unique([officeId, termo, caseId])
  @@index([officeId, ativo])
}

// Uma fonte pública que o robô administrativo sabe varrer (PNCP, DOU via INLABS, Querido Diário,
// tribunais de contas etc.) — uma linha por escritório por fonte, porque a ativação e a última
// execução são por conta (não é dado global como Tribunal). Nasce inativa (ativa=false): o
// escritório liga cada fonte explicitamente depois de configurar o que precisa (ex.: termos
// vigiados cadastrados), em vez de já sair varrendo tudo sem ninguém ter pedido.
model FonteAdministrativa {
  id               String    @id @default(cuid())
  chave            String // PNCP | DOU_INLABS | QUERIDO_DIARIO | BTCU | DEC_TCE_GO | DOC_TCM_GO | CARF | CAT_GO
  nome             String
  ativa            Boolean   @default(false)
  ultimaExecucaoAt DateTime?
  ultimoStatus     String? // OK | ERRO
  ultimoDetalhe    String?
  createdAt        DateTime  @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@unique([officeId, chave])
}

// ============ TIPOS DE DOCUMENTO CRIADOS PELO ESCRITÓRIO ============

// O catálogo de tipos de documento (lib/documentTypes.ts) é fixo no código e agrupado por seção
// ("Processual", "Decisões Judiciais", "Contratos"...). Isso cobre o comum e trava o incomum: se
// o escritório precisa de "Print de conversa de WhatsApp" ou "Laudo de vistoria", não tem por
// onde criar — e acaba jogando tudo em "Outros", que é o mesmo que não categorizar.
//
// Esta tabela guarda os tipos que o próprio escritório cria, na hora de anexar: escolhe a SEÇÃO
// em que o tipo entra e escreve o nome. A partir daí o tipo aparece no seletor junto com os
// nativos, e a pasta correspondente passa a ser criada sozinha no Drive, do mesmo jeito que as
// categorias nativas (getOrCreateCategoryFolder usa o rótulo como nome de pasta).
//
// `chave` é derivada do rótulo (maiúsculas, sem acento, com _) e é o que fica gravado em
// Attachment.docType / AssessoriaDocumento.docType — mesmo formato dos tipos nativos, para que
// nada precise distinguir um do outro na hora de ler.
model OfficeDocumentType {
  id        String   @id @default(cuid())
  chave     String // ex.: PRINT_DE_CONVERSA — mesmo formato dos tipos nativos
  rotulo    String // ex.: "Print de conversa"
  secao     String // nome do grupo em DOCUMENT_TYPE_GROUPS onde o tipo aparece
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  @@unique([officeId, chave])
  @@index([officeId])
}

// ============ RELATÓRIO PERSONALIZADO (modelos salvos) ============

// Um conjunto de filtros do Relatório Personalizado salvo com nome ("Relatório mensal — Guapó"),
// para não remontar tudo a cada mês. `filtros` guarda o RelatorioFiltros inteiro como JSON (ver
// lib/relatorioPersonalizado.ts) — de propósito não é normalizado em colunas: o formato do filtro
// muda junto com a tela, e uma coluna por dimensão obrigaria migração a cada dimensão nova.
//
// Os ids gravados aqui (assessoria, usuário) podem deixar de existir depois — por isso salvar
// SEMPRE revalida a existência de cada valor antes de gravar (ver salvarModelo em
// lib/actions/relatorioPersonalizado.ts) e carregar avisa o que sumiu, em vez de filtrar por um
// id fantasma e devolver relatório vazio sem explicar por quê.
model RelatorioModelo {
  id        String   @id @default(cuid())
  nome      String
  filtros   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  @@unique([officeId, nome])
  @@index([officeId])
}

// ============ CONEXÕES (log de execução de integrações — Fase 2 do redesenho Modernist) ============

// Um ciclo de execução de uma integração (sincronização do DJEN, chamada ao Datajud, webhook do
// Asaas, varredura do Drive, envio de e-mail/WhatsApp, chamada de ferramenta MCP...) — documento
// 04 do handoff: "isso está de pé?" não tinha um lugar até agora, porque cada integração inventava
// seu próprio jeito de dizer "funcionando" (StatusLine ad-hoc, texto solto na aba "Modelos &
// Integrações"). Este modelo é o que faz o log deixar de ser efêmero: a rota /conexoes (documento
// 04) lê daqui pra mostrar 7 dias de histórico sem consulta manual ao banco.
//
// `integration` é uma string livre (não enum do Prisma) de propósito: a lista de integrações já é
// grande (DJEN, DATAJUD, ASAAS, BTG, DRIVE, ONEDRIVE, DROPBOX, EMAIL, WHATSAPP, MCP...) e cresce
// sem exigir migração de schema a cada uma nova — mesmo raciocínio usado em Task.type/Payable.status
// no restante do projeto.
//
// Retenção: 90 dias — limpeza no mesmo cron do robô de publicações (documento 04). A limpeza em si
// é código de PR futura (a que liga a escrita real de linhas aqui); esta PR só declara a tabela.
model IntegrationRun {
  id          String   @id @default(cuid())
  integration String // "DJEN" | "DATAJUD" | "ASAAS" | "BTG" | "DRIVE" | "ONEDRIVE" | "DROPBOX" | "EMAIL" | "WHATSAPP" | "MCP"
  startedAt   DateTime @default(now())
  durationMs  Int?
  status      String // "OK" | "ERRO" | "AVISO"
  httpStatus  Int?
  itemCount   Int?
  message     String?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId, integration, startedAt])
}

// ============ API KEYS DO ESCRITÓRIO (documento 04 — Conexões, Fase 2 do redesenho Modernist) ============

// Credencial para uma integração externa chamar a API do Lúmen em nome do escritório (catálogo
// "Chaves e automação" em /conexoes). IMPORTANTE: hoje só a GESTÃO da credencial existe (criar,
// listar, revogar) — nenhum endpoint do projeto valida essas chaves ainda, porque não existe uma
// API pública do Lúmen hoje (só rotas internas, autenticadas por sessão do portal). Declarado
// mesmo assim porque gerir a credencial é uma peça independente e reaproveitável quando essa API
// existir — mesmo raciocínio de IntegrationRun (model criado numa PR, escrito de verdade só
// depois, ver documento 10 do plano de execução).
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  // Prefixo visível (ex.: "lumen_live_a1b2c3d4") — mostrado na tabela; o valor completo nunca é
  // persistido, só o hash abaixo (comparação na autenticação, quando ela existir).
  prefix     String
  keyHash    String
  // LEITURA | ESCRITA — string livre, não enum do Prisma (mesmo raciocínio de
  // IntegrationRun.integration): a lista de escopos cresce sem exigir migração de schema.
  scope      String    @default("LEITURA")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  @@index([officeId])
}

// ============ PRIVACIDADE E LGPD (documento 07 — Fase 4 do redesenho Modernist) ============

// Trilha de auditoria da atividade da EQUIPE DO PRÓPRIO ESCRITÓRIO sobre dado sensível — revelar
// um CPF/valor mascarado (break-glass interno), exportar a trilha, executar exclusão/anonimização
// de um pedido do titular. `actorId` é sempre um User do escritório.
//
// Não confundir com AccessAuditLog (acima, "Camada de confiança"): aquele é a trilha do SUPORTE
// DA PLATAFORMA (PlatformMember agindo via "atuar como"/Vidro Fosco) — já existe, já é gravado, e
// continua sendo a fonte da aba "Suporte" da trilha (documento 07). Este AuditEvent é uma tabela
// nova e paralela, para uma audiência e um ator diferentes: a EQUIPE do escritório revelando dado
// do próprio escritório, no dia a dia normal (não durante uma sessão de suporte).
//
// `kind` é string livre, não enum do Prisma — mesmo raciocínio de IntegrationRun.integration.
//
// Append-only por decisão de produto (documento 07): nenhuma Server Action deste projeto pode dar
// update/delete num AuditEvent — deixe isso explícito em comentário no arquivo da action que grava
// aqui, exatamente como este comentário faz agora. Não há trigger de banco impondo isso (o projeto
// não usa triggers em lugar nenhum) — a garantia é só de convenção de código, igual o resto do
// projeto já confia em convenção (ex.: Publication.read, coluna morta, "não usar" só em comentário).
model AuditEvent {
  id         String  @id @default(cuid())
  kind       String // "REVELACAO" | "EXPORTACAO" | "EXCLUSAO" | "ANONIMIZACAO"
  // Tipo/id do registro afetado (ex.: entityType "Client", entityId o id do cliente) — ambos
  // opcionais porque nem todo evento tem um registro único (ex.: EXPORTACAO da trilha inteira).
  entityType String?
  entityId   String?
  // Campo revelado, quando kind = REVELACAO (ex.: "document", "phone") — ver lib/mask.ts.
  field      String?
  reason     String?
  meta       Json?

  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  @@index([officeId, kind, createdAt])
}

// Pedido do titular dos dados (LGPD art. 18 — acesso, correção, exclusão, anonimização),
// registrado como um PEDIDO COM PRAZO LEGAL (15 dias, `dueAt`), não como uma ação imediata. Reusa
// components/DeletionRequestsPanel.tsx só como referência de PADRÃO VISUAL (lista + aprovar/
// recusar) — o model por trás é outro: DeletionRequest (já existente) é aprovação de exclusão de
// um REGISTRO DE NEGÓCIO qualquer (ex.: um Processo cadastrado errado); DataSubjectRequest é o
// titular dos dados (cliente, parte contrária, ex-cliente) pedindo acesso/correção/exclusão/
// anonimização dos PRÓPRIOS dados pessoais — conceito jurídico distinto, prazo legal próprio.
model DataSubjectRequest {
  id          String    @id @default(cuid())
  subjectName String
  subjectDoc  String? // CPF/CNPJ do titular, quando informado no pedido
  kind        String // "EXCLUSAO" | "ANONIMIZACAO" | "ACESSO" | "CORRECAO"
  // Canal por onde o pedido chegou (ex.: "E-mail", "Telefone", "Presencial") — texto livre, não
  // há integração automática com nenhum canal (todo pedido é registrado manualmente pela equipe).
  channel     String
  receivedAt  DateTime
  dueAt       DateTime // receivedAt + 15 dias corridos (LGPD art. 18, §3º) — calculado na criação
  status      String    @default("ABERTO") // "ABERTO" | "EM_ANALISE" | "EXECUTADO" | "RECUSADO"
  decision    String?
  executedAt  DateTime?

  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  @@index([officeId, status])
}

// ============ COMUNICADOS (documento 06 — Fase 3 do redesenho Modernist) ============

// Preferência de comunicado POR USUÁRIO: um resumo por dia, no horário escolhido, mais uma
// lista curta e explícita de eventos que "furam a fila" (saem na hora, não esperam o resumo).
// Substitui gradualmente as 5 flags soltas User.notify* (Andamentos/Publicacoes/
// TarefasDelegadas/AgendaDia/Mencoes, todas push-only, todas ou-liga-ou-desliga) por um único
// registro com canal+cadência POR EVENTO (`perEvent`) — as flags antigas continuam existindo e
// sendo lidas pelos pontos de envio em tempo real (lib/push.ts) até a migração de fato acontecer
// numa PR seguinte desta mesma fase; nenhuma das duas coisas se apaga sozinha só por esta PR
// (schema isolado, sem mudança de comportamento — mesmo padrão de IntegrationRun/AuditEvent).
model NotificationPreference {
  id           String   @id @default(cuid())
  digestOn     Boolean  @default(true)
  digestHour   Int      @default(8) // 0-23, fuso do escritório
  weekdaysOnly Boolean  @default(true)
  // "PRAZO_HOJE" | "AUDIENCIA_24H" | "PUBLICACAO_NOVA" | "HONORARIO_RECEBIDO" — só estes 4
  // podem estar aqui (documento 06: "manter a lista curta é parte do desenho").
  breakthrough String[]
  // { "PUBLICACAO_NOVA": { canal: "EMAIL", cadencia: "DIARIO" }, ... } — canal: EMAIL | PUSH |
  // IN_APP; cadência: NA_HORA | DIARIO | SEMANAL | NUNCA. Formato solto (Json), não um model à
  // parte por evento, porque a lista de eventos cresce (mesmo raciocínio de campos-string-livre
  // já usados no projeto, ex. IntegrationRun.integration) e cada usuário só grava os que
  // divergem do padrão do escritório.
  perEvent     Json

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  officeId String
  office   Office @relation(fields: [officeId], references: [id])
}

// Fila de saída dos comunicados — todo evento (breakthrough ou não) passa por aqui antes de
// virar e-mail/push/aviso in-app de verdade. `dueAt` é OU agora (breakthrough) OU o próximo
// horário de digest do destinatário; um cron de 5 minutos (PR de "outbox e cron de
// agrupamento", ainda não escrita) varre `dueAt <= now && sentAt == null`, agrupa por usuário +
// canal e envia um e-mail e um push por pessoa por rodada — nunca um por evento. `dedupeKey`
// (calculado por quem grava, não por este model) impede que um reprocessamento de robô
// (achado de reprocessamento visto em lib/roboBridge.ts) reenvie o mesmo evento duas vezes.
model NotificationOutbox {
  id        String    @id @default(cuid())
  event     String
  payload   Json
  channel   String // "EMAIL" | "PUSH" | "IN_APP"
  dueAt     DateTime
  sentAt    DateTime?
  dedupeKey String    @unique

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([officeId, dueAt, sentAt])
}

// Template de e-mail editável por escritório e por evento — substitui o HTML fixo hoje escrito
// direto em lib/email.ts (nenhum dos 9 e-mails atuais é configurável). `event` usa o MESMO
// vocabulário de NotificationOutbox.event ("PUBLICACAO_NOVA", "PRAZO_VENCENDO"...), então um
// template SEM linha aqui para um evento cai no HTML padrão embutido no código — nenhum
// escritório fica sem e-mail só por nunca ter aberto o editor.
model EmailTemplate {
  id        String   @id @default(cuid())
  event     String
  subject   String
  bodyHtml  String
  updatedAt DateTime @updatedAt

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@unique([officeId, event])
}

// ============ PETICIONAMENTO (aba de peticionamento, perfil Hermes "peticionamento-lumen") ============
//
// Fonte da verdade de produto: especificacao-peticionamento-lumen.md (entrevista fechada com o
// dono) + os mockups aprovados em .../mockups-peticionamento/ (decisions.md e
// contrato-com-o-agente.md). Este bloco guarda só o ESTADO da sessão de peticionamento — as
// regras de negócio (o que é mínimo, que combinação de contexto é proibida, quem pode exportar,
// como se monta o nome do arquivo) vivem em módulos PUROS sob lib/peticionamento*.ts, testados
// em lib/testes/, nunca aqui.

// Matéria adicionada por UM escritório específico ("+ Adicionar matéria" da tela de contexto).
// Decisão do dono, literal: uma matéria nova vale só para aquele escritório, nunca vira opção
// global do Lúmen — por isso não existe tabela "matéria global editável", só esta, sempre presa
// a um officeId. A lista global (matérias "do Lúmen") continua vivendo em código
// (lib/peticionamentoMateria.ts), sem tabela — não muda por escritório.
model PeticionamentoMateria {
  id          String   @id @default(cuid())
  officeId    String
  office      Office   @relation(fields: [officeId], references: [id])
  nome        String
  criadoPorId String?
  criadoPor   User?    @relation("PeticionamentoMateriaCriadoPor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([officeId, nome])
  @@index([officeId])
}

// Uma sessão de peticionamento — do primeiro passo (contexto) até a minuta editável. Nasce ao
// abrir a aba e é salva automaticamente a cada mudança (seção 7 da especificação: "contexto
// preenchido pela metade e abandonado é salvo automaticamente como rascunho reaproveitável,
// nunca perdido ao fechar a aba").
model PeticionamentoSessao {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  criadoPorId String
  criadoPor   User   @relation("PeticionamentoSessaoCriadoPor", fields: [criadoPorId], references: [id])

  // A TRAVA DE CLIENTE mora aqui: nula numa sessão avulsa (sem vínculo, seção 10 da
  // especificação); preenchida no primeiro vínculo escolhido, e todo vínculo seguinte precisa
  // pertencer a este MESMO cliente (validado em lib/peticionamentoContexto.ts antes de qualquer
  // escrita — nunca só na tela). Não é preferência de organização, é sigilo profissional (seção
  // 8): dois clientes diferentes nunca coexistem numa sessão.
  clienteId   String?
  clienteNome String?

  // Vínculos escolhidos nesta sessão — ids em JSON, não relação de banco. De propósito: um
  // processo/atendimento/assessoria apagado depois não pode deixar esta sessão com uma foreign
  // key quebrada, e a trava de mesmo cliente já foi validada no momento da escolha (ver acima),
  // não depende de o banco garantir isso por relação.
  vinculoCaseIds       Json    @default("[]")
  vinculoAttendanceIds Json    @default("[]")
  vinculoAssessoriaIds Json    @default("[]")
  // Quando há mais de um vínculo, qual delas é a "pasta principal" para salvar anexo e minuta
  // final (seção 10) — formato "case:<id>" | "attendance:<id>" | "assessoria:<id>".
  pastaPrincipal       String?
  // ADEQUAÇÃO 21/09/2026: marca que o advogado JÁ decidiu vincular algo OU escolheu avulsa
  // explicitamente — sem este flag, uma sessão "avulsa de propósito" e uma sessão que ninguém
  // tocou ainda ficam com o MESMO estado gravado (vínculos todos vazios), e a lista de rascunhos
  // (lib/peticionamentoPasso.ts) não teria como saber se o passo "contexto" já foi decidido.
  contextoDecidido     Boolean @default(false)

  // Matéria — do Lúmen (lib/peticionamentoMateria.ts) ou do escritório (PeticionamentoMateria
  // acima); materiaEhDoEscritorio só marca QUAL das duas listas, nunca muda o tratamento do
  // agente (contrato-com-o-agente.md §1: "não distinga o tratamento entre as duas").
  materiaNome           String?
  materiaEhDoEscritorio Boolean @default(false)
  /// CONTRATO DE SCHEMA 22/09/2026 (pedido do dono: "precisa de permitir marcar mais de uma
  /// matéria"). Um caso de sucessões que também é tributário não é um caso de uma matéria só, e
  /// obrigar a escolher uma fazia o advogado mentir para o formulário.
  ///
  /// `materiaNome` acima NÃO morre e NÃO vira legado silencioso: ele continua sendo a matéria
  /// PRINCIPAL (a primeira escolhida) — é o que as sessões já gravadas têm, é o que a lista de
  /// rascunhos mostra numa linha só, e é o que o prompt usa como matéria-cabeça. `materiasNomes`
  /// é a lista COMPLETA, incluindo a principal, na ordem em que foram marcadas.
  ///
  /// Quem escrever precisa manter os dois em pé ao mesmo tempo, sempre: gravar a lista e gravar
  /// a primeira em materiaNome, na MESMA transação. Uma sessão antiga (materiasNomes vazia,
  /// materiaNome preenchida) tem de ser lida como "uma matéria só" sem nenhum passo de migração
  /// — leitura fail-open para o dado que já existe.
  materiasNomes         Json    @default("[]")

  // Tipo de peça — lista fechada da seção 9, ou "Outra" com texto livre em tipoPecaOutro.
  // tipoPecaInferido marca quando NINGUÉM escolheu e o sistema tentou inferir pelo andamento do
  // vínculo (contrato-com-o-agente.md §1) — precisa aparecer na nota de destaque, nunca em
  // silêncio.
  tipoPeca         String?
  tipoPecaOutro    String?
  tipoPecaInferido Boolean @default(false)

  // ADEQUAÇÃO 21/09/2026, espec. §7: a PRIMEIRA pergunta da sessão, antes até do contexto —
  // Petição | Contrato | Parecer | Notificação Extrajudicial (lib/peticionamentoCategoriaPeca.ts).
  // Não confundir com `tipoPeca` acima: aquele é a sublista (Inicial, Contestação, Réplica...)
  // que só faz sentido QUANDO categoriaPeca é "Petição".
  categoriaPeca String?

  // ADEQUAÇÃO 21/09/2026, espec. §8: a natureza do procedimento é DEDUZIDA a partir do vínculo
  // (lib/peticionamentoNatureza.ts), nunca perguntada do zero — mas a dedução nunca é silenciosa:
  // naturezaMotivo é o texto explicativo mostrado na tela ("processo judicial, porque..."), e
  // naturezaConfirmadaManualmente marca quando o advogado corrigiu a dedução (em vez de aceitá-la
  // por omissão). Recalculada a cada mudança de vínculo — ver alternarVinculo/definirSessaoAvulsa.
  naturezaProcedimento          String?
  naturezaMotivo                String?
  naturezaConfirmadaManualmente Boolean @default(false)

  // O MÍNIMO PARA GERAR (decisão do dono): fatos + pedidos. Os demais campos abaixo são
  // enriquecimento — a ausência deles nunca bloqueia a geração (ver lib/peticionamentoMinimo.ts).
  fatos                 String?
  pedidos               Json      @default("[]")
  prazoFatal            DateTime?
  /// CONTRATO DE SCHEMA 22/09/2026 (pedido do dono): se o prazo é PRECLUSIVO, ele deixa de ser
  /// um lembrete administrativo e passa a ser um fato jurídico da peça — "se marcar preclusivo, o
  /// prazo precisa ganhar tópico próprio no documento a ser gerado".
  ///
  /// Portanto isto NÃO é enfeite de formulário: quando true, o prazo entra no pedido ao agente
  /// como seção própria, e o agente é instruído a tratá-lo como preclusivo. Falso por omissão —
  /// nunca presuma preclusão que ninguém marcou, porque errar para esse lado assusta o cliente e
  /// errar para o outro perde o prazo. Quem marca é o advogado, sempre.
  prazoPreclusivo       Boolean   @default(false)
  valorCausa            String?
  descumprimentoLiminar String?
  teses                 Json      @default("[]")
  observacoes           String?

  // Documentos JÁ existentes no Lúmen, selecionados para esta sessão (ids de Attachment, sem
  // relação de banco pelo mesmo motivo do vínculo acima). Os anexos NOVOS desta sessão vivem em
  // PeticionamentoAnexo, abaixo.
  documentosExistentesIds Json @default("[]")

  // CONTEXTO (wizard em andamento) | AGUARDANDO_CONFIRMACAO (modal de triagem aberto) |
  // GERANDO | GERADA | FALHA_GERACAO | EXPORTADA.
  status String @default("CONTEXTO")

  // Seção 8: nunca trunca em silêncio. Preenchido quando o contexto foi resumido automaticamente
  // (o que foi condensado) ou bloqueado (o que falta decidir) — null quando o contexto sempre
  // coube inteiro.
  contextoResumoAviso     String?
  contextoBloqueadoMotivo String?

  // O que o agente devolveu (contrato-com-o-agente.md §2): corpo completo da minuta já com o
  // fecho literal garantido por código (lib/peticionamentoFecho.ts) — nunca confiado só ao
  // modelo. As três listas abaixo alimentam a nota de destaque obrigatória
  // (lib/peticionamentoNotaObrigatoria.ts), montada pelo SISTEMA, nunca copiada do texto livre
  // que o modelo escreveu.
  minutaTexto               String?
  notaRiscos                Json    @default("[]")
  jurisprudenciaCitada      Json    @default("[]")
  documentosBaseConsultados Json    @default("[]")
  // PRIORIDADE 1 (relatório da entrega "peticionamento lê documentos"): documento que NÃO pôde
  // ser lido (formato não suportado, PDF escaneado sem texto, falha ao baixar do Drive) — nunca
  // entra em documentosBaseConsultados, e a tela/nota obrigatória precisam dizer QUAIS ficaram de
  // fora e por quê, nunca só omitir. Formato: [{ nome: string; motivo: string }].
  documentosNaoLidos        Json    @default("[]")

  hermesSessionId String?
  geradoEm        DateTime?

  /// CONTRATO DE SCHEMA 22/09/2026 — A GERAÇÃO QUE NÃO CABE NUMA REQUISIÇÃO WEB.
  ///
  /// O teto duro da Vercel é de 300 segundos. Uma peça a partir de um processo de dezenas de
  /// páginas pode legitimamente precisar de mais, e em produção o Hermes foi MORTO aos 240s com o
  /// agente ainda escrevendo — o trabalho inteiro (e o custo) perdido por causa do relógio de uma
  /// requisição HTTP. Por isso a geração deixou de ser "esperar" e passou a ser um TRABALHO COM
  /// NOME: o Lúmen dispara na ponte, recebe um identificador, e volta na hora.
  ///
  /// `hermesTarefaId` é esse identificador, do lado da PONTE (servidor-hermes/servidor.py,
  /// `POST /chat-async`). NÃO CONFUNDIR com `hermesSessionId` acima, que é a conversa do lado do
  /// HERMES e sobrevive entre gerações: a tarefa é de UMA geração só e morre quando ela termina.
  ///
  /// QUEM MEXER AQUI É OBRIGADO A MANTER EM PÉ, ao mesmo tempo:
  ///
  ///   · os três campos andam JUNTOS com `status = "GERANDO"`. Gravar GERANDO sem `hermesTarefaId`
  ///     cria uma sessão que ninguém consegue colher: ela fica na tela "gerando" até o prazo
  ///     máximo e só então vira falha — o advogado esperando por nada;
  ///   · `geracaoIniciadaEm` é o relógio da rede de segurança por cron
  ///     (app/api/cron/minutas-pendentes). Sem ele, uma sessão de aba fechada nunca é varrida;
  ///   · `geracaoDocumentosLidos` é a lista de nomes dos documentos que FORAM LIDOS e ENVIADOS
  ///     nesta geração. Ela tem de ser gravada no DISPARO, e não na colheita, porque quem colhe
  ///     pode ser o cron, noutra requisição, sem nada do que foi montado em memória. É ela que
  ///     filtra a declaração do agente contra o que de fato foi lido — sem ela, um nome alucinado
  ///     entraria em `documentosBaseConsultados` e a nota obrigatória mentiria ao juiz.
  ///
  /// Os três são limpos quando a geração é colhida (GERADA) ou desiste (FALHA_GERACAO): uma
  /// tarefa que já foi colhida não pode ser colhida de novo, e deixá-la gravada seria um convite.
  hermesTarefaId         String?
  geracaoIniciadaEm      DateTime?
  geracaoDocumentosLidos Json      @default("[]")

  /// CONTRATO DE SCHEMA 23/09/2026 — A MEDIÇÃO QUE SUBSTITUI O NÚMERO INVENTADO.
  ///
  /// Quanto ESTA geração levou, em milissegundos, do disparo até a minuta gravada. Gravado UMA vez,
  /// na mesma reivindicação atômica que grava a minuta (`gravarMinutaGerada`), e nunca depois.
  ///
  /// POR QUE ELE EXISTE. A tela de geração precisa dizer quanto tempo isto costuma levar, e o dono
  /// pediu a frase "de x a 15 minutos". NINGUÉM MEDIU esse x — e número inventado numa tela é o que
  /// esta casa mais evita (é o mesmo motivo pelo qual a tela de geração não mostra porcentagem).
  /// Então o sistema MEDE: com medições suficientes, a tela mostra a faixa real DESTE escritório
  /// (lib/peticionamentoTempoDeGeracao.ts); sem elas, fala só do teto e não inventa piso nenhum.
  ///
  /// NULO É ESTADO LEGÍTIMO, e quem lê tem de tratá-lo: as sessões geradas antes desta entrega não
  /// têm medição, e uma geração cujo relógio de início se perdeu (`geracaoIniciadaEm` nulo) NÃO
  /// recebe um número chutado a partir de `updatedAt` — ficaria "medido" sem ter sido medido.
  geracaoDuracaoMs Int?

  /// CONTRATO DE SCHEMA 23/09/2026 — O QUE FAZ O ALERTA DA CENTRAL SUMIR SOZINHO.
  ///
  /// Quando alguém abriu a tela da minuta DEPOIS de a geração terminar (com sucesso ou com falha).
  /// Gravado pela própria página (app/peticionamento/[id]/minuta/page.tsx), no mesmo lugar em que
  /// ela já grava `passoAtual` a cada navegação.
  ///
  /// É O CORTE DO ALERTA "minuta pronta" (lib/alerts.ts): o alerta existe enquanto isto é nulo.
  /// Assim o advogado que gera cinco minutas num dia vê cinco alertas e cada um SOME quando ele
  /// abre aquela minuta — sem botão de dispensar, porque existe uma ação que resolve o alerta, e
  /// a ação é justamente abrir o que ficou pronto.
  ///
  /// NÃO PODE SER GRAVADO NO ESTADO GERANDO: a tela da minuta é a MESMA que mostra o andamento da
  /// geração, e marcá-la como vista enquanto o agente ainda redige apagaria o alerta antes de ele
  /// nascer — o advogado de aba fechada nunca saberia que a peça ficou pronta.
  minutaVistaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// O passo em que a pessoa parou, GRAVADO a cada navegação. Antes disto o passo era deduzido
  /// do que já estava preenchido — acertava quase sempre, e "quase sempre" numa tela que promete
  /// retomar de onde parou é o suficiente para a promessa soar falsa quando erra.
  passoAtual String?

  anexos      PeticionamentoAnexo[]
  exportacoes PeticionamentoExportacao[]
  citacoes    PeticionamentoCitacao[]

  @@index([officeId, criadoPorId])
  @@index([officeId, status])
  /// A rede de segurança por cron varre por `status` + `geracaoIniciadaEm` e ATRAVESSA os
  /// escritórios (uma sessão em GERANDO tem de terminar seja de quem for) — por isso o índice
  /// NÃO começa por officeId, ao contrário dos dois acima.
  @@index([status, geracaoIniciadaEm])
}

// Anexo NOVO desta sessão (upload — seção 10 da especificação), distinto dos documentos que já
// existiam no Lúmen (esses ficam só como id em PeticionamentoSessao.documentosExistentesIds).
model PeticionamentoAnexo {
  id       String               @id @default(cuid())
  sessaoId String
  sessao   PeticionamentoSessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  nome          String
  driveUrl      String?
  storageFileId String?
  tamanhoBytes  Int?

  // Markdown é sempre SUGERIDO, nunca obrigatório (seção 1) — os dois campos abaixo são
  // mutuamente exclusivos na prática (a tela só marca um deles), nunca os dois juntos.
  markdownConvertido Boolean @default(false)
  markdownRecusado   Boolean @default(false)

  // Ao fim da sessão, o sistema oferece promover este anexo a anexo oficial do processo/caso
  // (seção 10) — nada é apagado automaticamente se recusado, ele só continua em "peticionamento/".
  promovidoOficial Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([sessaoId])
}

// O REGISTRO da trava técnica de exportação (seção 5): quem confirmou o checkbox de ciência e
// quando — nos metadados do próprio .docx (lib/peticionamentoDocx.ts) E aqui, para auditoria do
// escritório sobreviver mesmo que o arquivo gerado seja perdido/editado depois.
model PeticionamentoExportacao {
  id       String               @id @default(cuid())
  sessaoId String
  sessao   PeticionamentoSessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  confirmadoPorId String
  confirmadoPor   User     @relation("PeticionamentoExportacaoConfirmadoPor", fields: [confirmadoPorId], references: [id])
  confirmadoEm    DateTime @default(now())

  arquivoNome      String
  driveUrl         String?
  timbradoAplicado Boolean

  createdAt DateTime @default(now())

  @@index([sessaoId])
}

// ============================================================================
// CONTRATO DE SCHEMA DA FILA (22/09/2026) — escrito de uma vez, de propósito.
//
// Quatro frentes da fila do dono precisavam de banco: validação de citação uma a uma, histórico
// do agente do Painel Mestre, registro de quem perguntou o quê, e o passo real de um rascunho.
// Cada uma ia rodar num agente diferente, e três agentes editando este arquivo ao mesmo tempo se
// atropelam — o client gerado é compartilhado. Em vez de enfileirar as quatro por causa disso, o
// schema foi definido AQUI, uma vez, e as frentes passam a ser independentes entre si.
//
// Efeito colateral bom: o modelo de dados fica coerente porque foi pensado junto, em vez de três
// desenhos parecidos inventados em paralelo.
// ============================================================================

/// Uma citação de jurisprudência dentro de uma minuta, e a confirmação individual dela.
///
/// O SISTEMA NÃO VERIFICA NADA: ele não sabe se o precedente existe. O que esta tabela sustenta é
/// a única garantia possível hoje — que ninguém poderá dizer que não viu cada citação antes de a
/// peça sair. Por isso `confirmadaPorId` e `confirmadaEm` são o coração dela, e por isso existe
/// `hashDoTexto`: editar a minuta depois de confirmar tem de INVALIDAR a confirmação da citação
/// que mudou, senão a confirmação passa a valer para um texto que ninguém leu.
model PeticionamentoCitacao {
  id       String               @id @default(cuid())
  sessaoId String
  sessao   PeticionamentoSessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  /// EMENTA (o agente citou como precedente estruturado) | TRECHO (referência solta no corpo do
  /// texto — estas são as mais perigosas, porque hoje escapam inteiras da lista de jurisprudência).
  tipo  String @default("EMENTA")
  texto String

  /// Os links da dupla validação, para o advogado conferir. Nulos quando o agente não informou —
  /// e "não informou" é um fato a mostrar na tela, nunca um silêncio.
  fonteUrl           String?
  fonteSecundariaUrl String?

  /// Impressão do texto no momento da confirmação. Se o texto mudar, a confirmação não vale mais.
  hashDoTexto String?

  confirmadaPorId String?
  confirmadaPor   User?     @relation(fields: [confirmadaPorId], references: [id])
  confirmadaEm    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessaoId, tipo])
}

/// Uma conversa com o agente do Painel Mestre. Hoje o histórico morre quando a aba fecha.
model PainelMestreConversa {
  id String @id @default(cuid())

  membroId String
  membro   PlatformMember @relation(fields: [membroId], references: [id], onDelete: Cascade)

  titulo String?
  turnos PainelMestreTurno[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([membroId, updatedAt])
}

/// Um turno da conversa — e, ao mesmo tempo, o REGISTRO de quem perguntou o quê.
///
/// As duas coisas na mesma tabela de propósito: uma trilha de auditoria que vive separada do
/// histórico diverge dele no primeiro dia em que alguém apagar uma conversa. Aqui, quem lê o
/// histórico e quem audita leem a mesma linha.
model PainelMestreTurno {
  id         String               @id @default(cuid())
  conversaId String
  conversa   PainelMestreConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  /// Quem perguntou. Guardado no turno, e não só na conversa, porque é o registro de auditoria:
  /// ele tem de responder "quem perguntou isto", não "de quem é a conversa onde isto apareceu".
  membroId String
  membro   PlatformMember @relation(fields: [membroId], references: [id])

  /// user | assistant
  papel String
  texto String

  /// Nomes das ferramentas que o agente usou para responder este turno. É o que torna a auditoria
  /// útil: não só o que foi perguntado, mas o que foi de fato consultado para responder.
  ferramentasUsadas Json @default("[]")

  createdAt DateTime @default(now())

  @@index([conversaId, createdAt])
  @@index([membroId, createdAt])
}
