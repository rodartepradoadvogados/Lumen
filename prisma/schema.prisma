model Lawyer {
  id        String   @id @default(cuid())
  name      String
  oab       String?
  firm      String?
  side      String   @default("PARCEIRO") // PARCEIRO | ADVERSO
  email     String?
  phone     String?
  phoneDdi  String? // dígitos do código do país (ex.: "55") — ver components/PhoneInput.tsx
  notes     String?
