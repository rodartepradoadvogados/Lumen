// Catálogo de planos (Painel Mestre → Preços) — 5 linhas fixas (Standard/Silver/Gold/Diamond/Sob
// Medida), editáveis na tela (limites e composição de módulo), sem exigir deploy pra ajustar. Sob
// Medida (isCustom true) não tem limite nem composição fixa — existe só como opção no seletor de
// plano do escritório; o operador escolhe módulo a módulo e digita oabLimit/caseLimit livremente
// naquele escritório (ver Office acima). Os 4 booleanos aqui são a composição PADRÃO de um plano
// fixo — pré-marcam os módulos do escritório ao escolher o plano, mas o valor de fato contratado
// (e o preço) sempre mora em Office, nunca é lido daqui em tempo de cobrança.
model Plan {
  id                String   @id @default(cuid())
  key               String   @unique // STANDARD | SILVER | GOLD | DIAMOND | SOB_MEDIDA
  name              String
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  isCustom          Boolean  @default(false)
  recommended       Boolean  @default(false) // no máximo 1 plano true por vez — imposto em updatePlan/setRecommendedPlan (lib/actions/painelMestre.ts), não no schema
  maxOabs           Int?
  maxProcessos      Int?
  moduloFinanceiro  Boolean  @default(false)
  moduloWhatsapp    Boolean  @default(false)
  moduloAtendimento Boolean  @default(false)
  moduloAssessoria  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  offices Office[]
}

// Preço-catálogo dos 4 módulos, global (uma linha por módulo, não por plano) — o "campo
// configurável no painel mestre" pedido: "Financeiro - Valor: R$ ___", "Assessoria Jurídica -
// Valor: R$ ___" etc. Nasce com price null em todo módulo ("deixe tudo sem preço"). É só a
// SUGESTÃO usada para pré-preencher o preço de um escritório ao ligar um módulo pela primeira
// vez — o valor que de fato entra na mensalidade de um escritório é sempre o preço gravado no
// próprio Office (editável, permite desconto pontual), nunca lido daqui em tempo de cobrança.
model ModulePrice {
  moduleKey String   @id // FINANCEIRO | WHATSAPP | ATENDIMENTO | ASSESSORIA
  label     String
  price     Float?
  updatedAt DateTime @updatedAt
}

// ============ EQUIPE ============

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  username     String?
  passwordHash String?
  role         String  @default("Advogado") // Advogado, Estagiário, Financeiro, Admin
  oab          String?
  phone        String?
  phoneDdi     String? // dígitos do código do país (ex.: "55") — ver components/PhoneInput.tsx
  color        String  @default("#0f1f3d") // cor de identificação em cards/agenda
  isAdmin      Boolean @default(false) // sócios/donos do escritório: aprovam exclusões, gerenciam equipe e acesso ao financeiro

  // RECEBE LEAD TRANSFERIDO PELA ATENDENTE DE IA. Nasce DESLIGADO para todo mundo, inclusive para
  // quem já estava cadastrado: ligar sozinho mandaria conversa de cliente para o telefone de
  // alguém que não pediu isso. Quem liga é o administrador, pessoa por pessoa.
  //
  // A POSIÇÃO NA FILA É `createdAt`: ordem de cadastro, como o dono definiu — quem entra depois
  // vai para o fim, sem ninguém ter que renumerar nada.
  recebeTransferencia Boolean @default(false)

  // Quando esta pessoa recebeu, pela última vez, a frase automática explicando que o número do
  // atendimento não conversa com o escritório (ver lib/avisoDeLead.ts: FRASE_AO_COLEGA). Existe
  // porque o aviso de lead chega pelo MESMO número por onde os clientes falam, e responder a um
  // aviso é o primeiro reflexo de qualquer pessoa — sem esta marca, ou o robô explica a mesma
  // coisa a cada mensagem, ou cala para sempre e quem escrever daqui a seis meses conclui que o
  // número quebrou.
  avisoAutomaticoEm DateTime?
  financeAccess     Boolean   @default(false) // controla visibilidade do módulo Financeiro; sócios sempre têm acesso independente deste campo
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())

  // Dono(a) da PLATAFORMA Lúmen (Jairo e Rodrigo) — nada a ver com isAdmin (que é por
  // escritório). Só quem tem isPlatformOwner=true enxerga e acessa /painel-mestre, e só esse
  // flag permite "atuar como" outro escritório (ver lib/officeActing.ts) e ignora bloqueio de
  // Office.status. Setado manualmente no banco / via seed do próprio escritório interno,
  // nunca por autosserviço.
  isPlatformOwner Boolean @default(false)

  resetTokenHash   String?   @unique // hash SHA-256 do token de redefinição de senha (nunca o token puro)
  resetTokenExpiry DateTime?

  // Preferências de notificação push (app mobile) — cada uma liga/desliga um tipo de aviso,
  // configurável pelo próprio usuário em Configurações. Ligadas por padrão (opt-out, não
  // opt-in) para quem já ativou notificações neste aparelho continuar recebendo tudo até
  // decidir desligar algo específico.
  notifyAndamentos       Boolean @default(true)
  notifyPublicacoes      Boolean @default(true)
  notifyTarefasDelegadas Boolean @default(true)
  notifyAgendaDia        Boolean @default(true)
  notifyMencoes          Boolean @default(true)

  // Provedor escolhido explicitamente para o envio de e-mail no Atendimento — "GOOGLE" ou
  // "MICROSOFT". Sem essa escolha o envio fica desabilitado (erro claro), mesmo que a pessoa
  // tenha uma das duas contas conectada: conectar não habilita sozinho, é preciso escolher (ver
  // lib/gmailSend.ts) — evita mandar e-mail pela conta errada por engano.
  emailSendProvider String?

  // Meu Perfil — dados pessoais autoatendidos (cada pessoa edita os próprios, ver
  // lib/actions/profile.ts). photoUrl é o link privado do Vercel Blob, servido via
  // /api/perfil/foto/[userId] (mesmo padrão de lib/photos.ts para o blog).
  photoUrl      String?
  birthDate     DateTime?
  gender        String?
  maritalStatus String?
  cpf           String?
  rg            String?
  address       String?
  cep           String?
  city          String?
  state         String?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  pushSubscriptions           PushSubscription[]
  tasksResponsible            Task[]                  @relation("TaskResponsible")
  tasksDelegated              Task[]                  @relation("TaskDelegatedBy")
  tasksCompleted              Task[]                  @relation("TaskCompletedBy")
  casesResponsible            Case[]                  @relation("CaseResponsible")
  comments                    Comment[]
  anotacoes                   Anotacao[]
  mentions                    Mention[]
  publicationReads            PublicationRead[]
  attendances                 Attendance[]            @relation("AttendanceResponsible")
  recusasQueFez               RecusaDeAtendimento[]   @relation("RecusaAutor")
  recusasQueReverteu          RecusaDeAtendimento[]   @relation("RecusaRevisor")
  recusasQueArquivou          RecusaDeAtendimento[]   @relation("RecusaArquivista")
  attachments                 Attachment[]
  documentTemplates           DocumentTemplate[]
  deletionRequested           DeletionRequest[]       @relation("DeletionRequestedBy")
  deletionResolved            DeletionRequest[]       @relation("DeletionResolvedBy")
  loginSessions               LoginSession[]
  notices                     Notice[]
  publicationsAssigned        Publication[]           @relation("PublicationAssignee")
  googleCredentials           GoogleCredential[]
  officeDocumentTypes         OfficeDocumentType[]
  relatorioModelos            RelatorioModelo[]
  apiKeysCreated              ApiKey[]
  auditEventsActed            AuditEvent[]
  dataSubjectRequestsCreated  DataSubjectRequest[]
  notificationPreference      NotificationPreference?
  notificationOutbox          NotificationOutbox[]
  microsoftCredentials        MicrosoftCredential[]
  blogPostsReviewed           BlogPost[]              @relation("BlogPostReviewer")
  emailsSent                  EmailMessage[]          @relation("EmailMessageSentBy")
  assessoriasResponsible      Assessoria[]            @relation("AssessoriaResponsible")
  assessoriaDocumentsUploaded AssessoriaDocumento[]   @relation("AssessoriaDocumentoUploadedBy")
  pareceresCriados            Parecer[]               @relation("ParecerCreatedBy")
  blockedProcessNumbers       BlockedProcessNumber[]
  alertDismissals             AlertDismissal[]
  assistantSessions           AssistantSession[]
  assistantAuditLogs          AssistantAuditLog[]

  // Termos de vigilância que este usuário cadastrou (ver model TermoVigilancia mais abaixo) —
  // só para exibir "criado por" na tela, não afeta quem enxerga o termo (isso é por officeId).
  termosVigilanciaCriados TermoVigilancia[]

  // Protocolos que esta pessoa montou e os que ela registrou como protocolados — dois papéis
  // distintos de propósito: quem prepara o lote muitas vezes não é quem envia ao tribunal.
  protocoloLotesCriados      ProtocoloLote[] @relation("ProtocoloLoteCriadoPor")
  protocoloLotesProtocolados ProtocoloLote[] @relation("ProtocoloLoteProtocoladoPor")

  // Envios de documentos (E-mail/WhatsApp) que esta pessoa registrou — ver model DocumentoEnvio
  // mais abaixo.
  documentoEnvios DocumentoEnvio[]

  // Lúmen (Passo 1) — capacidade de plataforma, separada de isPlatformOwner (ver PlatformMember).
  platformMember PlatformMember?

  // Fundação de dados do financeiro avançado (Fase 1), ainda dormente — quem lançou a conta
  // (responsibleId de Payable/Receivable/HonorarioLancamento), quem apurou o valor real de uma
  // parcela percentual (Receivable.apuradoPorId) e quem registrou um recebimento/pagamento
  // parcial (FinancePayment.createdById). Papéis distintos entre si de propósito: quem lança a
  // conta muitas vezes não é quem depois dá baixa ou apura o êxito.
  payablesResponsible             Payable[]             @relation("PayableResponsible")
  // Contas a Pagar em que este User é quem RECEBE o pagamento (honorário de advogado contratado,
  // estagiário, funcionário — ver Payable.payeeUserId), distinto de payablesResponsible acima
  // (quem lançou a conta, não quem é pago por ela).
  payablesAsPayee                 Payable[]             @relation("PayablePayee")
  receivablesResponsible          Receivable[]          @relation("ReceivableResponsible")
  receivablesApuradas             Receivable[]          @relation("ReceivableApuradoPor")
  honorarioLancamentosResponsible HonorarioLancamento[] @relation("HonorarioLancamentoResponsible")
  financePayments                 FinancePayment[]

  // Pendências do Atendimento (Fase 5) atribuídas a esta pessoa como responsável — ver model
  // AtendimentoPendencia mais abaixo.
  atendimentoPendenciasResponsible AtendimentoPendencia[] @relation("AtendimentoPendenciaResponsible")

  // Aba de Peticionamento — três papéis distintos de propósito (quem criou a matéria do
  // escritório, quem criou a sessão, quem confirmou uma exportação), mesmo raciocínio de
  // payablesResponsible/payablesAsPayee acima: nunca a mesma pessoa por acaso.
  peticionamentoMateriasCriadas        PeticionamentoMateria[]    @relation("PeticionamentoMateriaCriadoPor")
  peticionamentoSessoesCriadas         PeticionamentoSessao[]     @relation("PeticionamentoSessaoCriadoPor")
  peticionamentoExportacoesConfirmadas PeticionamentoExportacao[] @relation("PeticionamentoExportacaoConfirmadoPor")
  PeticionamentoCitacao                PeticionamentoCitacao[]

  @@unique([officeId, username])
}

// Uma inscrição de push por aparelho/navegador em que o usuário ativou notificações
// (ver components/mobile/NotificationPreferences.tsx) — um mesmo usuário pode ter mais de
// uma (celular + tablet, por exemplo). endpoint é o identificador único que o navegador
// gera; p256dh/auth são as chaves de criptografia exigidas pelo protocolo Web Push.
// Sem officeId próprio — sempre acessada através do userId (nunca listada direto por escritório).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ MURAL DE RECADOS ============

model Notice {
  id        String   @id @default(cuid())
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

// ============ TIMESHEET (sessões de login) ============

model LoginSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  loginAt    DateTime @default(now())
  lastPingAt DateTime @default(now())
  createdAt  DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId, userId, loginAt])
}

// ============ CONTATOS ============

model Client {
  id            String   @id @default(cuid())
  name          String
  type          String   @default("PF") // PF | PJ
  document      String?
  rg            String?
  nationality   String?
  maritalStatus String?
  profession    String?
  email         String?
  phone         String?
  phoneDdi      String? // dígitos do código do país (ex.: "55") — ver components/PhoneInput.tsx
  address       String?
  notes         String?
  createdAt     DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  cases                Case[]
  caseLinks            CaseClient[]
  receivables          Receivable[]
  honorarioLancamentos HonorarioLancamento[]
  publications         Publication[]
  attendances          Attendance[]          @relation("AttendanceClient")
  assessoria           Assessoria?
  // Contas a pagar em que este cliente é o BENEFICIÁRIO do pagamento (Payable.payeeClientId) —
  // ver comentário lá.
  payablesAsPayee      Payable[]             @relation("PayablePayeeClient")

  // Termos de vigilância (Radar de Publicações Administrativas) vigiando o nome deste cliente,
  // independente de já haver um processo aberto — ver model TermoVigilancia mais abaixo.
  termosVigilancia TermoVigilancia[]

