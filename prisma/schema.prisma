// Lúmen - Sistema de gestão jurídica multi-tenant
// Fork de rp-financeiro (sistema mono-tenant do Rodarte Prado Advogados).
// Schema completo: casos/atendimentos, agenda/kanban integrados, financeiro, contatos, publicações
// — agora com isolamento por Office (escritório/tenant) em toda entidade de negócio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ MULTI-TENANCY (Fase 1) ============
//
// Toda entidade de negócio abaixo carrega um officeId obrigatório — o requisito não-negociável
// do projeto é nunca misturar dado de um escritório com outro. officeId é denormalizado em toda
// tabela (mesmo em filhas de outra entidade já escopada) de propósito: elimina a necessidade de
// caminhar a cadeia de relações pra montar um filtro seguro, e torna "toda query direta filtra
// por officeId" uma regra mecânica e fácil de auditar/checar em code review.
//
// Ficam de fora, por enquanto: as 4 tabelas do robô Python (RoboPublicacao/RoboAndamento/
// RoboProcessoMonitorado/RoboExecucaoLog) continuam compartilhadas e keyadas por número de
// processo/OAB, não por officeId — a atribuição a cada escritório acontece depois, na ponte
// (lib/roboBridge.ts), casando por número de processo dentro de cada Office. O robô já
// descobre sozinho as OABs de TODOS os escritórios ativos (robo-publicacoes/src/config.py:
// carregar_oabs_do_banco), então a captura em si já é multi-tenant; o que falta é só o robô
// também aprender a marcar officeId nas próprias tabelas, caso um dia isso vire necessário
// (hoje a ponte já resolve sem precisar disso).
//
// Decisões de unicidade global x por escritório:
// - User.email: continua único GLOBALMENTE — é a chave de login/redefinição de senha em toda
//   a plataforma, um e-mail = uma conta = um escritório.
// - User.username: passa a ser único POR escritório (@@unique([officeId, username])) — é só um
//   apelido informal (usado em @menção), plausível de colidir entre escritórios diferentes.
// - GoogleCredential.accountEmail: continua único GLOBALMENTE — a mesma conta Google não pode
//   estar conectada como Drive principal de dois escritórios ao mesmo tempo.
// - TaskTypePoints.type e BlogPost.slug: passam a ser únicos POR escritório.
model Office {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // identificador amigável, usado em URL/subdomínio
  // ATIVA | SUSPENSA | CANCELADA — enforçado em lib/currentUser.ts: usuário comum de um
  // escritório não-ATIVA não consegue usar o sistema (tela de aviso), exceto platform owners
  // (ver User.isPlatformOwner), que sempre passam — precisam poder entrar pra resolver o
  // motivo do bloqueio junto com o dono do escritório bloqueado.
  status    String   @default("ATIVA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Escritório dono da plataforma (Rodarte Prado) — não aparece no Painel Mestre como cliente
  // de cobrança, não tem fatura gerada, nunca é bloqueado por inadimplência.
  isInternal Boolean @default(false)

  // Cobrança — preenchidos ao cadastrar o escritório no Painel Mestre (isPlatformOwner only).
  billingEmail  String? // recebe o boleto de cada fatura gerada
  monthlyFee    Float? // mensalidade combinada em contrato
  billingDueDay Int? // dia do mês de vencimento (1-28, pra não cair em mês sem o dia)
  // CPF ou CNPJ do escritório-cliente — a Asaas exige esse dado no cliente pra emitir boleto ou
  // Pix QR Code de verdade (rejeita a cobrança sem isso, mesmo com o "customer" já criado).
  cnpj          String?

  // Dias corridos de tolerância após o vencimento antes do bloqueio automático (usado pelo
  // cron de cobrança, lib/actions/billing.ts:runBillingCycle) — por escritório, pra dar
  // flexibilidade caso algum cliente específico precise de mais ou menos prazo.
  paymentGraceDays Int @default(30)

  // Módulos habilitados por contrato — controla o que aparece na navegação e o que os Server
  // Actions de cada módulo aceitam fazer (checado nos dois lugares, não só escondido na tela).
  // Desligar um módulo NUNCA apaga dados já existentes, só impede a criação de dados novos e
  // esconde a navegação — permite religar sem perda caso o contrato mude depois.
  moduloFinanceiro  Boolean @default(true)
  moduloWhatsapp    Boolean @default(true)
  moduloAtendimento Boolean @default(true)
  moduloAssessoria  Boolean @default(true)

  // Provedor de armazenamento de anexos (Processos/Atendimentos/Assessoria) escolhido por este
  // escritório — "GOOGLE_DRIVE" | "ONEDRIVE" | "DROPBOX" (texto livre, mesmo padrão do resto do
  // schema, sem enum do Prisma). Default GOOGLE_DRIVE preserva o comportamento de todo
  // escritório já existente sem nenhuma ação da parte deles — só passa a valer ONEDRIVE/DROPBOX
  // se o escritório escolher isso explicitamente em Configurações (ver
  // lib/actions/settings.ts:setStorageProvider) e conectar a conta correspondente como
  // armazenamento (ver lib/oneDriveStorage.ts / lib/dropboxStorage.ts).
  storageProvider String @default("GOOGLE_DRIVE")

  // Diferente dos módulos acima (contratáveis, autosserviço do próprio escritório em
  // Configurações), o Blog Jurídico público é um recurso da PLATAFORMA: só o escritório dono
  // (Rodarte Prado) produz/edita/aprova matérias, ou quem ele conceder acesso no futuro — não
  // tem toggle de autosserviço. Default true só beneficia o escritório pré-existente no banco
  // (Rodarte Prado); todo Office novo criado via /cadastro recebe false explicitamente (ver
  // lib/actions/signup.ts).
  blogAccess Boolean @default(true)

  // Como o escritório quer que funcione o acesso do suporte da Lúmen. AUTO = liberado na hora,
  // mas sempre com registro, prazo e faixa visível. APROVACAO = exige que um sócio do
  // escritório libere antes (tela do lado do cliente entra no Passo 3). Nasce AUTO para não
  // travar o suporte antes de existir onde aprovar.
  supportAccessPolicy String @default("AUTO") // AUTO | APROVACAO

  users                User[]
  notices              Notice[]
  loginSessions        LoginSession[]
  clients              Client[]
  lawyers              Lawyer[]
  suppliers            Supplier[]
  cases                Case[]
  kanbanColumns        KanbanColumn[]
  tasks                Task[]
  taskTypePoints       TaskTypePoints[]
  workflowTemplates    WorkflowTemplate[]
  workflowSteps        WorkflowStep[]
  comments             Comment[]
  mentions             Mention[]
  attendances          Attendance[]
  whatsappMessages     WhatsappMessage[]
  emailMessages        EmailMessage[]
  attachments          Attachment[]
  documentTemplates    DocumentTemplate[]
  deletionRequests     DeletionRequest[]
  googleCredentials    GoogleCredential[]
  microsoftCredentials MicrosoftCredential[]
  financialCategories  FinancialCategory[]
  costCenters          CostCenter[]
  payables             Payable[]
  receivables          Receivable[]
  recurringFees        RecurringFee[]
  assessorias          Assessoria[]
  assessoriaDocumentos AssessoriaDocumento[]
  honorarios           Honorario[]
  licitacoes           Licitacao[]
  publications         Publication[]
  blogPosts            BlogPost[]
  photos               Photo[]
  whatsappConfig       WhatsappConfig?
  dropboxCredential    DropboxCredential?
  invoices             TenantInvoice[]

  // ---- Lúmen (Passo 1 — fundação de dados, ainda não lida por nenhuma tela) ----
  subscription   Subscription?
  usage          TenantUsage[]
  supportTickets SupportTicket[]
  accessRequests AccessRequest[]
  accessAudit    AccessAuditLog[]

  driveSyncIssues       DriveSyncIssue[]
  blockedProcessNumbers BlockedProcessNumber[]
  alertDismissals       AlertDismissal[]

  // Setor de Processos Administrativos (fundação) — ver models TermoVigilancia e
  // FonteAdministrativa mais abaixo.
  termosVigilancia      TermoVigilancia[]
  fontesAdministrativas FonteAdministrativa[]

  // Fase 2 do Setor de Processos Administrativos — ver model RoboDouItem mais abaixo.
  roboDouItens RoboDouItem[]

  // Protocolos dos processos deste escritório — ver model ProtocoloLote mais abaixo.
  protocoloLotes ProtocoloLote[]

  // Lançamentos de honorários deste escritório — ver model HonorarioLancamento mais abaixo.
  honorarioLancamentos HonorarioLancamento[]

  // Fundação de dados do financeiro avançado (Fase 1 — dinheiro/percentual/parcelamento
  // editável/apuração do êxito), ainda dormente: nenhuma tela lê estes três abaixo.
  bankAccounts    BankAccount[]
  holidays        Holiday[]
  financePayments FinancePayment[]

  // Pendências do Atendimento (Fase 5) — ver model AtendimentoPendencia mais abaixo.
  atendimentoPendencias AtendimentoPendencia[]
}

// ============ EQUIPE ============

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  username      String?
  passwordHash  String?
  role          String   @default("Advogado") // Advogado, Estagiário, Financeiro, Admin
  oab           String?
  phone         String?
  color         String   @default("#0f1f3d") // cor de identificação em cards/agenda
  isAdmin       Boolean  @default(false) // sócios/donos do escritório: aprovam exclusões, gerenciam equipe e acesso ao financeiro
  financeAccess Boolean  @default(false) // controla visibilidade do módulo Financeiro; sócios sempre têm acesso independente deste campo
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Dono(a) da PLATAFORMA Lúmen (Jairo e Rodrigo) — nada a ver com isAdmin (que é por
  // escritório). Só quem tem isPlatformOwner=true enxerga e acessa /painel-mestre, e só esse
  // flag permite "atuar como" outro escritório (ver lib/officeActing.ts) e ignora bloqueio de
  // Office.status. Setado manualmente no banco / via seed do próprio escritório interno,
  // nunca por autosserviço.
  isPlatformOwner Boolean @default(false)

  resetTokenHash   String?   @unique // hash SHA-256 do token de redefinição de senha (nunca o token puro)
  resetTokenExpiry DateTime?

  // Preferências de notificação push (app mobile) — cada uma liga/desliga um tipo de aviso,
  // configurável pelo próprio usuário em Configurações. Ligadas por padrão (opt-out, não
  // opt-in) para quem já ativou notificações neste aparelho continuar recebendo tudo até
  // decidir desligar algo específico.
  notifyAndamentos       Boolean @default(true)
  notifyPublicacoes      Boolean @default(true)
  notifyTarefasDelegadas Boolean @default(true)
  notifyAgendaDia        Boolean @default(true)
  notifyMencoes          Boolean @default(true)

  // Provedor escolhido explicitamente para o envio de e-mail no Atendimento — "GOOGLE" ou
  // "MICROSOFT". Sem essa escolha o envio fica desabilitado (erro claro), mesmo que a pessoa
  // tenha uma das duas contas conectada: conectar não habilita sozinho, é preciso escolher (ver
  // lib/gmailSend.ts) — evita mandar e-mail pela conta errada por engano.
  emailSendProvider String?

  // Meu Perfil — dados pessoais autoatendidos (cada pessoa edita os próprios, ver
  // lib/actions/profile.ts). photoUrl é o link privado do Vercel Blob, servido via
  // /api/perfil/foto/[userId] (mesmo padrão de lib/photos.ts para o blog).
  photoUrl      String?
  birthDate     DateTime?
  gender        String?
  maritalStatus String?
  cpf           String?
  rg            String?
  address       String?
  cep           String?
  city          String?
  state         String?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  pushSubscriptions           PushSubscription[]
  tasksResponsible            Task[]                 @relation("TaskResponsible")
  tasksDelegated              Task[]                 @relation("TaskDelegatedBy")
  casesResponsible            Case[]                 @relation("CaseResponsible")
  comments                    Comment[]
  mentions                    Mention[]
  publicationReads            PublicationRead[]
  attendances                 Attendance[]           @relation("AttendanceResponsible")
  attachments                 Attachment[]
  documentTemplates           DocumentTemplate[]
  deletionRequested           DeletionRequest[]      @relation("DeletionRequestedBy")
  deletionResolved            DeletionRequest[]      @relation("DeletionResolvedBy")
  loginSessions               LoginSession[]
  notices                     Notice[]
  publicationsAssigned        Publication[]          @relation("PublicationAssignee")
  googleCredentials           GoogleCredential[]
  microsoftCredentials        MicrosoftCredential[]
  blogPostsReviewed           BlogPost[]             @relation("BlogPostReviewer")
  emailsSent                  EmailMessage[]         @relation("EmailMessageSentBy")
  assessoriasResponsible      Assessoria[]           @relation("AssessoriaResponsible")
  assessoriaDocumentsUploaded AssessoriaDocumento[]  @relation("AssessoriaDocumentoUploadedBy")
  blockedProcessNumbers       BlockedProcessNumber[]
  alertDismissals             AlertDismissal[]

  // Termos de vigilância que este usuário cadastrou (ver model TermoVigilancia mais abaixo) —
  // só para exibir "criado por" na tela, não afeta quem enxerga o termo (isso é por officeId).
  termosVigilanciaCriados TermoVigilancia[]

  // Protocolos que esta pessoa montou e os que ela registrou como protocolados — dois papéis
  // distintos de propósito: quem prepara o lote muitas vezes não é quem envia ao tribunal.
  protocoloLotesCriados      ProtocoloLote[] @relation("ProtocoloLoteCriadoPor")
  protocoloLotesProtocolados ProtocoloLote[] @relation("ProtocoloLoteProtocoladoPor")

  // Lúmen (Passo 1) — capacidade de plataforma, separada de isPlatformOwner (ver PlatformMember).
  platformMember PlatformMember?

  // Fundação de dados do financeiro avançado (Fase 1), ainda dormente — quem lançou a conta
  // (responsibleId de Payable/Receivable/HonorarioLancamento), quem apurou o valor real de uma
  // parcela percentual (Receivable.apuradoPorId) e quem registrou um recebimento/pagamento
  // parcial (FinancePayment.createdById). Papéis distintos entre si de propósito: quem lança a
  // conta muitas vezes não é quem depois dá baixa ou apura o êxito.
  payablesResponsible            Payable[]             @relation("PayableResponsible")
  receivablesResponsible         Receivable[]          @relation("ReceivableResponsible")
  receivablesApuradas            Receivable[]          @relation("ReceivableApuradoPor")
  honorarioLancamentosResponsible HonorarioLancamento[] @relation("HonorarioLancamentoResponsible")
  financePayments                FinancePayment[]

  // Pendências do Atendimento (Fase 5) atribuídas a esta pessoa como responsável — ver model
  // AtendimentoPendencia mais abaixo.
  atendimentoPendenciasResponsible AtendimentoPendencia[] @relation("AtendimentoPendenciaResponsible")

  @@unique([officeId, username])
}

// Uma inscrição de push por aparelho/navegador em que o usuário ativou notificações
// (ver components/mobile/NotificationPreferences.tsx) — um mesmo usuário pode ter mais de
// uma (celular + tablet, por exemplo). endpoint é o identificador único que o navegador
// gera; p256dh/auth são as chaves de criptografia exigidas pelo protocolo Web Push.
// Sem officeId próprio — sempre acessada através do userId (nunca listada direto por escritório).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ MURAL DE RECADOS ============

model Notice {
  id        String   @id @default(cuid())
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

// ============ TIMESHEET (sessões de login) ============

model LoginSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  loginAt    DateTime @default(now())
  lastPingAt DateTime @default(now())
  createdAt  DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId, userId, loginAt])
}

// ============ CONTATOS ============

model Client {
  id            String   @id @default(cuid())
  name          String
  type          String   @default("PF") // PF | PJ
  document      String?
  rg            String?
  nationality   String?
  maritalStatus String?
  profession    String?
  email         String?
  phone         String?
  address       String?
  notes         String?
  createdAt     DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  cases                Case[]
  caseLinks            CaseClient[]
  receivables          Receivable[]
  honorarioLancamentos HonorarioLancamento[]
  publications         Publication[]
  attendances          Attendance[]          @relation("AttendanceClient")
  assessoria           Assessoria?

  // Termos de vigilância (Radar de Publicações Administrativas) vigiando o nome deste cliente,
  // independente de já haver um processo aberto — ver model TermoVigilancia mais abaixo.
  termosVigilancia TermoVigilancia[]

  @@index([officeId])
}

model Lawyer {
  id        String   @id @default(cuid())
  name      String
  oab       String?
  firm      String?
  side      String   @default("PARCEIRO") // PARCEIRO | ADVERSO
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  document  String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  payables Payable[]

  @@index([officeId])
}

// ============ CASOS / CARDS ============

model Case {
  id            String  @id @default(cuid())
  title         String
  type          String  @default("JUDICIAL") // JUDICIAL | ADMINISTRATIVO | EXTRAJUDICIAL | ATENDIMENTO | CONSULTIVO
  area          String?
  secondaryArea String?
  status        String  @default("ATIVO") // ATIVO | SUSPENSO | ENCERRADO | ARQUIVADO
  folder        String?
  processNumber String?
  court         String?
  forum         String?
  tribunal      String? // Sigla do tribunal (ex: TJGO, TRF1, TST) — órfão, sem uso em nenhuma
  // tela (confirmado por grep); mantido como está, não usar nem remover.

  // Selecionados via lib/tribunaisCatalog.ts (components/TribunalPickerModal.tsx) no cadastro,
  // mas 100% independentes do catálogo depois disso — livremente editáveis no Processo, sem
  // nenhuma referência de volta a um Tribunal.id. É por isso que não há relation aqui: mudar o
  // catálogo no futuro nunca deve alterar um Processo já cadastrado.
  tribunalSigla   String?
  tribunalNome    String?
  tribunalSistema String?
  tribunalLink    String?

  caseValue           Float?
  convictionValue     Float?
  // "Proveito econômico" — base alternativa de cálculo de honorário percentual (ver
  // HonorarioLancamento.percentualBase), ao lado de caseValue (valor da causa) e
  // convictionValue (valor da condenação). Puramente informativo até que uma parcela
  // percentual referencie esta base no cálculo do valor estimado da parcela.
  economicBenefitValue Float?
  // "Valor do acordo" — quarta base de cálculo de honorário percentual (ver
  // Receivable.percentualBase), ao lado de caseValue/economicBenefitValue/convictionValue acima.
  // Só costuma ser preenchido quando o processo termina em acordo homologado, em vez de sentença/
  // condenação — as demais bases continuam existindo em paralelo (um caso pode ter as quatro
  // preenchidas ao longo do tempo; qual delas vale para uma parcela específica é escolha de quem
  // lança o honorário, não automática).
  agreementValue Float?
  instance        String? // Instância Original
  currentInstance String? // Instância Atual
  distributedAt   DateTime?
  closedAt        DateTime?
  description     String?
  clientRole      String? // papel do NOSSO cliente: Autor, Réu, Interessado, Recorrente, Recorrido...
  actionType      String? // Ação (ex: Execução Fiscal)

  // Só preenchidos quando type = "ADMINISTRATIVO" — permitem filtrar a lista por esfera e
  // por matéria sem precisar olhar o órgão. Ficam nulos em processo judicial.
  adminEsfera  String? // FEDERAL | ESTADUAL | MUNICIPAL
  adminMateria String? // CONTAS | TRIBUTARIO | LICITACAO | DISCIPLINAR | REGULATORIO | AMBIENTAL | PREVIDENCIARIO | OUTRO

  decision        String?
  outcome         String?
  tags            String?
  sourceUrl       String?
  lastHistoryAt   DateTime?
  lastHistoryDesc String?

  opposingPartyName     String? // nome da parte adversa (cadastro simplificado, só texto)
  opposingPartyRole     String? // AUTOR | REU | OUTRO — polo da parte adversa
  opposingPartyDocument String? // CPF/CNPJ da parte adversa (opcional)
  opposingPartyAddress  String? // endereço da parte adversa (opcional)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  responsibleId String?
  responsible   User?   @relation("CaseResponsible", fields: [responsibleId], references: [id])

  // Vínculo explícito com uma Assessoria (opcional) — escolhido no cadastro do processo,
  // para importar este caso diretamente para dentro do acompanhamento daquela assessoria.
  // Independente do clientId: o mesmo cliente pode ter processos que não fazem parte do
  // contrato de assessoria continuada.
  assessoriaId String?
  assessoria   Assessoria? @relation(fields: [assessoriaId], references: [id])

  // Pasta própria deste processo no Drive (Processos/{title}), criada sob demanda no primeiro
  // anexo — ver lib/googleDrive.ts, getOrCreateCaseFolder. Ao converter um Atendimento neste
  // Case, herda a MESMA pasta do atendimento (só renomeada), não cria outra.
  driveFolderId String?

  tasks                    Task[]
  comments                 Comment[]
  receivables              Receivable[]
  recurringFees            RecurringFee[]
  payables                 Payable[]
  publications             Publication[]
  attachments              Attachment[]
  convertedFromAttendances Attendance[]          @relation("AttendanceConvertedCase")
  assessoriaDocumentos     AssessoriaDocumento[]
  driveSyncIssues          DriveSyncIssue[]

  // Litisconsórcio: clientId/opposingParty* acima seguem existindo e sempre espelham o primeiro
  // cliente/parte cadastrado (compat com título "Cliente x Parte Adversa", geração de documentos
  // e qualquer leitura antiga que não olhe para as duas listas abaixo). clients/parties é onde
  // vive o cadastro completo quando há mais de um autor/réu — um processo sem litisconsórcio tem
  // só uma linha em cada uma, espelhando os campos legados.
  clients CaseClient[]
  parties CaseParty[]

  // Termos de vigilância (Radar de Publicações Administrativas) ligados a este processo — ver
  // model TermoVigilancia mais abaixo.
  termosVigilancia TermoVigilancia[]

  // Protocolos deste processo (aba Protocolos) — ver model ProtocoloLote mais abaixo.
  protocoloLotes ProtocoloLote[]

  // Lançamentos de honorários (aba Financeiro) — ver model HonorarioLancamento mais abaixo.
  honorarioLancamentos HonorarioLancamento[]

  @@index([officeId])
  @@index([officeId, processNumber])
}

// Um dos nossos clientes vinculados a um processo — existe em paralelo a Case.clientId (que
// sempre aponta para o primeiro CaseClient criado) para não quebrar nada que ainda só leia o
// campo legado; a lista completa (litisconsórcio ativo) só está aqui.
model CaseClient {
  id        String   @id @default(cuid())
  role      String? // Autor | Réu | Terceiro Interessado | Recorrente | Recorrido | Outro
  createdAt DateTime @default(now())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  @@unique([caseId, clientId])
  @@index([caseId])
  @@index([clientId])
}

// Parte do lado de fora do escritório: parte adversa ou terceiro interessado. Substitui em
// paralelo os 4 campos opposingParty* de Case (mesma relação de compatibilidade do CaseClient
// acima) — não é um Client cadastrado, só um registro textual simples ligado ao processo.
model CaseParty {
  id        String   @id @default(cuid())
  name      String
  document  String?
  address   String?
  role      String   @default("OUTRO") // AUTOR | REU | TERCEIRO_INTERESSADO | OUTRO
  createdAt DateTime @default(now())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ============ CATÁLOGO DE TRIBUNAIS ============

// Catálogo de tribunais brasileiros — dado de referência global, compartilhado por todos os
// escritórios (não é multi-tenant: um TJGO é o mesmo TJGO para qualquer escritório). Populado
// uma vez pelo endpoint idempotente /api/admin/setup-tribunais, a partir de
// lib/tribunaisCatalog.ts. As telas nunca escrevem aqui — só leem para alimentar o seletor.
model Tribunal {
  id        String   @id @default(cuid())
  sigla     String   @unique
  nome      String
  categoria String // agrupamento de exibição no seletor — ver CATEGORIA_ORDER em lib/tribunaisCatalog.ts
  sistemas  String // texto descritivo do(s) sistema(s) processual(is)
  portalUrl String // link de acesso ao sistema (login/consulta de processos)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())

  natureza String @default("JUDICIAL") // JUDICIAL | ADMINISTRATIVO — o mesmo catálogo serve
  // aos dois seletores; o picker filtra por natureza.
}

// ============ AGENDA + KANBAN (fonte única: Task) ============

model KanbanColumn {
  id        String  @id @default(cuid())
  name      String
  order     Int     @default(0)
  color     String  @default("#94a3b8")
  isDoneCol Boolean @default(false)

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  tasks Task[]

  @@index([officeId])
}

model Task {
  id            String    @id @default(cuid())
  title         String
  type          String    @default("TAREFA") // TAREFA | EVENTO | AUDIENCIA | PERICIA | PRAZO
  description   String?
  dueDate       DateTime
  dueTime       String?
  // Prazo de segurança: calculado automaticamente como 24h antes do dueDate ("prazo fatal") —
  // hoje só preenchido por delegateTask (lib/actions/tasks.ts). Aparece na Agenda como um
  // segundo evento, em cor distinta, no dia anterior ao prazo fatal.
  safetyDueDate DateTime?
  priority      String    @default("MEDIA") // BAIXA | MEDIA | ALTA | URGENTE
  status        String    @default("PENDENTE") // PENDENTE | EM_ANDAMENTO | CONCLUIDO | CANCELADO
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Reunião (quando type = EVENTO ou AUDIENCIA)
  meetingType String? // PRESENCIAL | ONLINE
  location    String?
  meetingUrl  String?
  // Estratégia da audiência (quando type = AUDIENCIA): anotações de preparo, teses e pontos de
  // atenção — só faz sentido nesse tipo, mas fica solto como os demais campos situacionais acima.
  strategy    String?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])

  publicationId String?
  publication   Publication? @relation(fields: [publicationId], references: [id])

  licitacaoId String?
  licitacao   Licitacao? @relation(fields: [licitacaoId], references: [id])

  responsibleId String?
  responsible   User?   @relation("TaskResponsible", fields: [responsibleId], references: [id])

  // Delegação: quando preenchido, indica que a tarefa foi atribuída por outra pessoa
  // (não criada pelo próprio responsável) — usado para gerar alerta/notificação só
  // para quem recebeu, até que ela seja aberta (delegationAcknowledgedAt).
  delegatedById            String?
  delegatedBy              User?     @relation("TaskDelegatedBy", fields: [delegatedById], references: [id])
  delegationAcknowledgedAt DateTime?

  columnId    String?
  column      KanbanColumn? @relation(fields: [columnId], references: [id])
  columnOrder Int           @default(0)

  points Int @default(0) // TaskScore: pontuação de produtividade da tarefa

  comments Comment[]

  @@index([officeId])
  @@index([officeId, dueDate])
}

// ============ TASKSCORE (pontuação de produtividade por tipo de tarefa) ============

model TaskTypePoints {
  id     String @id @default(cuid())
  type   String // TAREFA | EVENTO | AUDIENCIA | PERICIA | PRAZO
  points Int    @default(10)

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@unique([officeId, type])
}

// ============ WORKFLOWS (cadeias padronizadas de tarefas) ============

model WorkflowTemplate {
  id          String   @id @default(cuid())
  name        String
  area        String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  steps WorkflowStep[]

  @@index([officeId])
}

model WorkflowStep {
  id         String  @id @default(cuid())
  order      Int     @default(0)
  title      String
  taskType   String  @default("TAREFA") // TAREFA | EVENTO | AUDIENCIA | PERICIA | PRAZO
  offsetDays Int     @default(0) // dias após a aplicação do workflow
  priority   String  @default("MEDIA") // BAIXA | MEDIA | ALTA | URGENTE
  role       String? // cargo sugerido do responsável (Advogado, Estagiário, etc.)
  points     Int? // pontuação opcional; se nula usa o padrão do tipo

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  templateId String
  template   WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  mentions Mention[]

  @@index([officeId])
}

model Mention {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId, userId, read])
}

// ============ ATENDIMENTO (setor de atendimento / triagem) ============

model Attendance {
  id           String   @id @default(cuid())
  clientName   String
  contact      String? // legado: telefone/e-mail juntos em texto livre (formulários antigos, mantido sem migração destrutiva)
  contactPhone String? // telefone do contato, separado do e-mail (clientEmail abaixo)
  subject      String
  area         String? // matéria
  description  String? // descrição detalhada do que precisa
  channel      String   @default("WHATSAPP") // WHATSAPP | EMAIL | TELEFONE | PRESENCIAL
  status       String   @default("NOVO") // NOVO | EM_TRIAGEM | CONVERTIDO | ARQUIVADO | RASCUNHO
  notes        String?
  createdAt    DateTime @default(now())

  // Funil comercial (CRM de captação) — eixo independente do status operacional acima
  stage          String    @default("NOVO") // NOVO | QUALIFICACAO | PROPOSTA | FECHADO | PERDIDO
  estimatedValue Float? // valor estimado do contrato — dobra de "valor em dinheiro" do honorário
  // pretendido (feeMode abaixo) quando ele inclui DINHEIRO, para não duplicar o mesmo número em
  // dois campos.
  leadSource     String? // INDICACAO | INSTAGRAM | GOOGLE | SITE | WHATSAPP | OUTRO
  // Preenchido (obrigatoriamente, a partir da Fase 5) ao mover para PERDIDO — opções fechadas em
  // components/AttendanceLostReasonModal.tsx (Preço | Prazo | Escolheu outro escritório | Desistiu
  // da ação | Sem resposta | Fora da nossa área | Outro: <texto livre>). Alimenta o relatório de
  // captação — por isso nunca mais fica nulo depois que o estágio vira PERDIDO uma vez.
  lostReason     String?
  nextContactAt  DateTime? // data do próximo contato/follow-up
  stageChangedAt DateTime? // quando o estágio comercial mudou pela última vez

  // Honorário PRETENDIDO (Fase 5) — forma de cobrança que o advogado pretende propor ao lead,
  // capturada já na triagem para não ser redigitada na conversão em Processo (ver
  // convertAttendanceToCase, lib/actions/attendance.ts, que usa estes 3 campos + estimatedValue
  // acima só para PRÉ-PREENCHER o Lançar Honorários do processo novo — nunca cria a cobrança
  // sozinho, o advogado sempre confirma). Mesmo vocabulário do financeiro (ver
  // lib/honorarioLancamento.ts) para não inventar um segundo dicionário de termos.
  feeMode           String? // DINHEIRO | PERCENTUAL | AMBOS
  feePercentual     Float? // % pretendido, só relevante quando feeMode inclui PERCENTUAL
  feePercentualBase String? // VALOR_CAUSA | PROVEITO_ECONOMICO | CONDENACAO | ACORDO

  // Prazo de resposta ao lead (Fase 5) — "lead sem retorno é lead perdido". Default 24h após a
  // criação (calculado no client, ver NewAttendanceModal.tsx), editável na janela de criação.
  // firstResponseAt é carimbado sozinho no primeiro e-mail/WhatsApp enviado deste atendimento (ver
  // replyWhatsapp/replyEmail abaixo) ou manualmente via markAttendanceResponded, para quando a
  // resposta saiu por um canal que o sistema não rastreia (telefone, presencial). Alerta na
  // Central quando responseDeadline estoura sem firstResponseAt (ver lib/alerts.ts).
  responseDeadline DateTime?
  firstResponseAt  DateTime?

  // Integração WhatsApp (Cloud API oficial da Meta) — número/credenciais por escritório (Fase 2)
  waPhone         String? // telefone do cliente no WhatsApp (E.164), usado como chave de conversa
  waLastMessageAt DateTime? // instante da última mensagem trocada nesta conversa

  // Integração E-mail (resposta via Gmail da conta Google do próprio advogado)
  // Reaproveitado também como e-mail do contato no formulário de criação do atendimento.
  clientEmail String? // e-mail do cliente para resposta; preenchido manualmente na tela

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // Vínculo com cadastro de Client — preenchido ao selecionar um cliente já cadastrado
  // na busca, ou automaticamente após "Cadastrar novo cliente" ser finalizado (não em rascunho).
  clientId String?
  client   Client? @relation("AttendanceClient", fields: [clientId], references: [id])

  responsibleId String?
  responsible   User?   @relation("AttendanceResponsible", fields: [responsibleId], references: [id])

  convertedCaseId String?
  convertedCase   Case?   @relation("AttendanceConvertedCase", fields: [convertedCaseId], references: [id])

  // Mesmo vínculo opcional com Assessoria disponível no cadastro de Processo (ver Case.assessoriaId).
  assessoriaId String?
  assessoria   Assessoria? @relation(fields: [assessoriaId], references: [id])

  // Pasta própria deste atendimento no Drive (Atendimentos/{subject}), criada sob demanda no
  // primeiro anexo (ver lib/googleDrive.ts, getOrCreateAttendanceFolder). Se o atendimento virar
  // Processo (convertAttendanceToCase), a pasta é só renomeada e transferida pro Case — nunca
  // duplicada.
  driveFolderId String?

  tasks            Task[]
  attachments      Attachment[]
  whatsappMessages WhatsappMessage[]
  emailMessages    EmailMessage[]
  driveSyncIssues  DriveSyncIssue[]
  pendencias       AtendimentoPendencia[]

  @@index([officeId])
  @@index([officeId, waPhone])
}

// ============ PENDÊNCIAS DO ATENDIMENTO (Fase 5) ============

// O que falta para fechar o atendimento, nas duas direções: pedir algo AO lead (SOLICITAR) ou
// mandar algo PARA o lead (ENVIAR) — ver lib/pendencias.ts para o vocabulário fechado de `kind`
// por direção. Fecha sozinha (status CONCLUIDA + completedAt) quando um anexo do tipo de documento
// correspondente é registrado neste atendimento (só para os 3 casos com correspondência 1:1 no
// catálogo — ver DOC_TYPE_TO_PENDENCIA_ENVIAR); o resto se fecha à mão na tela do atendimento.
// Aparece em aberto na tela de detalhe do atendimento e na Central de Alertas (com o prazo) quando
// vencida — ver lib/alerts.ts.
model AtendimentoPendencia {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  direction String // SOLICITAR | ENVIAR
  kind      String // ver lib/pendencias.ts (SOLICITAR_KIND_OPTIONS / ENVIAR_KIND_OPTIONS)
  // "Quais?" — só preenchido/exigido para os kinds que pedem descrição livre (Documentos,
  // Informações, Outros — ver pendenciaKindNeedsDescription em lib/pendencias.ts).
  description String?
  status      String     @default("PENDENTE") // PENDENTE | CONCLUIDA
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  responsibleId String?
  responsible   User?   @relation("AtendimentoPendenciaResponsible", fields: [responsibleId], references: [id])

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId])
  @@index([attendanceId])
}

// ============ WHATSAPP (mensagens da integração com a Cloud API da Meta) ============

model WhatsappMessage {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  direction    String // "IN" (do cliente) | "OUT" (do escritório)
  body         String
  waMessageId  String?    @unique // id da mensagem na Meta (dedupe)
  status       String     @default("RECEIVED") // RECEIVED | SENT | FAILED
  fromNumber   String? // telefone do cliente (E.164)
  createdAt    DateTime   @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId, attendanceId, createdAt])
}

// ============ E-MAIL (resposta ao cliente via Gmail da conta Google do próprio advogado) ============

model EmailMessage {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  direction    String // "OUT" (por enquanto só enviamos, não há ingestão de e-mail recebido nesse fluxo)
  toAddress    String
  fromAddress  String
  subject      String
  body         String
  sentByUserId String?
  sentByUser   User?      @relation("EmailMessageSentBy", fields: [sentByUserId], references: [id])
  status       String     @default("SENT") // SENT | FAILED
  errorMessage String?
  createdAt    DateTime   @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId, attendanceId, createdAt])
}

// ============ ANEXOS (referência ao repositório de arquivos conectado — Drive/OneDrive/etc.) ============

model Attachment {
  id        String   @id @default(cuid())
  name      String
  driveUrl  String
  docType   String   @default("OUTRO") // ver lib/documentTypes.ts
  createdAt DateTime @default(now())

  // Provedor e id do arquivo usados no upload — "GOOGLE_DRIVE" | "ONEDRIVE" (default preserva o
  // comportamento de todo anexo já existente, sempre Google). Gravado explicitamente desde esta
  // entrega para a exclusão (lib/actions/attachments.ts:deleteAttachment) não precisar mais
  // adivinhar o id do arquivo por regex na URL (extractDriveFileId) — isso não escala para um
  // segundo provedor com formato de URL diferente. Registros anteriores a esta entrega ficam com
  // storageFileId nulo e continuam sendo apagados pelo caminho antigo (regex + sempre Google, já
  // que não existiam outros provedores quando foram criados).
  storageProvider String  @default("GOOGLE_DRIVE")
  storageFileId   String?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])

  // Protocolos que REFERENCIAM este anexo (ver ProtocoloLoteItem) e protocolos dos quais este
  // anexo é o comprovante. Um mesmo documento pode entrar em vários protocolos sem nunca ser
  // copiado — é essa relação, e não uma cópia de arquivo, que compõe um protocolo.
  protocoloItens         ProtocoloLoteItem[] @relation("ProtocoloLoteItemAttachment")
  protocoloComprovanteDe ProtocoloLote[]     @relation("ProtocoloLoteComprovante")

  @@index([officeId])
}

// ============ PROTOCOLOS (aba Protocolos do Processo) ============

// Um protocolo do processo: a lista ordenada de documentos enviados (ou a enviar) ao tribunal/
// órgão, mais número, data e comprovante. NUNCA guarda arquivo — só referências a Attachment
// (ver ProtocoloLoteItem). É essa decisão que impede duplicar documento: o arquivo continua
// existindo uma única vez, na subpasta do tipo dele, e o protocolo só aponta para ele.
model ProtocoloLote {
  id         String  @id @default(cuid())
  titulo     String
  // EM_PREPARO | PRONTO | PROTOCOLADO | CANCELADO — ver PROTOCOLO_STATUS em lib/protocolos.ts.
  status     String  @default("EM_PREPARO")
  observacao String?

  // Só preenchidos quando o lote vira PROTOCOLADO.
  numeroProtocolo  String?
  protocoladoEm    DateTime?
  protocoladoPorId String?
  protocoladoPor   User?     @relation("ProtocoloLoteProtocoladoPor", fields: [protocoladoPorId], references: [id])

  // Pasta-espelho no Drive contendo APENAS atalhos para os documentos originais (Google Drive;
  // OneDrive/Dropbox não têm atalho equivalente e ficam sem pasta, sem perder funcionalidade —
  // o site é a fonte da verdade). Criada sob demanda, nula até alguém pedir; apagada inteira
  // quando o lote é cancelado, o que é seguro justamente por só conter atalhos.
  driveFolderId String?

  // O comprovante é o ÚNICO arquivo novo que um protocolo cria — e entra como Attachment comum
  // (docType COMPROVANTE_PROTOCOLO), na subpasta do tipo dele, como qualquer outro anexo.
  comprovanteId String?
  comprovante   Attachment? @relation("ProtocoloLoteComprovante", fields: [comprovanteId], references: [id], onDelete: SetNull)

  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  criadoPorId String?
  criadoPor   User?   @relation("ProtocoloLoteCriadoPor", fields: [criadoPorId], references: [id])

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  itens ProtocoloLoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId])
  @@index([caseId])
}

// Uma linha da lista de um protocolo: a ordem + o anexo referenciado.
//
// nomeSnapshot/docTypeSnapshot são cópia do nome e do tipo no momento em que o documento entrou
// no protocolo — de propósito. Um protocolo concluído é registro histórico: se alguém excluir o
// anexo depois (confirmando o aviso de deleteAttachment), attachmentId fica nulo (onDelete:
// SetNull) mas a linha permanece, mostrando o que foi protocolado e que o arquivo não existe
// mais. Sem isso, um histórico de protocolo perderia linhas em silêncio.
model ProtocoloLoteItem {
  id    String @id @default(cuid())
  ordem Int

  loteId String
  lote   ProtocoloLote @relation(fields: [loteId], references: [id], onDelete: Cascade)

  attachmentId String?
  attachment   Attachment? @relation("ProtocoloLoteItemAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)

  nomeSnapshot    String
  docTypeSnapshot String

  // Id do atalho criado no Drive para este item (Google Drive). Guardado para conseguir apagar
  // exatamente este atalho ao remover o documento do lote, sem varrer a pasta procurando por nome.
  driveShortcutId String?

  @@unique([loteId, attachmentId])
  @@index([loteId])
}

// Cabeçalho de um lançamento de honorários "parcelado" (aba Financeiro do Processo) — agrupa as
// Receivable geradas por ele (Receivable.honorarioLancamentoId) e guarda o valor total indicado
// no momento da criação, para a nota de divergência mostrada ao editar as parcelas (ver
// lib/actions/honorarios.ts, updateHonorarioLancamentoParcelas): soma o amount de toda parcela
// com vinculadoAoTotal=true e compara com valorTotalIndicado. Um honorário "único" (não
// parcelado) não passa por aqui — vira uma Receivable solta, com honorarioLancamentoId nulo,
// exatamente como antes.
model HonorarioLancamento {
  id                 String  @id @default(cuid())
  // Total declarado pelo usuário ao criar o parcelamento (ex.: 5.000,00 no exemplo entrada +
  // êxito) — nunca recalculado sozinho depois; só serve de referência para a nota de
  // divergência. Nulo quando o próprio lançamento já nasce só com parcela(s) percentual(is)
  // sem nenhum valor total declarado.
  valorTotalIndicado Float?
  kind               String  @default("HONORARIOS_CONTRATUAIS") // mesmo catálogo de Receivable.kind (ver comentário lá, inclui HONORARIOS_ACORDO desde a Fase 9)

  createdAt DateTime @default(now())

  // ---- Fase 1 (fundação de dados, ainda dormente) — mesmo par documentType/documentNumber/
  // issueDate/responsibleId/payerType/payerName de Receivable/Payable, aqui no CABEÇALHO do
  // parcelamento (as parcelas individuais têm os seus próprios, quando divergirem do cabeçalho).
  documentType   String?
  documentNumber String?
  issueDate      DateTime?
  responsibleId  String?
  responsible    User?     @relation("HonorarioLancamentoResponsible", fields: [responsibleId], references: [id])
  payerType      String    @default("CLIENTE") // CLIENTE | ADVERSA | OUTRO
  payerName      String?

  // "Encerrar sem êxito" — preserva o histórico do lançamento em vez de excluí-lo quando o
  // desfecho do processo não gera direito a honorário percentual (ex.: ação julgada
  // improcedente). encerradoMotivo é texto livre explicando o porquê, para quem olhar depois
  // entender a decisão sem precisar perguntar.
  encerradoEm     DateTime?
  encerradoMotivo String?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  categoryId String?
  category   FinancialCategory? @relation(fields: [categoryId], references: [id])

  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  parcelas Receivable[]

  @@index([officeId])
  @@index([caseId])
}

// Problema de estrutura encontrado no Drive pelo sync reverso (lib/driveSync.ts, cron diário
// app/api/cron/drive-sync/route.ts) — nasce de alguém salvando/renomeando algo direto no Drive
// (fora do app), fugindo da estrutura esperada ("Lúmen - Processos/{título}/{tipo de
// documento}"). O sync NUNCA move/renomeia/apaga nada sozinho quando não tem certeza — só
// registra aqui o que está errado e a correção exata, pra um sócio decidir e agir manualmente
// (ver Central de Alertas, kind DRIVE_INCONSISTENCIA em lib/alerts.ts, visível só a isAdmin).
// Uma linha por problema "ainda aberto"; resolvedAt marca quando o próprio sync deixou de
// detectá-lo numa rodada seguinte (pasta corrigida, arquivo movido, anexo re-registrado etc.) —
// nunca apagada, pra manter histórico de que existiu.
model DriveSyncIssue {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // Id no Drive do arquivo OU pasta que está com problema — junto com officeId+issueType forma
  // a chave usada pelo sync pra saber se um problema já detectado numa rodada anterior continua
  // valendo (atualiza) ou já sumiu (resolve), em vez de duplicar uma linha por dia.
  driveFileId String

  // PASTA_PROCESSO_SEM_CORRESPONDENCIA | PASTA_CATEGORIA_DESCONHECIDA |
  // ARQUIVO_SOLTO_SEM_CATEGORIA | ANEXO_SUMIU_DO_DRIVE — ver lib/driveSync.ts.
  // PASTA_PROCESSO_DUPLICADA_LEGADO_VS_NOVA — a migração de pastas legadas (raiz "RP Financeiro
  // - Processos" -> "Lúmen - Processos") achou, para um processo/atendimento, tanto a pasta
  // antiga quanto uma pasta homônima na raiz nova, AMBAS com conteúdo — não dá pra decidir
  // sozinho qual é a "certa" nem mesclar automaticamente sem risco de perder documento. Ver
  // lib/actions/driveFolderMigration.ts.
  // PASTA_ORFA_NA_RAIZ_LEGADA — pasta que ficou numa raiz ANTIGA do Drive e que nenhum
  // processo/atendimento aponta. O sync diário (lib/driveSync.ts) só varre a raiz nova, então
  // sem este alerta ela seguiria esquecida, com documento de cliente dentro. Idem.
  issueType String

  description  String // o que está errado, em linguagem simples
  suggestedFix String // a correção EXATA (ex: nome exato pra renomear a pasta) — vira o subtitle do alerta

  // Link direto pro arquivo/pasta no Drive, quando disponível (webViewLink da Drive API) — nem
  // sempre existe (ex: pasta raiz sem webViewLink retornado, ou pasta já removida entre a
  // detecção e a exibição do alerta).
  driveUrl String?

  // Processo/Atendimento já resolvido em cujo interior o problema foi encontrado (categoria com
  // nome errado, arquivo solto) — nulo quando o próprio problema É a pasta não corresponder a
  // nenhum processo/atendimento (PASTA_PROCESSO_SEM_CORRESPONDENCIA não tem um dos dois pra
  // apontar). Usado só para o alerta na Central de Alertas linkar direto pra página do
  // processo/atendimento em vez de cair no fallback genérico.
  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])

  detectedAt DateTime  @default(now())
  resolvedAt DateTime? // preenchido quando a rodada seguinte do sync deixa de encontrar o problema

  @@unique([officeId, driveFileId, issueType])
  @@index([officeId, resolvedAt])
}

// ============ MODELOS DE DOCUMENTO (contratos, procurações, declarações...) ============

model DocumentTemplate {
  id        String   @id @default(cuid())
  name      String // ex: "Contrato de honorários com pagamento de entrada + êxito"
  category  String // CONTRATO | PETICAO | PROCURACAO | DECLARACAO_HIPOSSUFICIENCIA | DECLARACAO_MORADIA | OUTRO
  driveUrl  String
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  @@index([officeId])
}

// ============ SOLICITAÇÕES DE EXCLUSÃO (aprovação de admin) ============

model DeletionRequest {
  id          String   @id @default(cuid())
  entityType  String // TASK | CASE | ATTENDANCE | PAYABLE | RECEIVABLE | HONORARIO_LANCAMENTO
  entityId    String
  entityLabel String // snapshot legível (título/nome) para exibir mesmo após excluir
  // ONLY | FOLLOWING | ALL — só preenchido para RECEIVABLE/PAYABLE pertencentes a um agrupamento
  // (parcelamento, honorário parcelado ou honorário recorrente; ver requestDeletionScoped em
  // lib/actions/deletion.ts). Nulo para os demais entityType e para RECEIVABLE/PAYABLE avulsos —
  // nesses casos a aprovação segue o fluxo antigo (performDelete), sem escopo nenhum.
  scope       String?
  status      String   @default("PENDENTE") // PENDENTE | APROVADA | REJEITADA
  createdAt   DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  requestedById String
  requestedBy   User   @relation("DeletionRequestedBy", fields: [requestedById], references: [id])

  resolvedById String?
  resolvedBy   User?     @relation("DeletionResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?

  @@index([officeId])
}

// ============ INTEGRAÇÃO GOOGLE DRIVE (por escritório — Fase 2) ============

model GoogleCredential {
  id                String   @id @default(cuid())
  accountEmail      String   @unique
  refreshToken      String
  isPrimaryDrive    Boolean  @default(false) // conta usada para anexos/documentos DESTE escritório (uma só, escolhida na primeira conexão)
  syncJusbrasil     Boolean  @default(true) // se a caixa desta conta é varrida em busca de e-mails do Jusbrasil
  folderId          String?
  templatesFolderId String?
  generatedFolderId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([officeId])
}

// Conta Microsoft (Outlook) conectada por uma pessoa do escritório — Fase 1 do pedido "sincronizar
// com OneDrive/Outlook/Dropbox": cobre recebimento (mesmo pipeline do Jusbrasil por e-mail, ver
// lib/outlookEmailSync.ts) e envio (Atendimento, ver lib/gmailSend.ts) via Outlook. Segue o mesmo
// desenho do GoogleCredential "modo jusbrasil" (por pessoa, não por escritório) — cada um conecta a
// própria caixa. O calendário do Outlook ainda não usa esta credencial (ver README_MICROSOFT.md
// para o que falta). isPrimaryDrive/rootFolderId (Fase 2 — armazenamento) espelham
// GoogleCredential.isPrimaryDrive/folderId, mas só uma pasta raiz aqui (não três: não há
// equivalente de Modelos/Gerados no Microsoft Graph nesta entrega, ver lib/oneDriveStorage.ts) —
// uma mesma conta pode ter uma linha só de e-mail (isPrimaryDrive: false) e depois virar também a
// conta de armazenamento do escritório (isPrimaryDrive: true), sem duplicar linha.
model MicrosoftCredential {
  id             String   @id @default(cuid())
  accountEmail   String   @unique
  refreshToken   String
  syncEmail      Boolean  @default(true)
  isPrimaryDrive Boolean  @default(false) // conta usada para anexos (OneDrive) DESTE escritório (uma só)
  rootFolderId   String? // id da pasta raiz "Lúmen" no OneDrive desta conta, cacheado (ver getOrCreateRootFolder)
  createdAt      DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([officeId])
}

// Conta Dropbox conectada como armazenamento DESTE escritório — ao contrário de
// MicrosoftCredential (por pessoa, com isPrimaryDrive para achar a "principal"), aqui é
// sempre uma linha por escritório: Dropbox não tem uso de e-mail neste projeto, só
// armazenamento, então não existe cenário de "várias contas conectadas, uma é a principal".
// rootFolderId cacheia o id (já no formato "id:XXXXX" retornado pela API) da pasta raiz "Lúmen"
// nesta conta — ver lib/dropboxStorage.ts, getOrCreateRootFolder.
model DropboxCredential {
  id           String   @id @default(cuid())
  accountEmail String
  refreshToken String
  rootFolderId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  officeId String @unique
  office   Office @relation(fields: [officeId], references: [id])
}

// ============ INTEGRAÇÃO WHATSAPP (por escritório — Fase 2) ============
// WHATSAPP_APP_SECRET/WHATSAPP_VERIFY_TOKEN continuam globais (variável de ambiente) — são do
// único Meta App/WABA da plataforma, compartilhado por todos os escritórios. O que é por
// escritório é o NÚMERO de telefone (phoneNumberId + accessToken), cadastrado aqui.
// phoneNumberId é único globalmente (é a Meta quem atribui) — é ele que o webhook usa pra
// descobrir a qual escritório uma mensagem recebida pertence (ver lib/whatsapp.ts).
model WhatsappConfig {
  id            String   @id @default(cuid())
  phoneNumberId String   @unique
  accessToken   String
  displayPhone  String? // só para exibição em Configurações (ex: "+55 62 99999-0000")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  officeId String @unique
  office   Office @relation(fields: [officeId], references: [id])
}

// ============ FINANCEIRO ============

model FinancialCategory {
  id        String   @id @default(cuid())
  code      String // ex: "1.1", "2.1.1.1" - ordena e mostra a hierarquia (plano de contas)
  name      String
  kind      String // RECEITA | DESPESA
  order     Int      @default(0)
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  parentId String?
  parent   FinancialCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children FinancialCategory[] @relation("CategoryTree")

  payables             Payable[]
  receivables          Receivable[]
  honorarioLancamentos HonorarioLancamento[]

  @@index([officeId])
}

model CostCenter {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  payables             Payable[]
  receivables          Receivable[]
  honorarioLancamentos HonorarioLancamento[]

  @@index([officeId])
}

model Payable {
  id                   String    @id @default(cuid())
  description          String
  supplier             String?
  amount               Float
  dueDate              DateTime
  paidDate             DateTime?
  paidAmount           Float?
  // PENDENTE (nada pago) | PAGO (baixado integralmente, fluxo antigo de uma tacada só) |
  // ATRASADO (calculado por effective() em lib/financeQuery.ts, nunca gravado direto) |
  // CANCELADO | PARCIAL (Fase 1 — algum FinancePayment já lançado, mas a soma ainda não cobre o
  // valor líquido; ver lib/financeCalc.ts:statusPorPagamentos) — "A_APURAR" não se aplica a
  // Payable (não existe conta a pagar de valor desconhecido; só Receivable percentual apura
  // depois), mantido de fora de propósito.
  status               String    @default("PENDENTE")
  notes                String?
  noDueDate            Boolean   @default(false) // parcela sem vencimento definido — aparece na Central de Alertas
  groupId              String? // agrupa parcelas geradas juntas
  installmentNumber    Int?
  installmentTotal     Int?
  paymentReceiptNumber String? // nº do comprovante de pagamento; pode ser o mesmo em várias contas quitadas na mesma transferência
  paymentMethod        String? // DEBITO | CREDITO | PIX | TRANSFERENCIA | BOLETO | OUTROS
  createdAt            DateTime  @default(now())

  // ---- Fase 1 (fundação de dados, ainda dormente) — mesmos campos espelhados em Receivable,
  // para as duas telas (Contas a Pagar/Contas a Receber) ficarem idênticas em estrutura. ----
  documentType      String? // BOLETO | CONTRATO | FATURA | FOLHA_PAGAMENTO | NOTA_FISCAL | ORDEM_SERVICO | RECIBO | OUTROS
  documentNumber    String?
  issueDate         DateTime? // data de emissão do documento (distinta de dueDate/createdAt)
  discount          Float     @default(0) // desconto aplicado — ver lib/financeCalc.ts:valorLiquido
  surcharge         Float     @default(0) // acréscimo (juros/multa) — ver lib/financeCalc.ts:valorLiquido
  installmentBoleto String? // nº do boleto desta parcela específica (distinto de paymentReceiptNumber, que é do comprovante de pagamento)

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  categoryId String?
  category   FinancialCategory? @relation(fields: [categoryId], references: [id])

  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  supplierId  String?
  supplierRef Supplier? @relation(fields: [supplierId], references: [id])

  // Quem lançou esta conta — só para exibição ("lançado por"), não afeta quem enxerga
  // (isso é por officeId, como sempre).
  responsibleId String?
  responsible   User?   @relation("PayableResponsible", fields: [responsibleId], references: [id])

  // Histórico de pagamentos desta conta (ver model FinancePayment mais abaixo) — permite
  // pagamento PARCIAL: a soma de payments decide entre PENDENTE/PARCIAL/PAGO.
  payments FinancePayment[]

  @@index([officeId])
  @@index([officeId, dueDate])
}

model Receivable {
  id                   String    @id @default(cuid())
  description          String
  amount               Float
  dueDate              DateTime
  paidDate             DateTime?
  paidAmount           Float?
  // PENDENTE (nada pago) | PAGO (baixado integralmente, fluxo antigo de uma tacada só) |
  // ATRASADO (calculado por effective() em lib/financeQuery.ts, nunca gravado direto) |
  // CANCELADO | PARCIAL (Fase 1 — algum FinancePayment já lançado, mas a soma ainda não cobre o
  // valor líquido; ver lib/financeCalc.ts:statusPorPagamentos) | A_APURAR (Fase 1 — parcela
  // PERCENTUAL cujo valor real só será conhecido no desfecho do processo; amount aqui é só a
  // ESTIMATIVA, nunca soma como receita prevista de verdade — ver lib/financeQuery.ts e todo
  // ponto que soma "a receber", que precisam ignorar este status).
  status               String    @default("PENDENTE")
  // HONORARIOS_CONTRATUAIS | HONORARIOS_SUCUMBENCIAIS | HONORARIOS_ACORDO (Fase 9 — natureza
  // "Acordo", ver lib/honorarioLancamento.ts:NATUREZA_LABELS; não confundir com a base de
  // cálculo percentual "ACORDO" de PERCENTUAL_BASE_LABELS, conceito totalmente diferente) |
  // REEMBOLSO | OUTROS — string livre, sem enum; catálogo de opções/rótulos centralizado em
  // lib/honorarioLancamento.ts:RECEIVABLE_KIND_OPTIONS.
  kind                 String    @default("HONORARIOS_CONTRATUAIS")
  notes                String?
  noDueDate            Boolean   @default(false)
  groupId              String?
  installmentNumber    Int?
  installmentTotal     Int?
  isSuccessPortion     Boolean   @default(false) // parcela "a receber no êxito"
  paymentReceiptNumber String? // nº do comprovante de pagamento; pode ser o mesmo em várias contas quitadas na mesma transferência
  paymentMethod        String? // DEBITO | CREDITO | PIX | TRANSFERENCIA | BOLETO | OUTROS
  createdAt            DateTime  @default(now())

  // Lançamento de honorário em dinheiro (FIXO, o padrão — amount é o valor real) ou em
  // PERCENTUAL sobre uma base do processo (percentualBase). Numa parcela PERCENTUAL, amount
  // guarda a ESTIMATIVA calculada (percentual × valor da base no momento em que a parcela foi
  // criada/editada) — só para exibição e soma na lista; o valor real recebido continua sendo
  // paidAmount, preenchido à mão na baixa (ver markReceivablePaid), já que a base do processo
  // pode mudar ou só ser conhecida de fato no desfecho do caso.
  valueType      String  @default("FIXO") // FIXO | PERCENTUAL
  percentual     Float?
  percentualBase String? // VALOR_CAUSA | PROVEITO_ECONOMICO | CONDENACAO | ACORDO — ver Case.caseValue/economicBenefitValue/convictionValue/agreementValue

  // Se esta parcela conta na soma comparada com HonorarioLancamento.valorTotalIndicado (nota de
  // divergência). Ex.: honorário de 5.000 em 2 parcelas — "5.000 de entrada" vinculado (soma
  // bate com o total) e "10% do êxito" desvinculado (percentual à parte, fora do total
  // indicado). Irrelevante (mas mantido true) fora de um HonorarioLancamento.
  vinculadoAoTotal Boolean @default(true)

  // ---- Fase 1 (fundação de dados, ainda dormente) — mesmos campos espelhados em Payable, para
  // as duas telas (Contas a Pagar/Contas a Receber) ficarem idênticas em estrutura. ----
  documentType      String? // BOLETO | CONTRATO | FATURA | FOLHA_PAGAMENTO | NOTA_FISCAL | ORDEM_SERVICO | RECIBO | OUTROS
  documentNumber    String?
  issueDate         DateTime? // data de emissão do documento (distinta de dueDate/createdAt)
  discount          Float     @default(0) // desconto aplicado — ver lib/financeCalc.ts:valorLiquido
  surcharge         Float     @default(0) // acréscimo (juros/multa) — ver lib/financeCalc.ts:valorLiquido
  installmentBoleto String? // nº do boleto desta parcela específica (distinto de paymentReceiptNumber, que é do comprovante de pagamento)

  // Só em Receivable: honorário tem pagador que pode não ser o próprio cliente (ex.: parte
  // adversa condenada em sucumbência, ou terceiro pagando por conta do cliente).
  payerType String  @default("CLIENTE") // CLIENTE | ADVERSA | OUTRO
  payerName String? // preenchido quando payerType é ADVERSA ou OUTRO

  // Quando true numa parcela PERCENTUAL, o valor apurado no desfecho (ver
  // lib/financeCalc.ts:valorPercentualApurado) desconta o que já foi pago em dinheiro no mesmo
  // HonorarioLancamento — reproduz a cláusula do contrato ENTRADA_EXITO gerado em
  // lib/honorarios.ts ("com abatimento do valor já pago a título de entrada"), que o financeiro
  // ainda não aplicava.
  abaterEntrada Boolean @default(false)

  // Preenchidos quando uma parcela PERCENTUAL (A_APURAR) vira valor real conhecido — quem apurou
  // e quando, para auditoria. Nulos enquanto a provisão continua em aberto.
  apuradoEm    DateTime?
  apuradoPorId String?
  apuradoPor   User?     @relation("ReceivableApuradoPor", fields: [apuradoPorId], references: [id])

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  categoryId String?
  category   FinancialCategory? @relation(fields: [categoryId], references: [id])

  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  // Quem lançou esta conta — só para exibição ("lançado por"), não afeta quem enxerga.
  responsibleId String?
  responsible   User?   @relation("ReceivableResponsible", fields: [responsibleId], references: [id])

  // Histórico de pagamentos desta conta (ver model FinancePayment mais abaixo) — permite
  // recebimento PARCIAL: a soma de payments decide entre PENDENTE/PARCIAL/PAGO.
  payments FinancePayment[]

  honorario Honorario?

  // Presente só quando esta parcela nasceu de um lançamento de honorários parcelado (ver model
  // HonorarioLancamento acima) — nulo para toda Receivable "solta" (única, recorrente até o
  // arquivamento, ou lançada fora da aba Financeiro do Processo).
  honorarioLancamentoId String?
  honorarioLancamento   HonorarioLancamento? @relation(fields: [honorarioLancamentoId], references: [id], onDelete: Cascade)

  // Preenchidos só quando esta linha foi gerada por um RecurringFee ("honorário até o
  // arquivamento") — competencia ("YYYY-MM") + a constraint única abaixo garantem que o cron
  // (ensureRecurringFeeReceivables, lib/actions/financeiro.ts) nunca gera duas linhas pro mesmo
  // mês, mesmo rodando todo dia. NULL não colide com NULL num índice único do Postgres, então
  // isso não afeta em nada as linhas normais (sem recurringFeeId).
  recurringFeeId String?
  recurringFee   RecurringFee? @relation(fields: [recurringFeeId], references: [id])
  competencia    String?

  @@unique([recurringFeeId, competencia])
  @@index([officeId])
  @@index([officeId, dueDate])
}

// Honorário "até o arquivamento": ao contrário do parcelamento comum (Receivable.installmentTotal,
// quantidade fixa definida na hora), aqui não se sabe de antemão quantas parcelas vão existir —
// ensureRecurringFeeReceivables gera as próximas alguns meses à frente (o bastante para cobrir a
// janela do Fluxo de Caixa) e para de gerar sozinho quando o Case vinculado é arquivado
// (active vira false). categoryId/costCenterId não têm relation formal aqui de propósito: são só
// copiados para cada Receivable gerado, que já valida a própria FK ao ser criado.
model RecurringFee {
  id           String   @id @default(cuid())
  description  String
  amount       Float
  dueDay       Int // dia do mês de vencimento (clampado 1-28, mesmo padrão do dueDay de Assessoria)
  kind         String   @default("HONORARIOS_CONTRATUAIS") // mesmo catálogo de Receivable.kind (ver comentário lá, inclui HONORARIOS_ACORDO desde a Fase 9)
  categoryId   String?
  costCenterId String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  receivables Receivable[]

  @@index([officeId])
  @@index([caseId])
}

// ============ FUNDAÇÃO DE DADOS — FINANCEIRO AVANÇADO (Fase 1, aditiva e dormente) ============
//
// Base para o honorário em dinheiro + percentual + parcelamento editável linha a linha + apuração
// do êxito no desfecho do processo. Nenhuma tela lê os três modelos abaixo ainda — só schema,
// helpers puros (lib/financeCalc.ts, lib/prazos.ts) e os ajustes de leitura em
// lib/financeQuery.ts para os status novos (PARCIAL/A_APURAR) não sumirem das abas existentes.

// Conta bancária do escritório — cadastro simples (Fase 3 monta a tela); aqui só o registro para
// FinancePayment.bankAccountId ter o que referenciar desde já.
model BankAccount {
  id            String   @id @default(cuid())
  name          String // apelido, ex. "Itaú Principal"
  bank          String?
  agency        String?
  accountNumber String?
  type          String   @default("CORRENTE") // CORRENTE | POUPANCA | INVESTIMENTO
  initialBalance Float   @default(0)
  active        Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  payments FinancePayment[]

  @@index([officeId])
}

// Feriado LOCAL/personalizado cadastrado pelo escritório (estadual, municipal ou forense) — os
// feriados NACIONAIS (fixos e móveis) nunca entram aqui, são calculados em código (ver
// lib/prazos.ts:feriadosNacionais); esta tabela só existe para o que o calendário nacional não
// cobre (ex.: aniversário da comarca, feriado forense local).
model Holiday {
  id    String @id @default(cuid())
  // Data-calendário em UTC-meia-noite, mesma convenção de Task.dueDate (ver
  // formatCalendarDate em components/ui.tsx) — nunca ler com getters locais de Date.
  date  DateTime
  name  String
  scope String // NACIONAL | ESTADUAL | MUNICIPAL | FORENSE

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  createdAt DateTime @default(now())

  @@index([officeId, date])
}

// Histórico de recebimentos/pagamentos de uma conta — é o que viabiliza pagamento PARCIAL: uma
// Receivable/Payable pode ter N FinancePayment, e a SOMA deles decide o status entre
// PENDENTE (soma zero) / PARCIAL (soma > 0 mas menor que o valor líquido) / PAGO (soma cobre o
// valor líquido) — ver lib/financeCalc.ts:statusPorPagamentos. Uma conta paga "de uma vez só" no
// fluxo antigo (markReceivablePaid/markPayablePaid) continua funcionando sem nenhuma linha aqui;
// FinancePayment só entra em cena quando a baixa passar a ser parcial/em várias vezes.
model FinancePayment {
  id              String    @id @default(cuid())
  amount          Float
  paidDate        DateTime
  paymentMethod   String? // DEBITO | CREDITO | PIX | TRANSFERENCIA | BOLETO | DINHEIRO | OUTROS
  documentNumber  String? // nº do documento de pagamento (comprovante, autenticação bancária...)
  notes           String?
  createdAt       DateTime  @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  // Aponta para exatamente um dos dois — nunca ambos, nunca nenhum solto sem sentido de negócio,
  // mas isso é responsabilidade da Server Action que cria o registro (Fase futura), não uma
  // constraint do schema. onDelete Cascade: apagar a conta apaga o próprio histórico dela junto,
  // não faz sentido um FinancePayment sobreviver órfão sem a conta que ele estava quitando.
  receivableId String?
  receivable   Receivable? @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  payableId String?
  payable   Payable? @relation(fields: [payableId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  @@index([officeId])
  @@index([receivableId])
  @@index([payableId])
}

// ============ ASSESSORIA JURÍDICA ============
// Contêiner por empresa cliente (Client.type = "PJ") para tudo que é contínuo — documentos,
// honorário fixo mensal, licitações — sem se misturar com o controle de Processos individuais.
// Processos e Contas a Receber continuam existindo exatamente como hoje; a Assessoria só os
// referencia pelo cliente já cadastrado (nunca duplica dado).

model Assessoria {
  id            String   @id @default(cuid())
  status        String   @default("ATIVA") // ATIVA | SUSPENSA | ENCERRADA
  startDate     DateTime @default(now())
  monthlyFee    Float
  dueDay        Int      @default(5) // dia do mês de vencimento do honorário
  planningNotes String?
  driveFolderId String? // pasta raiz da empresa em "Assessoria/{empresa}"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id])

  responsibleId String?
  responsible   User?   @relation("AssessoriaResponsible", fields: [responsibleId], references: [id])

  documents   AssessoriaDocumento[]
  honorarios  Honorario[]
  licitacoes  Licitacao[]
  cases       Case[]
  attendances Attendance[]

  @@index([officeId])
}

model AssessoriaDocumento {
  id        String   @id @default(cuid())
  name      String
  docType   String // CONTRATO | PARECER | ACAO_VINCULADA | LICITACAO | REGIMENTO_INTERNO | OUTRO
  driveUrl  String
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  // Mesmo par de campos de Attachment.storageProvider/storageFileId, e pelo mesmo motivo: este
  // registro também referencia um arquivo de upload real (ver
  // app/api/assessoria/documentos/upload/route.ts), não só link colado manualmente (ver
  // addDocumento em lib/actions/assessoria.ts, que não preenche estes dois campos). Default
  // GOOGLE_DRIVE preserva o comportamento de todo documento já existente.
  storageProvider String  @default("GOOGLE_DRIVE")
  storageFileId   String?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  assessoriaId String
  assessoria   Assessoria @relation(fields: [assessoriaId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  uploadedById String?
  uploadedBy   User?   @relation("AssessoriaDocumentoUploadedBy", fields: [uploadedById], references: [id])

  @@index([officeId])
}

// Deliberadamente sem amount/dueDate/status/paidDate próprios — esses dados vivem só no
// Receivable vinculado (Contas a Receber já tem toda a lógica de status/pagamento). Duplicar
// esses campos aqui criaria duas fontes de verdade que poderiam divergir.
model Honorario {
  id          String   @id @default(cuid())
  competencia String // "2026-08"
  createdAt   DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  assessoriaId String
  assessoria   Assessoria @relation(fields: [assessoriaId], references: [id])

  receivableId String     @unique
  receivable   Receivable @relation(fields: [receivableId], references: [id])

  @@unique([assessoriaId, competencia])
}

model Licitacao {
  id            String    @id @default(cuid())
  objeto        String
  orgao         String
  modalidade    String?
  dataAbertura  DateTime?
  prazoFinal    DateTime?
  valorEstimado Float?
  editalUrl     String?
  status        String    @default("EM_ANALISE") // EM_ANALISE | PARTICIPANDO | VENCEDORA | PERDIDA | CANCELADA
  createdAt     DateTime  @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  assessoriaId String
  assessoria   Assessoria @relation(fields: [assessoriaId], references: [id])

  tasks Task[]

  @@index([officeId])
}

// ============ PUBLICAÇÕES / ANDAMENTOS ============

model Publication {
  id                String   @id @default(cuid())
  kind              String   @default("PUBLICACAO") // PUBLICACAO | ANDAMENTO
  source            String   @default("DJE") // DJE | PJE | ESAJ | PROJUDI | MANUAL | JUSBRASIL_EMAIL
  content           String
  publishedAt       DateTime
  // Coluna morta: a aplicação não lê nem escreve mais este campo (leitura agora é por usuário,
  // ver PublicationRead). Mantida no schema de propósito — o deploy roda "prisma db push" sem
  // --accept-data-loss, e apagar essa coluna com dados de produção existentes falharia o
  // build. Não usar; não reintroduzir lógica que dependa dela.
  read              Boolean  @default(false)
  deadlineGenerated Boolean  @default(false)
  lawyerTag         String? // nome do advogado identificado pela OAB citada no conteúdo (ver Fase 4 — hoje regex hardcoded por escritório)
  createdAt         DateTime @default(now())

  emailMessageId   String? @unique
  emailAccount     String?
  emailSubject     String?
  processNumberRaw String?

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id])

  clientId String? // preenchido quando não há processo compatível mas o nome de um cliente cadastrado aparece no conteúdo
  client   Client? @relation(fields: [clientId], references: [id])

  // RIDT — fila de triagem com atribuição de responsável
  assignedToId String?
  assignedTo   User?   @relation("PublicationAssignee", fields: [assignedToId], references: [id])
  triageStatus String  @default("PENDENTE") // PENDENTE | EM_ANALISE | TRATADA

  tasks Task[]
  reads PublicationRead[]

  @@index([officeId])
  @@index([officeId, publishedAt])
}

// Processo que um usuário optou por deixar de acompanhar (botão "Bloquear", só disponível para
// publicações/andamentos SEM processo cadastrado — ver LinkPublicationMenu.tsx). Escopo é POR
// USUÁRIO, não por escritório: se um advogado bloqueia, os demais do mesmo escritório continuam
// recebendo normalmente as publicações/andamentos daquele processo — a Publication é sempre
// criada normalmente pelo robô (lib/roboBridge.ts), o bloqueio só filtra a listagem de quem
// bloqueou (ver lib/actions/publications.ts). Gerenciado em Configurações → Geral, abaixo do
// TaskScore (ver BlockedProcessNumbersManager.tsx) — reversível a qualquer momento.
model BlockedProcessNumber {
  id String @id @default(cuid())

  // Normalizado por normalizeProcessNumber (lib/processNumber.ts) — só letras/dígitos, minúsculo,
  // sem máscara — mesma normalização usada em toda busca por número de processo do site, para o
  // bloqueio casar com o número digitado/exibido independente de pontuação.
  processNumber String
  // Como o número aparecia na tela no momento do bloqueio (com máscara), só para exibição na
  // lista de Configurações — processNumber (acima) é o que de fato importa para o casamento.
  displayNumber String
  createdAt     DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  // @map preserva o nome de coluna antigo (blockedById) — o campo já era sempre preenchido, então
  // virar NOT NULL + trocar a unique key pra (userId, processNumber) não perde dado nenhum.
  userId String @map("blockedById")
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, processNumber])
  @@index([officeId])
}

// Leitura é por usuário, não compartilhada pelo escritório: cada advogado marca uma
// publicação como lida só pra si — as outras ações (anexar, agendar, delegar, triagem)
// continuam no próprio Publication, vistas por todo mundo do escritório.
model PublicationRead {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt        DateTime    @default(now())

  @@unique([publicationId, userId])
  @@index([userId])
}

// "Lido" na Central de Alertas — só para os tipos de alerta que hoje não têm nenhuma ação de
// resolver (MENCAO, FOLLOWUP_ATRASADO, PARCELA_SEM_VENCIMENTO, DRIVE_INCONSISTENCIA; ver
// lib/alerts.ts). Por usuário, igual PublicationRead/BlockedProcessNumber — dispensar um alerta
// não afeta os outros advogados do escritório. `entityId` é o mesmo AlertItem.entityId (comment.id
// pra menção, attendance.id pro follow-up, payable/receivable.id pra parcela, driveSyncIssue.id).
model AlertDismissal {
  id        String   @id @default(cuid())
  officeId  String
  office    Office   @relation(fields: [officeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String
  entityId  String
  createdAt DateTime @default(now())

  @@unique([userId, kind, entityId])
  @@index([officeId])
}

// ============ BLOG JURÍDICO (público, por escritório) ============
//
// Alimentado por um robô de conteúdo EXTERNO (projeto Claude Code autônomo, fora
// deste repositório) que pesquisa jurisprudência/legislação/doutrina e envia
// rascunhos via POST /api/blog/draft (autenticado por BLOG_ROBOT_SECRET). Todo
// rascunho nasce como AGUARDANDO_REVISAO — só é publicado quando um usuário
// humano logado confirma em Configurações → Blog Jurídico → Revisão Pendente.

model BlogPost {
  id             String    @id @default(cuid())
  slug           String
  title          String
  area           String // ex: Civil, Consumerista, Empresarial, Tributário, Trabalhista, Previdenciário, Administrativo, Licitação, Compliance, Due Diligence, Contratual, Responsabilidade Civil, Execuções
  type           String    @default("NOTICIA") // NOTICIA | ANALISE
  summary        String
  content        String // corpo da matéria, pode ser markdown simples
  sources        String? // URLs das fontes usadas, uma por linha (texto simples)
  imageUrl       String? // preenchido manualmente pelo admin antes de publicar
  status         String    @default("AGUARDANDO_REVISAO") // AGUARDANDO_REVISAO | PUBLICADO | REJEITADO
  rejectedReason String?
  reviewedById   String?
  reviewedBy     User?     @relation("BlogPostReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@unique([officeId, slug])
  @@index([officeId, status, publishedAt])
  @@index([officeId, area])
}

// ============ BIBLIOTECA DE FOTOS ============
//
// Fotos enviadas por um admin (upload real, armazenado no Vercel Blob — ver
// @vercel/blob e BLOB_READ_WRITE_TOKEN). Usadas tanto para ilustrar matérias do
// blog jurídico (sugestão automática por área) quanto como camada de fundo
// decorativa, de baixa opacidade, atrás do conteúdo do sistema.

model Photo {
  id        String   @id @default(cuid())
  url       String // URL pública do Vercel Blob
  category  String // mesma taxonomia livre de BlogPost.area, + "Todos" para fotos só decorativas/ambiente (curinga)
  court     String   @default("TODOS") // tribunal retratado na foto: STF, STJ, TRT/TST, TJ, TRF, TODOS (curinga)
  caption   String? // legenda opcional, ex: para crédito/descrição da imagem
  createdAt DateTime @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId, category])
}

// ============ TABELAS DO ROBÔ PYTHON (robo-publicacoes/, Railway) ============
//
// O robô Python (SQLAlchemy) grava direto nestas 4 tabelas, sem coluna de
// escritório — ele já monitora as OABs de TODOS os escritórios ativos
// (config.py:carregar_oabs_do_banco), mas não sabe a qual escritório cada OAB
// pertence. Os tipos/nomes de coluna abaixo espelham robo-publicacoes/src/db.py;
// se o robô mudar a estrutura lá, replicar a mudança aqui também (sem isso,
// `prisma db push` trata essas tabelas como "órfãs" e as apaga na próxima migração).
//
// Estes 4 modelos não são a fonte de verdade multi-tenant — lib/roboBridge.ts é quem
// lê estas tabelas e ATRIBUI cada item capturado ao escritório certo (por número de
// processo batendo com um Case existente e, na falta disso, por OAB batendo com um
// usuário ativo de algum escritório), gravando o resultado já com officeId em
// Publication. Ou seja, o roteamento multi-escritório já acontece nesta ponte —
// não é mais uma limitação de arquitetura pendente.

model RoboPublicacao {
  idComunicacao        String   @id @map("id_comunicacao")
  oab                  String
  uf                   String
  nomeAdvogado         String?  @map("nome_advogado")
  numeroProcesso       String   @map("numero_processo")
  tribunal             String?
  dataDisponibilizacao String?  @map("data_disponibilizacao")
  tipoComunicacao      String?  @map("tipo_comunicacao")
  teor                 String?
  dataCaptura          DateTime @default(now()) @map("data_captura")
  statusLido           Boolean  @default(false) @map("status_lido")

  @@map("publicacoes")
}

model RoboAndamento {
  id                 Int      @id @default(autoincrement())
  numeroProcesso     String   @map("numero_processo")
  tribunal           String?
  dataMovimentacao   String   @map("data_movimentacao")
  codigoMovimento    String   @map("codigo_movimento")
  descricaoMovimento String?  @map("descricao_movimento")
  dataCaptura        DateTime @default(now()) @map("data_captura")
  statusLido         Boolean  @default(false) @map("status_lido")

  @@unique([numeroProcesso, dataMovimentacao, codigoMovimento], name: "uq_andamento_processo_data_codigo")
  @@map("andamentos")
}

model RoboProcessoMonitorado {
  numeroProcesso String   @id @map("numero_processo")
  origem         String
  dataInclusao   DateTime @default(now()) @map("data_inclusao")
  oabRelacionada String?  @map("oab_relacionada")

  @@map("processos_monitorados")
}

model RoboExecucaoLog {
  id          Int      @id @default(autoincrement())
  fonte       String
  sucesso     Boolean
  detalhe     String?
  executadoEm DateTime @default(now()) @map("executado_em")

  @@map("execucao_log")
}

// Licitações capturadas pelo robô administrativo (robo-publicacoes/src/pncp.py) na API pública
// de consulta do PNCP. Mesmo padrão dos 4 modelos acima (tabela compartilhada, sem officeId —
// o robô não sabe a qual escritório uma licitação interessa, só coleta tudo dentro das UFs
// configuradas). O roteamento por escritório acontece depois, em lib/pncpBridge.ts, casando
// contra os termos vigiados (TermoVigilancia) de cada escritório. `numeroControlePNCP` é a
// chave natural do PNCP (única por licitação em todo o país) — usada tanto pro dedup do robô
// quanto pra chave de idempotência da Publication gerada na ponte. `payloadBruto` guarda o item
// inteiro serializado (JSON) exatamente como veio da API: como o mapeamento de campo real ainda
// não foi confirmado contra uma resposta de verdade (ver comentário no topo de pncp.py), isso
// permite reprocessar/corrigir o mapeamento depois sem precisar consultar o PNCP de novo.
// IMPORTANTE: assim como os 4 modelos acima, se esta estrutura mudar, replicar a mudança em
// robo-publicacoes/src/db.py (senão `prisma db push` trata a tabela como órfã).
model RoboLicitacao {
  id                       String   @id @default(cuid())
  numeroControlePNCP       String   @unique
  orgaoCnpj                String?
  orgaoNome                String?
  uf                       String?
  municipio                String?
  modalidadeNome           String?
  objeto                   String?
  valorEstimado            Float?
  situacao                 String?
  dataPublicacao           String?
  dataAberturaProposta     String?
  dataEncerramentoProposta String?
  linkSistemaOrigem        String?
  payloadBruto             String? // JSON cru, para conseguir reprocessar sem consultar de novo
  dataCaptura              DateTime @default(now())
  statusProcessado         Boolean  @default(false)

  @@map("licitacoes_pncp")
  @@index([statusProcessado])
}

// Artigo do Diario Oficial da Uniao (DOU) capturado via INLABS (Imprensa Nacional) que bateu
// com pelo menos um termo vigiado (TermoVigilancia) de um escritorio — Fase 2 do Setor de
// Processos Administrativos. DIFERENTE do padrao de RoboLicitacao/RoboPublicacao/RoboAndamento
// (que gravam TUDO e deixam o casamento por escritorio acontecer depois, na ponte TypeScript):
// aqui o casamento com os termos vigiados acontece DENTRO do robo Python (src/inlabs.py), no
// momento da propria captura, porque o DOU publica milhares de artigos por dia e gravar todos
// incharia o banco a toa — so interessa o artigo que realmente bate com um termo de algum
// escritorio. Por isso este model JA NASCE com officeId obrigatorio (nao-nulo), ao contrario
// dos outros models do robo: cada linha aqui e o resultado de um casamento que ja aconteceu.
// Se dois escritorios diferentes tiverem termos que batem no MESMO artigo, o Python grava DUAS
// linhas (uma por escritorio), cada uma com sua propria chaveUnica (ver campo abaixo).
// IMPORTANTE: assim como os modelos do robo acima, se esta estrutura mudar, replicar a mudanca
// em robo-publicacoes/src/db.py (senao `prisma db push` trata a tabela como orfa).
model RoboDouItem {
  id               String   @id @default(cuid())
  chaveUnica       String   @unique // dataPublicacao + secao + id do artigo + officeId — evita duplicar entre execuções
  secao            String   // DO1 | DO2 | DO3 | DO1E | DO2E | DO3E
  orgao            String?
  titulo           String?
  ementa           String?
  textoResumo      String?  // trecho em torno do termo encontrado, não o artigo inteiro
  dataPublicacao   String?
  numeroPagina     String?
  termoEncontrado  String   // texto do termo que bateu (não o id — sobrevive se o termo for apagado depois)
  payloadBruto     String?  // XML do artigo; truncado com segurança se muito grande
  dataCaptura      DateTime @default(now())
  statusProcessado Boolean  @default(false)

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@index([officeId, statusProcessado])
}

// ============ PAINEL MESTRE (cobrança entre escritórios) ============

// Uma fatura mensal de um escritório-cliente da plataforma. Gerada manualmente pelo platform
// owner (Painel Mestre → "Gerar boleto e enviar por e-mail") ou, quando o BTG estiver
// conectado (ver BtgConnection), automaticamente com um boleto de verdade emitido.
model TenantInvoice {
  id          String    @id @default(cuid())
  officeId    String
  office      Office    @relation(fields: [officeId], references: [id])
  competencia String // "2026-08" — mês de referência, evita gerar duas faturas pro mesmo mês
  amount      Float
  dueDate     DateTime
  status      String    @default("PENDENTE") // PENDENTE | PAGO | CANCELADO
  paidAt      DateTime?
  // "manual" (Dar baixa manual, sem boleto), "btg_boleto" (baixa confirmada via boleto BTG) ou
  // "asaas" (baixa confirmada via webhook/reconciliação Asaas — ver lib/asaas.ts)
  paidVia     String?
  boletoUrl   String? // link do PDF do boleto, quando emitido via BTG
  boletoId    String? // ID do boleto na API do BTG, pra consultar status depois
  createdAt   DateTime  @default(now())

  // Forma de pagamento efetivamente usada nesta fatura — preenchido quando a cobrança é
  // criada (não só quando é paga), pra sabermos de antemão que tipo de dado exibir (QR Code
  // vs. link de boleto) mesmo antes da confirmação de pagamento.
  paymentMethod String? // PIX_AUTOMATICO | PIX_QRCODE | BOLETO

  // Referência da cobrança no Asaas (o "payment" — id tipo "pay_..."). Chave usada tanto pelo
  // webhook (encontrar a fatura a partir do evento recebido) quanto pela reconciliação
  // (consultar o status atual direto na API).
  asaasPaymentId String? @unique

  // Dados do Pix QR Code dinâmico desta cobrança especificamente (só preenchidos quando
  // paymentMethod for PIX_QRCODE) — o "copia e cola" (payload EMV) e a imagem do QR Code em
  // base64, exatamente como a Asaas devolve (docs.asaas.com/reference/obter-qr-code-para-pagamentos-via-pix).
  pixQrCodePayload String?
  pixQrCodeImage   String? // base64, pode ser grande — @db.Text se o provider exigir (Postgres não exige)

  // Status bruto devolvido pela Asaas (ex.: "RECEIVED", "CONFIRMED", "OVERDUE") — guardado
  // por auditoria/depuração, sem substituir o campo `status` local (PENDENTE|PAGO|CANCELADO)
  // que o resto do sistema já lê.
  externalStatus String?

  // Lembretes já enviados por esta fatura (Fase 2 — cron de cobrança) — evita reenviar o
  // mesmo e-mail toda vez que o cron roda. Valores: "ANTES_VENCIMENTO" | "VENCIDA" | "SUSPENSAO".
  remindersSent String[] @default([])

  @@unique([officeId, competencia])
}

// Log de todo evento de webhook de pagamento recebido — existe por dois motivos: (1)
// idempotência (o Asaas pode reenviar o mesmo evento mais de uma vez; @unique em
// [provider, externalId, eventType] garante que só processamos uma vez), (2) auditoria (nunca
// apagar; é o registro de que um pagamento foi de fato confirmado pelo provedor, não por
// alguém chamando nosso backend direto — ver o limite de segurança inegociável descrito em
// lib/asaas.ts e app/api/asaas/webhook/route.ts).
model PaymentWebhookEvent {
  id             String    @id @default(cuid())
  provider       String    @default("ASAAS")
  eventType      String // ex.: PAYMENT_RECEIVED, PAYMENT_CONFIRMED, PAYMENT_OVERDUE
  externalId     String // id do evento OU do payment/authorization — o que a Asaas mandar como identificador único
  signatureValid Boolean
  rawPayload     Json
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([provider, externalId, eventType])
  @@index([createdAt])
}

// Conexão OAuth (Authorization Code) com o BTG Empresas — é UMA conta (a do próprio Rodarte
// Prado no BTG), não por escritório-cliente: é o Rodarte Prado quem emite o boleto e cobra
// cada escritório. Só deve existir uma linha; token renovado in-place a cada refresh.
model BtgConnection {
  id            String   @id @default(cuid())
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  connectedAt   DateTime @default(now())
  connectedById String? // userId de quem autorizou (auditoria)
}

// ============ LÚMEN — FUNDAÇÃO DE DADOS (Passo 1) ============
//
// Tudo daqui pra baixo é estrutura nova da plataforma Lúmen (a empresa por trás do produto,
// distinta de cada escritório-cliente). Passo 1 é só schema + endpoint de preenchimento manual:
// nenhuma tela lê estes modelos ainda, nenhum comportamento em execução muda. Os campos que já
// existem em Office/User (isInternal, monthlyFee, billingEmail, billingDueDay, isPlatformOwner)
// continuam sendo a fonte de verdade até a leitura ser migrada num passo futuro.

// ---- Identidade da empresa ----

model PlatformMember {
  id     String  @id @default(cuid())
  // Vínculo com um User de escritório. Hoje Jairo e Rodrigo entram por aqui: autenticam com a
  // conta que já têm e a capacidade "Lúmen" é esta linha, separada. Fica opcional porque um
  // funcionário contratado só pela Lúmen no futuro terá userId nulo e credencial própria,
  // sem pertencer a escritório nenhum.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Preenchidos só quando userId for nulo (funcionário exclusivo da Lúmen).
  name         String?
  email        String? @unique
  passwordHash String?

  roleId String
  role   PlatformRole @relation(fields: [roleId], references: [id])

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessRequests  AccessRequest[]  @relation("AccessRequestRequester")
  accessApprovals AccessRequest[]  @relation("AccessRequestApprover")
  accessSessions  AccessSession[]
  auditEntries    AccessAuditLog[]
}

model PlatformRole {
  id   String @id @default(cuid())
  key  String @unique // SOCIO | FINANCEIRO | SUPORTE_N1 | ENGENHARIA | COMERCIAL | MARKETING
  name String

  // Teto de acesso na escada de visibilidade: ABERTO | VIDRO_FOSCO | QUEBRA_VIDRO.
  // Ninguém alcança COFRE — nem sócio. Guardado como texto pelo mesmo motivo dos demais
  // enums do schema (db push sem migration).
  maxVisibility String @default("ABERTO")

  canManageBilling Boolean @default(false)
  canManageMembers Boolean @default(false)
  canApproveAccess Boolean @default(false)

  createdAt DateTime         @default(now())
  members   PlatformMember[]
}

// ---- Receita e custo ----

model Subscription {
  id       String @id @default(cuid())
  officeId String @unique
  office   Office @relation(fields: [officeId], references: [id])

  planKey      String  @default("PADRAO")
  monthlyFee   Float
  dueDay       Int     @default(10)
  billingEmail String?
  status       String  @default("ATIVA") // ATIVA | TESTE | SUSPENSA | CANCELADA
  // Assinatura interna (Rodarte Prado) — cobrada a preço interno, não entra no MRR comercial.
  // Substitui Office.isInternal quando a leitura for migrada, no Passo 4.
  internal     Boolean @default(false)

  // Ciclo de cobrança escolhido pelo escritório — "MENSAL" (padrão) ou "SEMESTRAL" (paga de
  // uma vez a cada 6 meses, com desconto). Nomeado em português por consistência com o resto
  // do schema (STATUS, planKey etc. usam texto livre em maiúsculas); o valor equivalente do
  // lado Asaas (MONTHLY/SEMIANNUALLY) é traduzido em lib/asaas.ts, não aqui.
  billingCycle String @default("MENSAL") // MENSAL | SEMESTRAL

  // Forma de cobrança ativa desta assinatura — PIX_AUTOMATICO é o caminho preferencial (débito
  // recorrente autorizado uma vez), PIX_QRCODE é o QR Code dinâmico gerado a cada cobrança
  // (usado sobretudo no ciclo SEMESTRAL, mas disponível pro MENSAL também), BOLETO continua
  // existindo via BTG (ver lib/btg.ts) para quem preferir. Nasce nulo (ainda não configurado)
  // até o escritório escolher/conectar.
  paymentMethod String? // PIX_AUTOMATICO | PIX_QRCODE | BOLETO

  // Percentual de desconto aplicado (ex.: 20 para 20%) — hoje só faz sentido combinado com
  // billingCycle SEMESTRAL, mas fica genérico pra não prender a regra de desconto ao ciclo no
  // nível de schema (a regra de negócio "só semestral tem desconto" fica no código, não aqui).
  discountPercent Float?

  // Referências do lado Asaas — preenchidas quando a integração é conectada pela primeira vez
  // para este escritório. asaasCustomerId é sempre necessário (toda cobrança precisa de um
  // "customer" no Asaas); os outros dois só existem se o método ativo for PIX_AUTOMATICO.
  asaasCustomerId        String?
  asaasSubscriptionId    String? // id da "assinatura" Asaas (usado no fluxo PIX_QRCODE/BOLETO recorrente)
  pixAuthorizationId     String? // id da autorização de Pix Automático (docs.asaas.com/reference/criar-uma-autorizacao-pix-automatico)
  pixAuthorizationStatus String? // PENDENTE | ATIVA | CANCELADA | REJEITADA

  startedAt   DateTime  @default(now())
  trialEndsAt DateTime?
  canceledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PlatformAccount {
  id        String            @id @default(cuid())
  code      String            @unique
  name      String
  kind      String // RECEITA | DESPESA
  group     String? // Infraestrutura, Pessoal, Marketing, Impostos...
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  expenses  PlatformExpense[]
}

model PlatformExpense {
  id          String          @id @default(cuid())
  accountId   String
  account     PlatformAccount @relation(fields: [accountId], references: [id])
  description String
  amount      Float
  competencia String // "2026-08"
  paidAt      DateTime?
  supplier    String?
  notes       String?
  createdAt   DateTime        @default(now())

  @@index([competencia])
}

model TenantUsage {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  competencia   String // "2026-08" — agregado mensal, não evento a evento
  kind          String // IA_TOKENS | DATAJUD_CONSULTA | DJEN_CONSULTA | BLOB_BYTES | EMAIL_ENVIADO
  quantity      Float  @default(0)
  // Custo estimado em reais, calculado no momento do registro. Guardado junto porque preço de
  // fornecedor muda e recalcular no futuro daria número errado para o passado.
  estimatedCost Float  @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([officeId, competencia, kind])
  @@index([competencia])
}

// ---- Camada de confiança (dormente até o Passo 2) ----

model SupportTicket {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  subject   String
  body      String?
  status    String   @default("ABERTO") // ABERTO | EM_ANDAMENTO | RESOLVIDO | FECHADO
  openedBy  String? // userId de quem abriu, do lado do escritório
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessRequests AccessRequest[]
}

model AccessRequest {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  requesterId String
  requester   PlatformMember @relation("AccessRequestRequester", fields: [requesterId], references: [id])

  // Chamado obrigatório e verificável: precisa existir, estar aberto e ser DAQUELE escritório.
  // É onde PIM da Microsoft e PAM do Google falham (campo livre, sem validação) e onde temos
  // vantagem, porque controlamos os dois lados.
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id])

  // Lista fechada, nunca texto livre: CONFIG_INTEGRACAO | CORRECAO_DADO | DIAGNOSTICO_ERRO |
  // MIGRACAO | INCIDENTE_SEGURANCA | ORDEM_JUDICIAL
  reasonCode String
  reasonNote String?

  // Escopo mínimo: um registro específico. scopeType: CASE | PAYABLE | RECEIVABLE | ATTENDANCE
  scopeType String
  scopeId   String

  status String @default("PENDENTE") // PENDENTE | APROVADO | NEGADO | EXPIRADO | REVOGADO

  approverId       String?
  approver         PlatformMember? @relation("AccessRequestApprover", fields: [approverId], references: [id])
  // Sócio do escritório que aprovou. Guardado como id solto, sem relation, porque o aprovador
  // é do lado do cliente e não deve criar dependência do modelo de plataforma sobre User.
  approvedByUserId String?
  decidedAt        DateTime?

  requestedAt DateTime @default(now())
  expiresAt   DateTime

  sessions AccessSession[]

  @@index([officeId, status])
}

model AccessSession {
  id        String        @id @default(cuid())
  requestId String
  request   AccessRequest @relation(fields: [requestId], references: [id])

  memberId String
  member   PlatformMember @relation(fields: [memberId], references: [id])

  startedAt DateTime  @default(now())
  // Prazo curto com contagem regressiva visível, na linha do que o Discourse faz (15 min).
  expiresAt DateTime
  endedAt   DateTime?
  endedBy   String? // MEMBRO | ESCRITORIO | EXPIRACAO

  @@index([expiresAt])
}

model AccessAuditLog {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  memberId String?
  member   PlatformMember? @relation(fields: [memberId], references: [id])

  // ENTRADA | LEITURA | SAIDA | PEDIDO | APROVACAO | NEGACAO | REVOGACAO | SELAGEM
  action    String
  // Categoria própria para acesso que NÃO passou pelo fluxo normal — emergência, exposição
  // incidental, ordem judicial. É fácil registrar o que seguiu o processo; o valor está em
  // registrar o que não seguiu.
  outOfBand Boolean @default(false)

  reasonCode String?
  scopeType  String?
  scopeId    String?
  sessionId  String?
  ip         String?
  detail     String?

  createdAt DateTime @default(now())

  @@index([officeId, createdAt])
}

// ============ SETOR ADMINISTRATIVO — FUNDAÇÃO (Radar de Publicações Administrativas) ============

// Um "termo vigiado" — nome de cliente, número de processo ou palavra livre que o escritório
// quer que o robô administrativo (coletor PNCP/DOU/Diários/TCs) procure nas fontes públicas.
// Existe tanto solto (LIVRE, sem caseId/clientId — ex.: monitorar o nome de um sócio antes de
// existir processo) quanto amarrado a um Case ou Client já cadastrado (dispara alerta direto
// naquele registro quando dá match). O @@unique evita cadastrar o mesmo termo duas vezes para
// o mesmo processo (silenciosamente ignorado por addTermoVigilancia, não é erro do usuário).
model TermoVigilancia {
  id          String    @id @default(cuid())
  termo       String
  tipo        String    @default("LIVRE") // NOME | DOCUMENTO | NUMERO | LIVRE
  ativo       Boolean   @default(true)
  ultimoHitAt DateTime?
  createdAt   DateTime  @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  criadoPorId String?
  criadoPor   User?   @relation(fields: [criadoPorId], references: [id])

  @@unique([officeId, termo, caseId])
  @@index([officeId, ativo])
}

// Uma fonte pública que o robô administrativo sabe varrer (PNCP, DOU via INLABS, Querido Diário,
// tribunais de contas etc.) — uma linha por escritório por fonte, porque a ativação e a última
// execução são por conta (não é dado global como Tribunal). Nasce inativa (ativa=false): o
// escritório liga cada fonte explicitamente depois de configurar o que precisa (ex.: termos
// vigiados cadastrados), em vez de já sair varrendo tudo sem ninguém ter pedido.
model FonteAdministrativa {
  id               String    @id @default(cuid())
  chave            String // PNCP | DOU_INLABS | QUERIDO_DIARIO | BTCU | DEC_TCE_GO | DOC_TCM_GO | CARF | CAT_GO
  nome             String
  ativa            Boolean   @default(false)
  ultimaExecucaoAt DateTime?
  ultimoStatus     String? // OK | ERRO
  ultimoDetalhe    String?
  createdAt        DateTime  @default(now())

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  @@unique([officeId, chave])
}
