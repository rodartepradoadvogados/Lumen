DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Segredo compartilhado dos 12 crons (app/api/cron/*/route.ts) — cada rota exige
# Authorization: Bearer <CRON_SECRET> e recusa (401) qualquer requisição sem o header correto,
# inclusive quando esta variável está ausente (fail-closed). A Vercel envia esse header sozinha
# nos disparos agendados (vercel.json); sem CRON_SECRET definida em produção, todo cron fica
# permanentemente inacessível — o que é seguro, mas não silencioso: é o comportamento pretendido.
CRON_SECRET=

# SMTP (envio de e-mail — agenda diária, resumo diário, redefinição de senha, convite de
# escritório novo, faturas/lembretes/vencimento do Painel Mestre). Sem estas 4 variáveis, todos
# esses e-mails ficam sem esse canal. Para a redefinição de senha especificamente, isso não
# trava ninguém: existe uma cascata em lib/email.ts (sendCriticalEmailCascade) que tenta, na
# ordem, 1) SMTP (aqui embaixo) → 2) a conta Google conectada do escritório (Configurações →
# Modelos & Integrações, reaproveita o escopo gmail.send já concedido para o Drive) → 3) a conta
# Microsoft conectada do escritório (Mail.Send) → e só se nenhuma das três funcionar, erro
# explicando que um administrador precisa gerar o link de acesso manualmente (Configurações →
# Equipe → botão de link de redefinição). Os demais e-mails (agenda, faturas etc.) não têm essa
# cascata — dependem só destas variáveis.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=

# WhatsApp — Cloud API oficial da Meta. App Meta/webhook/verify token são únicos pra toda a
# plataforma; phoneNumberId/accessToken são por escritório e ficam na tabela WhatsappConfig
# (cadastrados em Configurações, não aqui). WHATSAPP_VERIFY_TOKEN pode ficar em branco (só
# desativa o handshake inicial do webhook). WHATSAPP_APP_SECRET NÃO é opcional em produção
# assim que qualquer escritório tiver o módulo WhatsApp ativo: sem ela, a verificação de
# assinatura do webhook (lib/whatsapp.ts:verifySignature) recusa toda requisição (fail-closed) —
# antes ela aceitava tudo sem essa variável, o que permitia forjar mensagens sem credencial
# nenhuma (achado F2 da auditoria, docs/security-audit/).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Notificações push (Web Push API) — "env-gated" como o WhatsApp acima: dormente e
# inofensivo enquanto vazias (o app mostra "não configurado" e some quietamente).
# Gerar um par novo com: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# BTG Empresas (boletos do Painel Mestre) — ver README_BTG.md para o passo a passo de
# registro do app no portal do BTG. Dormente sem essas duas variáveis.
BTG_CLIENT_ID=
BTG_CLIENT_SECRET=
# "sandbox" (padrão) ou "production" — só trocar depois do app verificado pelo BTG.
BTG_ENV=sandbox
# Opcional — sem ela, cai em ${APP_URL}/api/btg/callback (ver lib/appUrl.ts). Só precisa ser
# definida se o redirect_uri cadastrado no portal do BTG for diferente da URL base do app.
BTG_REDIRECT_URI=

# Microsoft (Outlook) — recebimento de publicações por e-mail + envio no Atendimento via conta
# Outlook. Ver README_MICROSOFT.md para o passo a passo de registro do app no Azure AD. Dormente
# sem essas duas variáveis (cada pessoa conecta a própria conta em Configurações).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://lumen-flax-chi.vercel.app/api/microsoft/callback

# Dropbox (armazenamento de anexos) — ver README_MICROSOFT.md seção 2 para o passo a passo de
# registro do app no Dropbox App Console. Dormente sem estas 2 variáveis.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=https://lumen-flax-chi.vercel.app/api/dropbox/callback

# Asaas (cobrança: Pix Automático, Pix QR Code, boleto) — ver README_ASAAS.md para o passo a
# passo de cadastro da conta e geração da API Key. Dormente sem estas variáveis.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# "sandbox" (padrão) ou "production" — só trocar depois de testar no sandbox.
ASAAS_ENV=sandbox

# Hermes (o assistente que responde na caixa de conversa do portal) — ver servidor-hermes/LEIA-ME.md
# para instalar a ponte na máquina onde o Hermes está. Dormente sem estas duas: sem elas o Lúmen
# nem tenta falar com ele, e a caixa responde pela reserva (Claude, abaixo).
# O segredo é o MESMO gravado em /etc/lumen-hermes.env no servidor; gere um novo com
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HERMES_URL=
HERMES_TOKEN=
# O nome do perfil do Hermes, quando ele nao segue a convencao lumen-tenant-<slug>.
# Temporario: existe enquanto houver um perfil so na maquina. Ver servidor-hermes/LEIA-ME.md.
HERMES_PERFIL=
# Opcional — quanto esperar pelo Hermes antes de desistir (padrão 90000 ms).
HERMES_TIMEOUT_MS=

# Anthropic — a RESERVA da caixa de conversa, usada quando o Hermes não atende. Dormente sem ela:
# se nem o Hermes nem esta chave estiverem configurados, a caixa avisa que não está configurada em
# vez de quebrar.
ANTHROPIC_API_KEY=

# Transcrição de áudio do WhatsApp (a Ana ouve o áudio, transcreve e responde com base nisso — ver
# lib/transcricao.ts e lib/transcricaoDeAudio.ts). PROTOCOLO, NÃO FORNECEDOR: fala-se o protocolo
# OpenAI-compatível de transcrição (POST {TRANSCRICAO_URL}/v1/audio/transcriptions, multipart/
# form-data com "file"+"model", Bearer token, resposta JSON com "text") — a MESMA configuração
# atende um Whisper auto-hospedado do próprio escritório, a Groq ou a OpenAI, trocando só estas
# três variáveis. FAIL-CLOSED: sem TRANSCRICAO_URL e TRANSCRICAO_TOKEN, nenhum áudio é transcrito
# (o áudio continua subindo pro Drive normalmente — só a transcrição fica de fora — e a tela diz
# isso com todas as letras, nunca finge ter ouvido).
#
# O ENDEREÇO VALE COM OU SEM O "/v1" NO FIM — as duas formas funcionam, de propósito. A Groq e a
# OpenAI documentam a própria base já COM o /v1 dentro (https://api.groq.com/openai/v1,
# https://api.openai.com/v1), enquanto um Whisper do próprio escritório costuma ser servido SEM. O
# código acrescenta /v1/audio/transcriptions, então colar o endereço da documentação geraria
# .../v1/v1/... e um 404 cujo sintoma na tela é só "não foi possível transcrever". Aconteceu de
# verdade e custou uma tarde; lib/transcricaoDeAudio.ts normaliza para que não aconteça de novo.
#   Exemplos que funcionam: https://api.groq.com/openai  ·  https://api.groq.com/openai/v1
TRANSCRICAO_URL=
TRANSCRICAO_TOKEN=
# Opcional — padrão "whisper-1" quando em branco (nome reconhecido tanto pela OpenAI quanto por
# servidores Whisper auto-hospedados que imitam a API dela).
TRANSCRICAO_MODELO=

# Segredo da rota INTERNA que termina a transcrição fora do pedido do webhook (ver
# lib/transcricaoAssincrona.ts e app/api/transcricao/processar/route.ts) — o webhook dispara essa
# rota sem esperar, para não estourar o próprio maxDuration. FAIL-CLOSED, em dobro: essa rota
# termina disparando mensagem de WhatsApp em nome do escritório, então sem este segredo ela recusa
# qualquer pedido (mesma regra de CRON_SECRET/WHATSAPP_APP_SECRET). Gere um valor com
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TRANSCRICAO_INTERNA_SECRET=

# Segredo da rota INTERNA que provisiona o perfil de campanha fora do pedido do webhook da Asaas
# (§3 do módulo pago de campanhas — ver lib/actions/provisionamentoCampanhas.ts e
# app/api/interno/provisionar-campanha/route.ts). MESMA razão de TRANSCRICAO_INTERNA_SECRET
# acima: `provisionarNoHermes` pode levar até 120s, e o webhook precisa responder rápido — o
# disparo é fogo-e-esquece para esta rota, que por sua vez fala com a máquina do Hermes.
# FAIL-CLOSED: sem este segredo, a rota recusa qualquer pedido (o cron de segurança de
# app/api/cron/campanhas-provisionamento garante que o perfil sobe de qualquer jeito). Gere um
# valor com
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CAMPANHA_PROVISIONAMENTO_INTERNO_SECRET=

# Firecrawl (https://firecrawl.dev) — busca na web e leitura de páginas/PDFs públicos em markdown,
# para pesquisa de jurisprudência/notícia (ver lib/firecrawl.ts). Deixado pronto "para eventual
# necessidade": nenhuma tela usa ainda. FAIL-CLOSED: sem FIRECRAWL_API_KEY, nenhuma chamada sai
# (erro "não configurado") — nunca cai no plano gratuito anônimo. SÓ SERVIDOR: nunca dar prefixo
# NEXT_PUBLIC_ a esta chave. Valor real: painel do Firecrawl → API Keys, e o gerenciador de senhas.
FIRECRAWL_API_KEY=
# Opcional — padrão https://api.firecrawl.dev/v2. Só para instância auto-hospedada do Firecrawl.
FIRECRAWL_API_URL=
