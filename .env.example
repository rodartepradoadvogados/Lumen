DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Segredo compartilhado dos 12 crons (app/api/cron/*/route.ts) — cada rota exige
# Authorization: Bearer <CRON_SECRET> e recusa (401) qualquer requisição sem o header correto,
# inclusive quando esta variável está ausente (fail-closed). A Vercel envia esse header sozinha
# nos disparos agendados (vercel.json); sem CRON_SECRET definida em produção, todo cron fica
# permanentemente inacessível — o que é seguro, mas não silencioso: é o comportamento pretendido.
CRON_SECRET=

# SMTP (envio de e-mail — agenda diária, resumo diário, redefinição de senha, convite de
# escritório novo, faturas/lembretes/vencimento do Painel Mestre). Sem estas 4 variáveis, todos
# esses e-mails ficam sem esse canal. Para a redefinição de senha especificamente, isso não
# trava ninguém: existe uma cascata em lib/email.ts (sendCriticalEmailCascade) que tenta, na
# ordem, 1) SMTP (aqui embaixo) → 2) a conta Google conectada do escritório (Configurações →
# Modelos & Integrações, reaproveita o escopo gmail.send já concedido para o Drive) → 3) a conta
# Microsoft conectada do escritório (Mail.Send) → e só se nenhuma das três funcionar, erro
# explicando que um administrador precisa gerar o link de acesso manualmente (Configurações →
# Equipe → botão de link de redefinição). Os demais e-mails (agenda, faturas etc.) não têm essa
# cascata — dependem só destas variáveis.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=

# WhatsApp — Cloud API oficial da Meta. App Meta/webhook/verify token são únicos pra toda a
# plataforma (deixe em branco para manter a integração dormente); phoneNumberId/accessToken são
# por escritório e ficam na tabela WhatsappConfig (cadastrados em Configurações, não aqui).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Notificações push (Web Push API) — "env-gated" como o WhatsApp acima: dormente e
# inofensivo enquanto vazias (o app mostra "não configurado" e some quietamente).
# Gerar um par novo com: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# BTG Empresas (boletos do Painel Mestre) — ver README_BTG.md para o passo a passo de
# registro do app no portal do BTG. Dormente sem essas duas variáveis.
BTG_CLIENT_ID=
BTG_CLIENT_SECRET=
# "sandbox" (padrão) ou "production" — só trocar depois do app verificado pelo BTG.
BTG_ENV=sandbox
# Opcional — sem ela, cai em ${APP_URL}/api/btg/callback (ver lib/appUrl.ts). Só precisa ser
# definida se o redirect_uri cadastrado no portal do BTG for diferente da URL base do app.
BTG_REDIRECT_URI=

# Microsoft (Outlook) — recebimento de publicações por e-mail + envio no Atendimento via conta
# Outlook. Ver README_MICROSOFT.md para o passo a passo de registro do app no Azure AD. Dormente
# sem essas duas variáveis (cada pessoa conecta a própria conta em Configurações).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://lumen-flax-chi.vercel.app/api/microsoft/callback

# Dropbox (armazenamento de anexos) — ver README_MICROSOFT.md seção 2 para o passo a passo de
# registro do app no Dropbox App Console. Dormente sem estas 2 variáveis.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=https://lumen-flax-chi.vercel.app/api/dropbox/callback

# Asaas (cobrança: Pix Automático, Pix QR Code, boleto) — ver README_ASAAS.md para o passo a
# passo de cadastro da conta e geração da API Key. Dormente sem estas variáveis.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# "sandbox" (padrão) ou "production" — só trocar depois de testar no sandbox.
ASAAS_ENV=sandbox
